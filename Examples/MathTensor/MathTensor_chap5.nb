Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "v"], 
    SubscriptBox["w", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "c"], 
     RowBox[{
      SubscriptBox["\[Del]", "c"], 
      SubscriptBox["w", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]]}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "a"], 
       SuperscriptBox["v", "c"]}], ")"}], 
     SubscriptBox["w", 
      RowBox[{"c", "\[InvisibleComma]", "b"}]]}], "+", 
    RowBox[{
