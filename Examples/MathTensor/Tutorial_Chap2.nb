   RowBox[{
    RowBox[{
     SuperscriptBox["v", "p"], 
     RowBox[{
      SubscriptBox["\[Del]", "p"], 
      SuperscriptBox["T", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]]}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "p"], 
       SuperscriptBox["v", "a"]}], ")"}], 
     SuperscriptBox["T", 
      RowBox[{"p", "\[InvisibleComma]", "b"}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "p"], 
       SuperscriptBox["v", "b"]}], ")"}], 
