  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["d", "TI"]], 
         SubscriptBox["\[Null]", 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["b", "TI"], 
            StyleBox["a", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "R^d{}_{cba}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
