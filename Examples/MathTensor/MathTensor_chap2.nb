Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "v"], 
    SuperscriptBox[
     SubscriptBox["T", "a"], "b"]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "p"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "p"], 
      SuperscriptBox[
       SubscriptBox["T", "a"], "b"]}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], 
       SuperscriptBox["v", "p"]}], ")"}], 
     SuperscriptBox[
      SubscriptBox["T", "p"], "b"]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "p"], 
       SuperscriptBox["v", "b"]}], ")"}], 
     SuperscriptBox[
      SubscriptBox["T", "a"], "p"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"86491094-c331-1746-97e1-549f3455db8a"]], \
"Text",
