Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "v"], 
    SuperscriptBox["T", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "p"], 
     RowBox[{
      SubscriptBox["\[Del]", "p"], 
      SuperscriptBox["T", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]]}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "p"], 
       SuperscriptBox["v", "a"]}], ")"}], 
     SuperscriptBox["T", 
      RowBox[{"p", "\[InvisibleComma]", "b"}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "p"], 
       SuperscriptBox["v", "b"]}], ")"}], 
     SuperscriptBox["T", 
      RowBox[{"a", "\[InvisibleComma]", "p"}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"683bf413-e784-c745-8812-fe1d0cfb3532"]], \
"Text",
