12010c684e96"],

Cell[TextData[{
 "In the torsion-free spacetime and in the coordinate basis, the covariantly \
constant condition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"a", "\[InvisibleSpace]", "b"}]], TraditionalForm]],
  ExpressionUUID->"ec00424e-dc20-4e5d-b39a-f9c62540b38f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "a"], 
     SubscriptBox["g", 
      RowBox[{"b", "\[InvisibleSpace]", "c"}]]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"53c34b51-2950-490f-9e89-90bd179d2957"],
 ", gives the Christoffel symbols"
}], "Text",
 CellChangeTimes->{{3.826797497743135*^9, 
  3.82679755420165*^9}},ExpressionUUID->"a5cb2f38-0ab4-4d05-8aa4-\
f2a3a73f2fe6"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    SuperscriptBox[
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"],
    FontColor->RGBColor[0.93, 0.27, 0.27]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"c", "\[InvisibleComma]", "d"}]], "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], 
       SubscriptBox["g", 
        RowBox[{"b", "\[InvisibleComma]", "d"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "b"], 
       SubscriptBox["g", 
        RowBox[{"a", "\[InvisibleComma]", "d"}]]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "d"], 
       SubscriptBox["g", 
        RowBox[{"a", "\[InvisibleComma]", "b"}]]}]}], ")"}]}]}], 
  TraditionalForm]],ExpressionUUID->"58f0cb35-2a89-834e-afaf-6cef07a0b064"]], \
"Text",
 CellChangeTimes->{{3.918039256182537*^9, 3.9180393086483803`*^9}},
 TextAlignment->Center,ExpressionUUID->"1f3d307a-ebc8-7042-83ea-17da028c65b9"]
