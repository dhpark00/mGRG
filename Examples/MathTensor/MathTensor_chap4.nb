Cell[CellGroupData[{

Cell["4.1.4 Calculating the Components of Curvature Tensors", "Subsubsection",ExpressionUUID->"4bfa3f8b-1c2c-44c8-9844-40d7cabba9f0"],

Cell[TextData[StyleBox["Schwarzschild SpaceTime",
 FontWeight->"Bold"]], "SmallText",ExpressionUUID->"c1549e5d-0926-4498-92ac-\
ceea0c773d47"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coSys", "=", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]", ",", "t"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", " ", "-", " ", 
         FractionBox[
          RowBox[{"2", "G", " ", "M"}], "r"]}]], ",", "0", ",", "0", ",", 
       "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       SuperscriptBox["r", "2"], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
