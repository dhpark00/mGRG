  RowBox[{"RuleUnique", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannCD", "[", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"e_", ",", "f_", ",", "g_", ",", "h_"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"li", ",", "lj", ",", "lk", ",", "d"}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"e", ",", "uk", ",", "ui", ",", "uj"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"PairIndexQ", "[", 
      RowBox[{"a", ",", "f"}], "]"}], "&&", 
     RowBox[{"PairIndexQ", "[", 
      RowBox[{"b", ",", "g"}], "]"}], "&&", 
     RowBox[{"PairIndexQ", "[", 
      RowBox[{"c", ",", "h"}], "]"}]}]}], "]"}]}]], "Input",
