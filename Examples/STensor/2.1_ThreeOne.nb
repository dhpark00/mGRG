Cell[CellGroupData[{

Cell["Block-Diagonal Basis in a stationary spacetime", "Subsection",
 CellChangeTimes->{{3.980415342906479*^9, 
  3.980415347075985*^9}},ExpressionUUID->"15f7e961-f7e5-498d-ba1a-\
d62f1c7475b1"],

Cell[TextData[{
 "Notice that the block-diagonal basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Mu]"], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["D", "t"], ",", " ", 
       SubscriptBox["D", "i"]}], ")"}], " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], 
       RowBox[{",", " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "i"], " ", 
          RowBox[{"-", " ", 
           SubscriptBox["\[Omega]", "i"]}]}], 
         SubscriptBox["\[PartialD]", "t"]}]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"c41803c0-7a20-4ffc-b40d-678c0346e852"],
 " is a non-coordinate basis. In a stationary spacetime, in particular, we \
have"
}], "Text",
 CellChangeTimes->{{3.538892693381995*^9, 
  3.538892709038891*^9}},ExpressionUUID->"473ae392-a3ad-4cee-a804-\
251f8bcf4b9e"],

Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       SubscriptBox["D", "i"], ",", 
       SubscriptBox["D", "j"]}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["\[Pi]", "ij"]}], 
      SubscriptBox["\[PartialD]", "t"]}]}], ",", "     ", 
    RowBox[{
     SubscriptBox["\[Pi]", "ij"], " ", "=", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "i"], 
       SubscriptBox["\[Omega]", "j"]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "j"], 
       SubscriptBox["\[Omega]", "i"]}]}]}]}]],
   CellChangeTimes->{3.9160973890689373`*^9},
   TextAlignment->Center,ExpressionUUID->
   "1cf59720-8f5f-c94e-9c30-fb76fccb81d0"]],ExpressionUUID->
   "0502d00f-5693-5d4c-9680-3f57f010f305"], "."}]], "Text",
 CellChangeTimes->{{3.9160973890689373`*^9, 3.916097439506714*^9}},
 TextAlignment->Center,ExpressionUUID->"9cd780ac-b2e3-4788-9d56-2d3f81f0df28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockMetricRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"f", "[", "]"}]}], ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "DnIndexQ"}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "TimeK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"f", "[", "]"}]}], ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "UpIndexQ"}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "TimeK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", "1", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DnIndexQ", "[", "a", "]"}], "&&", 
            RowBox[{"UpIndexQ", "[", "b", "]"}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"UpIndexQ", "[", "a", "]"}], "&&", 
            RowBox[{"DnIndexQ", "[", "b", "]"}]}], ")"}]}], ")"}], " ", "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "TimeK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", 
       RowBox[{"BaseMetric", "[", 
        RowBox[{"a", ",", "b"}], "]"}], ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "DnIndexQ"}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "SpaceK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", 
       RowBox[{"BaseMetric", "[", 
        RowBox[{"a", ",", "b"}], "]"}], ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "UpIndexQ"}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "SpaceK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", 
       RowBox[{"BaseMetric", "[", 
        RowBox[{"a", ",", "b"}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"DnIndexQ", "[", "a", "]"}], "&&", 
            RowBox[{"UpIndexQ", "[", "b", "]"}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"UpIndexQ", "[", "a", "]"}], "&&", 
            RowBox[{"DnIndexQ", "[", "b", "]"}]}], ")"}]}], ")"}], " ", "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"KindIndexQ", "[", "SpaceK", "]"}], "[", "#", "]"}], 
           "&"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], ",", "0", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"KindIndexQ", "[", "TimeK", "]"}], "[", "a", "]"}], "&&", 
          RowBox[{
           RowBox[{"KindIndexQ", "[", "SpaceK", "]"}], "[", "b", "]"}]}], 
         ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"KindIndexQ", "[", "TimeK", "]"}], "[", "b", "]"}], "&&", 
          RowBox[{
           RowBox[{"KindIndexQ", "[", "SpaceK", "]"}], "[", "a", "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.519181788359375*^9, 3.519181788578125*^9}, {
