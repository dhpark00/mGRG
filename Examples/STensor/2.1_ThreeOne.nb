Cell[BoxData[
 RowBox[{
  RowBox[{"BlockStructureRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Structuref", "[", 
        RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ",", 
