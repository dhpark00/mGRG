Cell[TextData[{
 "Using the symmetries of Riemann tensor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"], 
            StyleBox["c", "TI"], 
            StyleBox["d", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["d", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["c", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "R_{abcd} = R_{cdab} = -R_{dcab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26e0ec48-c40c-4936-b0b5-bb40d8626aab"],
 " we finally obtain"
}], "Text",
