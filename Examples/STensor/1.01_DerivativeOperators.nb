 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox[
      OverscriptBox["R", "~"], 
      RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], 
     "d"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["R", 
       RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], 
      "d"], "-", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "a"], 
        SuperscriptBox[
         SubscriptBox["\[Gamma]", 
          RowBox[{"b", "\[InvisibleComma]", "c"}]], "d"]}], "+", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Gamma]", 
          RowBox[{"a", "\[InvisibleComma]", "m"}]], "d"], 
        SuperscriptBox[
         SubscriptBox["\[Gamma]", 
          RowBox[{"b", "\[InvisibleComma]", "c"}]], "m"]}], "-", 
       RowBox[{"(", 
        RowBox[{"a", "\[LeftRightArrow]", "b"}], ")"}]}], "]"}]}]}], 
