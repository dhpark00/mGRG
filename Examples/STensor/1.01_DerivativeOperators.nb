Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "a"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"b", "\[InvisibleComma]", "c"}]], 
      SuperscriptBox["F", 
       RowBox[{"c", "\[InvisibleComma]", "d"}]]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], 
       SubscriptBox["T", 
        RowBox[{"b", "\[InvisibleComma]", "c"}]]}], ")"}], 
     SuperscriptBox["F", 
      RowBox[{"c", "\[InvisibleComma]", "d"}]]}], "+", 
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"b", "\[InvisibleComma]", "c"}]], 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SuperscriptBox["F", 
       RowBox[{"c", "\[InvisibleComma]", "d"}]]}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"ba62a3b7-3bac-cb4b-b3f5-4abf9831b6d3"]], \
