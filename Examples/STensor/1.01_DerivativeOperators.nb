Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Del]", "~"], "a"], 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "b"], " ", 
        RowBox[{"-", " ", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Del]", "~"], "b"], 
          RowBox[{
           SubscriptBox[
            OverscriptBox["\[Del]", "~"], "a"], " ", 
           RowBox[{"+", " ", 
            SuperscriptBox[
             SubscriptBox["t", 
              RowBox[{"a", "\[InvisibleComma]", "b"}]], "d"]}]}]}]}]}]}], 
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "d"]}], ")"}], 
    SuperscriptBox["\[Xi]", "c"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      SubscriptBox[
       OverscriptBox["R", "~"], 
       RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "d"}]], 
      "c"]}], 
    SuperscriptBox["\[Xi]", "d"]}]}], 
  TraditionalForm]],ExpressionUUID->"c997f837-52ba-9043-ac92-cb77b8fd03a0"]], \
"Text",
