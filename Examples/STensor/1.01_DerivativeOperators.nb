Cell[TextData[{
 "Let us consider the relationship between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "a"], TraditionalForm]],ExpressionUUID->
  "64da21e9-de4f-9d4a-ae55-7c4c367cd535"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "a"], TraditionalForm]],ExpressionUUID->
  "bb42b77c-15f1-c94a-8b89-463c687db644"],
 ". In particular, the curvature thensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubsuperscriptBox["R", 
     RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}], 
     RowBox[{"(", "\[PartialD]", ")"}]], "d"], TraditionalForm]],
  ExpressionUUID->"2d46aa86-87e4-c244-93bc-6af4d71d66f0"],
 " for the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "a"], TraditionalForm]],ExpressionUUID->
  "08626b1d-a4db-6744-9b9c-86a45e3ba0da"],
 " vanishes. Further, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", " "}], TraditionalForm]],ExpressionUUID->
  "0c2cfd94-f91e-ca47-99b1-6ba794dd761d"],
 "tensor between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "a"], TraditionalForm]],ExpressionUUID->
  "fdef9406-9d87-7c49-aa3f-34598d422cf9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "a"], TraditionalForm]],ExpressionUUID->
  "28d9513b-444a-484a-8503-544cae4350a2"],
 " is nothing but the connection coefficients ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalGamma]", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"5fe9aca4-e199-cc4a-ba3b-3f9805e7fc15"],
 ". Thus, we obtain the formula"
}], "Text",
 CellChangeTimes->{{3.917657950214329*^9, 3.917658039746546*^9}, {
  3.917658083424881*^9, 3.917658308787361*^9}, {3.9176583662501984`*^9, 
