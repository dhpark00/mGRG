Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "a"], 
      RowBox[{
       SubscriptBox["\[Del]", "b"], " ", 
       RowBox[{"-", " ", 
        RowBox[{
         SubscriptBox["\[Del]", "b"], 
         SubscriptBox["\[Del]", "a"]}]}]}]}], ")"}], 
    SuperscriptBox["\[Xi]", "c"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      SubscriptBox["R", 
       RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "d"}]], 
