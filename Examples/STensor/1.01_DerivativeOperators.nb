Cell[TextData[{
 "For a generic tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["T", 
     RowBox[{
      RowBox[{"a", "..."}], "b"}]], 
    RowBox[{
     RowBox[{"c", "..."}], "d"}]], TraditionalForm]],ExpressionUUID->
  "03041386-e6c6-ec4c-9f98-68d6a3c8e559"]
}], "Text",
