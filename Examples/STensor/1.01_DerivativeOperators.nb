  3.9176677583289204`*^9}},ExpressionUUID->"4911cb42-c2b2-9847-b9d3-\
e3db612c4c3f"],

Cell[TextData[Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[Del]", "~"], "m"], 
    SubscriptBox[
     SuperscriptBox["T", 
      RowBox[{
       RowBox[{"a", "..."}], "b"}]], 
     RowBox[{
      RowBox[{"c", "..."}], "d"}]]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "a"], 
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{
        RowBox[{"a", "..."}], "b"}]], 
      RowBox[{
       RowBox[{"c", "..."}], "d"}]]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"m", "\[InvisibleComma]", "n"}]], "a"], 
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{
        RowBox[{"n", "..."}], "b"}]], 
      RowBox[{
       RowBox[{"c", "..."}], "d"}]]}], " ", "+", " ", "\[Ellipsis]", " ", "+", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"m", "\[InvisibleComma]", "n"}]], "b"], 
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{
        RowBox[{"a", "..."}], "n"}]], 
      RowBox[{
       RowBox[{"c", "..."}], "d"}]]}]}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{"                                      ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       SubscriptBox["\[Gamma]", 
        RowBox[{"m", "\[InvisibleComma]", "c"}]], "n"]}], 
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{
        RowBox[{"a", "..."}], "b"}]], 
      RowBox[{
       RowBox[{"n", "..."}], "d"}]]}], " ", "-", " ", "\[Ellipsis]", " ", "-",
     " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"m", "\[InvisibleComma]", "d"}]], "n"], 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["T", 
        RowBox[{
         RowBox[{"a", "..."}], "b"}]], 
       RowBox[{
        RowBox[{"c", "..."}], "n"}]], "."}]}]}]}], 
  TraditionalForm]}],ExpressionUUID->"1be6dfe8-3489-7c4d-9435-630b2cb046fa"]],\
 "Text",
