Cell[TextData[{
 "Hence, there is a tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox[
     OverscriptBox["R", "~"], 
     RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], "d"],
    TraditionalForm]],ExpressionUUID->"5ed21f4d-2781-4926-adcc-f8f8eaf633f1"],
 " such that"
}], "Text",
