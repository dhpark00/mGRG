Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Del]", "~"], "a"], 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "b"], " ", 
        RowBox[{"-", " ", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Del]", "~"], "b"], 
          RowBox[{
           SubscriptBox[
            OverscriptBox["\[Del]", "~"], "a"], " ", 
           RowBox[{"+", " ", 
            SuperscriptBox[
             SubscriptBox["t", 
              RowBox[{"a", "\[InvisibleComma]", "b"}]], "d"]}]}]}]}]}]}], 
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "d"]}], ")"}], 
    SubscriptBox["\[Mu]", "c"]}], " ", "\[Congruent]", " ", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox[
      OverscriptBox["R", "~"], 
      RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], 
     "d"], 
    SubscriptBox["\[Mu]", "d"]}]}], 
  TraditionalForm]],ExpressionUUID->"c7fce177-7e84-bb45-8380-fe2b6e74c717"]], \
