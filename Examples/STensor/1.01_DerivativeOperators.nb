      RowBox[{
       RowBox[{"FreePatternQ", "[", 
        RowBox[{"{", 
         RowBox[{"la", ",", "lb", ",", "expr"}], "}"}], "]"}], "&&", " ", " ", 
       RowBox[{"!", 
