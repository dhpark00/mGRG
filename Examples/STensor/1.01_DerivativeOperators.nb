Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Del]", "~"], "a"], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "b"], "f"}]}], " ", "-", " ", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Del]", "~"], "b"], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "a"], "f"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["t", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "c"], "f"}]}]}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"806518bf-e954-7049-8cc7-34fdaf71e968"]], \
"Text",
