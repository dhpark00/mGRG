  3.951088955230379*^9, 3.971952854516988*^9, 3.97929459643539*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"7627ebe6-6114-4c70-bb62-fc79a96795f0"]
}, Closed]],

Cell["Therefore,", "Text",
 CellChangeTimes->{{3.758335648614352*^9, 3.758335648614352*^9}, 
   3.916031001055054*^9, {3.9175206786436443`*^9, 3.91752068836295*^9}, 
   3.971952867415433*^9},ExpressionUUID->"4fe16676-bc9c-423b-89ea-\
992d9db4d689"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], " ", "-", " ", 
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"b", "\[InvisibleComma]", "a"}]], "c"]}], " ", "=", " ", 
    SuperscriptBox[
     SubscriptBox["t", 
      RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"]}], TraditionalForm]],
  ExpressionUUID->"87f40256-693a-6a48-8bc8-ce2e4dc80869"],
 "."
}], "Text",
 CellChangeTimes->{
  3.917520691212169*^9, 3.917593245870875*^9, {3.9176670239175186`*^9, 
   3.9176670333346596`*^9}},
 TextAlignment->Center,ExpressionUUID->"e76c23cc-f33c-c24f-a84f-4d555dcd7739"],

Cell[TextData[{
 "Let us define the connection coefficients ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox[
     OverscriptBox["\[CapitalGamma]", "~"], "ab"], "c"], TraditionalForm]],
  ExpressionUUID->"76dcb297-fed2-8841-b2c8-24d5a0b05373"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalGamma]", "ab"], "c"], TraditionalForm]],
  ExpressionUUID->"199f48eb-76fc-1b42-b94a-16422137bc33"],
 " by"
}], "Text",
 CellChangeTimes->{{3.917520754122607*^9, 3.9175207981142235`*^9}, 
   3.917521152238995*^9, {3.917521345414219*^9, 3.917521356704436*^9}, {
   3.917522436629938*^9, 3.917522437870088*^9}, {3.9175922894489193`*^9, 
   3.917592319118608*^9}, {3.917592747255366*^9, 
   3.9175927483303843`*^9}},ExpressionUUID->"a9e5194b-fdf5-6e42-9504-\
7065f1426a9e"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[Del]", "~"], "a"], 
    SuperscriptBox["\[Xi]", "c"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "a"], 
     SuperscriptBox["\[Xi]", "c"]}], "+", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox[
       OverscriptBox["\[CapitalGamma]", "~"], 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], 
     SuperscriptBox["\[Xi]", "b"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"7559b038-f33e-e24e-81e7-28cdffac867f"]], \
"Text",
 CellChangeTimes->{{3.9175211595266857`*^9, 3.917521292369753*^9}, {
  3.917524361583512*^9, 3.917524397359593*^9}, {3.917667039633997*^9, 
  3.917667039999256*^9}, {3.963961637871916*^9, 3.963961641096592*^9}},
 TextAlignment->Center,ExpressionUUID->"e1c2d812-c9d5-d143-816e-087e38dc6f20"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "a"], 
     SuperscriptBox["\[Xi]", "c"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SuperscriptBox["\[Xi]", "c"]}], "+", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[CapitalGamma]", 
        RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], 
      SuperscriptBox["\[Xi]", "b"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d7dc24b1-4c29-ee40-a2e3-e275853a0d00"],
 ","
}], "Text",
 CellChangeTimes->{{3.9175211595266857`*^9, 3.917521292369753*^9}, {
   3.917524361583512*^9, 3.917524405399643*^9}, 3.917593249308607*^9, {
   3.9176670440840073`*^9, 3.9176670446339417`*^9}, {3.9639616465144386`*^9, 
   3.963961648594528*^9}},
 TextAlignment->Center,ExpressionUUID->"560735ba-1751-b942-8e67-7a1abf637e11"],

Cell["which gives", "Text",
 CellChangeTimes->{{3.917592535422491*^9, 3.91759256040633*^9}, {
  3.9175926766285*^9, 
  3.9175926777365093`*^9}},ExpressionUUID->"3cab67c1-bfe8-8f40-b6fb-\
14d0eea63646"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox[
      OverscriptBox["\[CapitalGamma]", "~"], 
      RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[CapitalGamma]", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], "+", 
     SuperscriptBox[
      SubscriptBox["\[Gamma]", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"]}]}], TraditionalForm]],
  ExpressionUUID->"3e54e24b-243b-4740-87cb-80dd92dd909b"],
 "."
}], "Text",
 CellChangeTimes->{
  3.917520691212169*^9, {3.917592578557501*^9, 3.917592637664291*^9}, {
   3.917592687872141*^9, 3.917592690730812*^9}, 3.917593253453684*^9, 
   3.917593705935133*^9, {3.9175938052645435`*^9, 3.917593828317234*^9}, 
   3.917593888216183*^9, {3.9176670509672737`*^9, 3.917667058934511*^9}},
 TextAlignment->Center,ExpressionUUID->"98e20364-1baa-c04a-81bd-6dedcd169aa9"],

Cell[TextData[{
 "Notice that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[Gamma]", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"528b0dfc-9f56-df42-ad06-319ffd718e6d"],
 " satisfying the above relation is called the contorsion tensor."
}], "Text",
 CellChangeTimes->{{3.9175938952651005`*^9, 3.917593924000263*^9}, {
  3.917593968187729*^9, 3.917593988125624*^9}, {3.917594133614429*^9, 
  3.9175941357180023`*^9}, {3.9176670632338314`*^9, 3.91766706420051*^9}, {
  3.9510890232148304`*^9, 
  3.9510890233636036`*^9}},ExpressionUUID->"b8a3cebb-f07c-f245-810e-\
12850b24190e"],

Cell[TextData[{
 "The definition of the connection coefficients can be interpreted as the \
followings: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox[
     OverscriptBox["\[CapitalGamma]", "~"], 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"20c0cdf8-1a3a-3d41-83e1-0bf294474114"],
 " is a ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "192570d6-8edb-3a40-ab2d-8a6ad01ab92b"],
 " tensor between the two derivative operators, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Del]", "~"], "a"], TraditionalForm]],ExpressionUUID->
  "984cae0d-5bbb-744a-b334-85f17d2f3fd9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "a"], TraditionalForm]],ExpressionUUID->
  "36478c39-d7ba-944a-802e-d27ee44f3d6b"],
 ". Similarly, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalGamma]", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"8498bb9e-a6d5-5f43-80fd-7d0a6e49d90a"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", " "}], TraditionalForm]],ExpressionUUID->
  "b2697b62-cbea-0f45-8628-7d1f37243c51"],
 "tensor between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "a"], TraditionalForm]],ExpressionUUID->
  "31e2a1ec-f3d8-194f-9457-19175c843927"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "a"], TraditionalForm]],ExpressionUUID->
  "25958f7e-3790-014f-ae8c-3603dd82f4f6"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "a"], TraditionalForm]],ExpressionUUID->
  "70262370-f946-5547-90a1-b06a3034eee4"],
 " is torsion-free"
}], "Text",
 CellChangeTimes->{{3.917521364550207*^9, 3.91752148703681*^9}, {
   3.917521543927134*^9, 3.917521556519417*^9}, {3.917521896386793*^9, 
   3.917521947505701*^9}, {3.9175224543984985`*^9, 3.9175224683977985`*^9}, {
   3.917592355299034*^9, 3.9175923868896904`*^9}, {3.917592654095177*^9, 
   3.9175926546612873`*^9}, {3.9175927566829176`*^9, 3.917592773490526*^9}, {
   3.917592861904995*^9, 3.917592885764416*^9}, {3.917593013984556*^9, 
   3.91759307975618*^9}, {3.917593296284031*^9, 3.917593305495341*^9}, {
   3.917594167622116*^9, 3.917594167826184*^9}, 3.9176671078168087`*^9, {
   3.9176671433834057`*^9, 
   3.917667149750166*^9}},ExpressionUUID->"c7fb680d-ecc0-e140-9924-\
05a64a46ccca"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[CapitalGamma]", 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], " ", "-", " ", 
     SuperscriptBox[
      SubscriptBox["\[CapitalGamma]", 
       RowBox[{"b", "\[InvisibleComma]", "a"}]], "c"]}], " ", "=", " ", "0"}],
    TraditionalForm]],ExpressionUUID->"595709ee-10bb-3d43-85da-7c50e95d7b55"],
 "."
}], "Text",
 CellChangeTimes->{
  3.917520691212169*^9, {3.917521974475697*^9, 3.9175219832674932`*^9}, 
   3.9175932576759996`*^9, {3.91766715423332*^9, 3.917667158066677*^9}},
 TextAlignment->Center,ExpressionUUID->"187cbcb2-7e4f-634b-a6d2-c67ee4ee3e4a"],

Cell[TextData[{
 "(Recall that we have used the commutativity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"[", "a"}]], 
     SubscriptBox["\[PartialD]", 
      RowBox[{"b", "]"}]]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "463a67fa-3f73-c94a-bd55-c3b4f14a0f2f"],
 ". This means that in component notation the indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", ",", "b", ",", "..."}], TraditionalForm]],ExpressionUUID->
  "08643353-3f6a-9743-bde0-05aa4844d3f9"],
 " are in a coordinate basis.) For the torsionful derivative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Del]", "~"], "a"], TraditionalForm]],ExpressionUUID->
  "6fc24e85-1b85-dd41-80b6-81a297d13d71"],
 " we have"
}], "Text",
 CellChangeTimes->{{3.917522049153372*^9, 3.9175221745054073`*^9}, {
  3.917522219928249*^9, 3.917522238447043*^9}, {3.917522297279861*^9, 
  3.917522297871319*^9}, {3.9175223518945312`*^9, 3.917522391558033*^9}, {
  3.9792947542771187`*^9, 
  3.9792947562797318`*^9}},ExpressionUUID->"d25717c6-769c-004c-94a8-\
28e3e8649811"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox[
       OverscriptBox["\[CapitalGamma]", "~"], 
       RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], " ", "-", " ", 
     SuperscriptBox[
      SubscriptBox[
       OverscriptBox["\[CapitalGamma]", "~"], 
       RowBox[{"b", "\[InvisibleComma]", "a"}]], "c"]}], " ", "=", " ", 
    SuperscriptBox[
     SubscriptBox["t", 
      RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"]}], TraditionalForm]],
  ExpressionUUID->"8c446a36-69aa-1e41-84a6-fc233d4aaab1"],
 "."
}], "Text",
 CellChangeTimes->{
  3.917520691212169*^9, {3.917521974475697*^9, 3.9175219832674932`*^9}, {
   3.9175224045364094`*^9, 3.917522418567932*^9}, 3.917593261632365*^9, {
   3.9176671783332024`*^9, 3.917667186033039*^9}},
 TextAlignment->Center,ExpressionUUID->"616cfa43-c00f-e248-8076-867d014d7012"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Linearity and locality of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Del]", "~"], "a"], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Del]", "~"], "b"], " ", 
      RowBox[{"-", " ", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "b"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "~"], "a"], " ", 
         RowBox[{"+", " ", 
          SuperscriptBox[
           SubscriptBox["t", 
            RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"]}]}]}]}]}]}], 
    SubscriptBox[
     OverscriptBox["\[Del]", "~"], "c"]}], TraditionalForm]],ExpressionUUID->
  "8e4b44a2-ce0d-499e-9921-d0454da758b9"]
}], "Subsection",
 CellChangeTimes->{{3.916031131617744*^9, 3.91603115581485*^9}, {
  3.917568566263761*^9, 3.917568581510042*^9}, {3.9176671960329895`*^9, 
  3.917667197357231*^9}},ExpressionUUID->"b9cf6408-eed8-43d7-85f9-\
527a800d0984"],

Cell["We show that", "Text",ExpressionUUID->"302cf4a6-e827-4dd1-bd6c-5a4c3103c3a9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "a"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "~"], "b"], " ", 
         RowBox[{"-", " ", 
          RowBox[{
           SubscriptBox[
            OverscriptBox["\[Del]", "~"], "b"], 
           RowBox[{
            SubscriptBox[
             OverscriptBox["\[Del]", "~"], "a"], " ", 
            RowBox[{"+", " ", 
             SuperscriptBox[
              SubscriptBox["t", 
               RowBox[{"a", "\[InvisibleComma]", "b"}]], "d"]}]}]}]}]}]}], 
       SubscriptBox[
        OverscriptBox["\[Del]", "~"], "d"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "\[InvisibleSpace]", 
        SubscriptBox["\[Mu]", "c"]}], "+", 
       SubscriptBox["\[Nu]", "c"]}], ")"}]}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "~"], "a"], 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Del]", "~"], "b"], " ", 
          RowBox[{"-", " ", 
           RowBox[{
            SubscriptBox[
             OverscriptBox["\[Del]", "~"], "b"], 
            RowBox[{
             SubscriptBox[
              OverscriptBox["\[Del]", "~"], "a"], " ", 
             RowBox[{"+", " ", 
              SuperscriptBox[
               SubscriptBox["t", 
                RowBox[{"a", "\[InvisibleComma]", "b"}]], "d"]}]}]}]}]}]}], 
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "d"]}], ")"}], "\[InvisibleSpace]", 
      SubscriptBox["\[Mu]", "c"]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "~"], "a"], 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Del]", "~"], "b"], " ", 
          RowBox[{"-", " ", 
           RowBox[{
            SubscriptBox[
             OverscriptBox["\[Del]", "~"], "b"], 
            RowBox[{
             SubscriptBox[
              OverscriptBox["\[Del]", "~"], "a"], " ", 
             RowBox[{"+", " ", 
              SuperscriptBox[
               SubscriptBox["t", 
                RowBox[{"a", "\[InvisibleComma]", "b"}]], "d"]}]}]}]}]}]}], 
        SubscriptBox[
         OverscriptBox["\[Del]", "~"], "d"]}], ")"}], "\[InvisibleSpace]", 
      SubscriptBox["\[Nu]", "c"]}]}]}], TraditionalForm]],ExpressionUUID->
  "8a68b59a-e0f6-2a41-97df-c4dbf6501f1d"],
 ","
}], "Text",
 CellChangeTimes->{
  3.91752319000918*^9, {3.917529919869964*^9, 3.917529922589887*^9}, {
   3.9176673730653687`*^9, 3.9176674514308987`*^9}, {3.917667574713625*^9, 
   3.917667587446884*^9}},
 TextAlignment->Center,ExpressionUUID->"79055d5d-e3dd-d748-83ca-3036111e4b9b"],

Cell[TextData[{
 "where \[OpenCurlyQuote]Torsion\[CloseCurlyQuote] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["t", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"0e6ae117-145d-674f-a8ec-82fac73e38d6"],
 " is pre-defined."
}], "Text",
 CellChangeTimes->{{3.9175686335667763`*^9, 3.917568658140877*^9}, {
  3.9176674574311657`*^9, 
  3.917667457881298*^9}},ExpressionUUID->"a66dc3c8-9b30-864f-b417-\
eeb7c4d61f6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CovD", "[", 
   RowBox[{"la", ",", "lb", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "]"}], " ", 
      RowBox[{"\[Mu]", "[", "lc", "]"}]}], " ", "+", " ", 
     RowBox[{"\[Nu]", "[", "lc", "]"}]}]}], "]"}], " ", "-", " ", 
  RowBox[{"CovD", "[", 
   RowBox[{"lb", ",", "la", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "]"}], 
      RowBox[{"\[Mu]", "[", "lc", "]"}]}], " ", "+", " ", 
     RowBox[{"\[Nu]", "[", "lc", "]"}]}]}], "]"}], " ", "+", " ", 
  RowBox[{
   RowBox[{"Torsion", "[", 
    RowBox[{"la", ",", "lb", ",", "ud"}], "]"}], 
   RowBox[{"CovD", "[", 
    RowBox[{"ld", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", "]"}], 
       RowBox[{"\[Mu]", "[", "lc", "]"}]}], " ", "+", " ", 
