Cell[BoxData[
 RowBox[{
  RowBox[{"covdcovdRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"CovD", "[", 
      RowBox[{"la_", ",", 
       RowBox[{"CovD", "[", 
        RowBox[{"lb_", ",", "expr_"}], "]"}]}], "]"}], " ", ":>", " ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pair", "=", 
          RowBox[{"NewDummy", "[", "Latin", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"CovD", "[", 
          RowBox[{"lb", ",", 
           RowBox[{"CovD", "[", 
            RowBox[{"la", ",", "expr"}], "]"}]}], "]"}], "-", " ", 
         RowBox[{
          RowBox[{"Torsion", "[", 
           RowBox[{"la", ",", "lb", ",", 
            RowBox[{"pair", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
          RowBox[{"CovD", "[", 
           RowBox[{
            RowBox[{"pair", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "expr"}], "]"}]}]}]}], 
       "]"}], "/;", 
      RowBox[{
       RowBox[{"FreePatternQ", "[", 
        RowBox[{"{", 
         RowBox[{"la", ",", "lb", ",", "expr"}], "}"}], "]"}], "&&", " ", 
       RowBox[{"!", 
        RowBox[{"IndexOrderedQ", "[", 
         RowBox[{"{", 
          RowBox[{"la", ",", "lb"}], "}"}], "]"}]}], "&&", 
       RowBox[{"NoIndexQ", "[", "expr", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
