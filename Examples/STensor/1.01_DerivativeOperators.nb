      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["T", 
        RowBox[{"b", "\[InvisibleComma]", "c"}]]}], "+", 
      RowBox[{
       SubscriptBox["c", "2"], 
       SubscriptBox["F", 
        RowBox[{"b", "\[InvisibleComma]", "c"}]]}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["c", "1"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SubscriptBox["T", 
       RowBox[{"b", "\[InvisibleComma]", "c"}]]}]}], "+", 
    RowBox[{
     SubscriptBox["c", "2"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SubscriptBox["F", 
