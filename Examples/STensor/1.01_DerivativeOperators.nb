 CellLabel->"Out[46]=",ExpressionUUID->"d1076b4c-de40-4b67-8862-78e5edbafc95"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"%", "/.", "cdcdRule"}], "/.", "covdcovdRule"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"1cef92ef-9d06-fb4c-a7b7-73c4535c1399"],

Cell[BoxData[
 RowBox[{
  InterpretationBox[
   StyleBox[
    TemplateBox[{
      SubscriptBox["\!\(\*OverscriptBox[\(\[Del]\), \(~\)]\)", "c"], 
      InterpretationBox[
       StyleBox["f", AutoSpacing -> False, ShowAutoStyles -> False], 
       Apply[$CellContext`f, {}], Editable -> False]},
     "RowDefault"],
    ShowAutoStyles->False,
    AutoSpacing->False],
   $CellContext`CovD[$CellContext`lc, 
    $CellContext`f[]],
   Editable->False], " ", 
  InterpretationBox[
   StyleBox[
    SubsuperscriptBox["t", 
     TemplateBox[{"b", "a", 
       StyleBox["1", ShowContents -> False, StripOnInput -> False]},
      "RowDefault"], 
     TemplateBox[{
       StyleBox["1", ShowContents -> False, StripOnInput -> False], 
       StyleBox["1", ShowContents -> False, StripOnInput -> False], "c"},
      "RowDefault"]],
    ShowAutoStyles->False,
    AutoSpacing->False],
   Apply[mGRG`STensor`Torsion, {$CellContext`lb, $CellContext`la, \
$CellContext`uc}],
   Editable->False]}]], "Output",
 CellChangeTimes->{3.917567804288576*^9, 3.917604985108806*^9, 
