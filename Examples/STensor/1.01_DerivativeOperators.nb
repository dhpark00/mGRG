Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "a"], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Delta]", "c", "b"], 
      SuperscriptBox[
       SubscriptBox["T", "b"], "c"]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]", "c", "b"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      RowBox[{"(", 
       SuperscriptBox[
        SubscriptBox["T", "b"], "c"], ")"}]}]}], "=", 
    RowBox[{
     SubscriptBox["\[PartialD]", "a"], 
     RowBox[{"(", 
      SuperscriptBox[
       SubscriptBox["T", "b"], "b"], ")"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"60e04fc0-26b5-ef44-b784-1bd91acdcba2"]], \
