Cell[TextData[{
 "Then, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "a\[Mu]\[Nu]"], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["B", "\[Mu]a"], "b"], "=", "0"}]}], TraditionalForm]],
  ExpressionUUID->"6b5d548f-30c7-4c2a-b469-6ee2dba7fe99"],
