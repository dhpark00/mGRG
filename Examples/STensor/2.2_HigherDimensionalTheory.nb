          SuperscriptBox["J", "a"], "-", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["A", "\[Mu]"], "a"], 
           SuperscriptBox["J", "\[Mu]"]}]}], ")"}]}], ")"}]}]}]}]],
