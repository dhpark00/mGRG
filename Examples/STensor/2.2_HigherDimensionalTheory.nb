Cell["The \[OpenCurlyQuote]structure constants\[CloseCurlyQuote] of the \
block-diagonal basis are", "Text",
 CellChangeTimes->{{3.758630622200349*^9, 
  3.758630647712809*^9}},ExpressionUUID->"dc905964-b555-4eab-a7eb-\
abb31fd58e6f"],

Cell[BoxData[Cell[TextData[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[PartialD]", "^"], "\[Mu]"], 
      RowBox[{",", 
       SubscriptBox[
        OverscriptBox["\[PartialD]", "^"], "\[Nu]"]}]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       SubscriptBox["F", "\[Mu]\[Nu]"], "a"]}], 
     SubscriptBox["\[PartialD]", "a"]}]}], ",", "    ", 
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      RowBox[{",", 
       SubscriptBox[
        OverscriptBox["\[PartialD]", "^"], "\[Mu]"]}]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       SubscriptBox["B", "\[Mu]a"], "b"]}], 
     SubscriptBox["\[PartialD]", "b"]}]}], ",", "    ", 
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      RowBox[{",", 
       SubscriptBox["\[PartialD]", "b"]}]}], "]"}], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["f", "ab"], "c"], 
     SubscriptBox["\[PartialD]", "c"]}]}]}]],
  CellChangeTimes->{{3.519263508281045*^9, 3.5192635155114584`*^9}, {
