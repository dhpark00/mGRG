Cell[BoxData[Cell[TextData[Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalL]", "EH"], "=", 
   RowBox[{
    OverscriptBox["R", "~"], "+", 
    OverscriptBox["R", "^"], "-", 
    RowBox[{
     FractionBox["1", "4"], 
     SubscriptBox["F", "\[Mu]\[Nu]a"], 
     SuperscriptBox["F", "\[Mu]\[Nu]a"]}], "-", 
    RowBox[{
     SubscriptBox["K", "a\[Mu]\[Nu]"], 
     SuperscriptBox["K", "a\[Mu]\[Nu]"]}], "+", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["K", "a\[Mu]"], "\[Mu]"], 
     SuperscriptBox[
      SubscriptBox[
       SuperscriptBox["K", "a"], "\[Nu]"], "\[Nu]"]}], "-", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox["\[Phi]", "ab"], 
     SuperscriptBox["\[Phi]", "cd"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["D", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "ac"], 
        SuperscriptBox["D", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "bd"]}], "-", 
       RowBox[{
        SubscriptBox["D", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "ab"], 
        SuperscriptBox["D", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "cd"]}]}], ")"}]}]}]}]],
