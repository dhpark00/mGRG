Cell[BoxData[
 RowBox[{
  RowBox[{"simpRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"BD", "[", 
        RowBox[{"la_", ",", 
         RowBox[{"BaseMetric", "[", 
          RowBox[{"l\[Mu]_", ",", "l\[Nu]_"}], "]"}]}], "]"}], ",", "0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"KindIndexQ", "[", "Latin", "]"}], "[", "la", "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"l\[Mu]", ",", "l\[Nu]"}], "}"}], ",", 
          RowBox[{"KindIndexQ", "[", "Greek", "]"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"BD", "[", 
        RowBox[{"l\[Mu]_", ",", 
         RowBox[{"FibreMetric", "[", 
          RowBox[{"ua_", ",", "ub_"}], "]"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"FibreMetric", "[", 
          RowBox[{"ua", ",", "uc"}], "]"}]}], 
        RowBox[{"FibreMetric", "[", 
         RowBox[{"ub", ",", "ud"}], "]"}], 
        RowBox[{"BD", "[", 
         RowBox[{"l\[Mu]", ",", 
          RowBox[{"FibreMetric", "[", 
           RowBox[{"lc", ",", "ld"}], "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ua", ",", "ub"}], "}"}], ",", 
          RowBox[{"KindIndexQ", "[", "Latin", "]"}]}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ua", ",", "ub"}], "}"}], ",", "UpIndexQ"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"KindIndexQ", "[", "Greek", "]"}], "[", "l\[Mu]", "]"}]}]}], 
      "]"}], ",", 
     RowBox[{
      RowBox[{"K", "[", 
       RowBox[{"_", ",", "_", ",", "_"}], "]"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"_", ",", "_", ",", "_"}], "]"}], "\[Rule]", "0"}]}], "}"}]}], 
  ";"}]], "Input",
