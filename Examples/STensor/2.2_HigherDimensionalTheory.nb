Cell[TextData[{
 "The assumption of the isometry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "\[Xi]"], 
     SubscriptBox["g", "AB"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "2ffc37ee-5017-41c2-9367-5e644ef6643c"],
 " gives"
}], "Text",
