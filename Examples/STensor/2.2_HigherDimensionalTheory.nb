Cell[CellGroupData[{

Cell["Block-Diagonal Basis", "Subsection",ExpressionUUID->"134e15a9-71ec-4b63-86d4-0be4cb86d2cc"],

Cell[TextData[{
 "Notice that the block-diagonal basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[PartialD]", "^"], "A"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[PartialD]", "^"], "\[Mu]"], 
        RowBox[{",", " ", 
         SubscriptBox[
          OverscriptBox["\[PartialD]", "^"], "a"]}]}], ")"}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
          RowBox[{"-", " ", 
           SuperscriptBox[
            SubscriptBox["A", "\[Mu]"], "a"]}]}], 
         SubscriptBox["\[PartialD]", "a"]}], ",", " ", 
        SubscriptBox["\[PartialD]", "a"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"d9000904-d3cb-46ec-8af4-b97bf07bed80"],
 " is a non-coordinate basis."
}], "Text",
 CellChangeTimes->{{3.532829799720907*^9, 3.532829799861915*^9}, {
  3.758630030756521*^9, 3.758630032724633*^9}, {3.758686361625159*^9, 
  3.758686386688592*^9}},ExpressionUUID->"5d060ee5-1d33-4950-bce4-\
da5d43732ef9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockMetricRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"la_", ",", "lb_"}], "]"}], ",", 
       RowBox[{"FibreMetric", "[", 
        RowBox[{"la", ",", "lb"}], "]"}], ",", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"la", ",", "lb"}], "}"}], ",", 
         RowBox[{"KindIndexQ", "[", "Latin", "]"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"la_", ",", "lb_"}], "]"}], ",", 
       RowBox[{"BaseMetric", "[", 
        RowBox[{"la", ",", "lb"}], "]"}], ",", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"la", ",", "lb"}], "}"}], ",", 
         RowBox[{"KindIndexQ", "[", "Greek", "]"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"Metricg", "[", 
        RowBox[{"la_", ",", "lb_"}], "]"}], ",", "0", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"KindIndexQ", "[", "Greek", "]"}], "[", "la", "]"}], "&&", 
          RowBox[{
           RowBox[{"KindIndexQ", "[", "Latin", "]"}], "[", "lb", "]"}]}], 
         ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"KindIndexQ", "[", "Greek", "]"}], "[", "lb", "]"}], "&&", 
          RowBox[{
           RowBox[{"KindIndexQ", "[", "Latin", "]"}], "[", "la", "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.58590287134531*^9, 3.585902889281336*^9}, {
  3.712291519567431*^9, 3.712291527198814*^9}, {3.7585202720122313`*^9, 
  3.7585203480925827`*^9}, {3.7586301134052477`*^9, 3.7586301254699388`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"8ecb40d0-db85-45d2-8181-c347bd618aee"],

Cell[CellGroupData[{

