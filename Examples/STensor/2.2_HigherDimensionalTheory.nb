Cell["The Einstein-Hilbert action therefore becomes", "Text",
 CellChangeTimes->{{3.5201514902105927`*^9, 3.5201515074723883`*^9}, {
  3.538893484725257*^9, 
  3.538893499298091*^9}},ExpressionUUID->"a5f57c0d-1346-4578-8ff1-\
149fbd919ad1"],

Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    SubscriptBox["I", "EH"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"16", "\[Pi]", " ", "G"}]], 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["d", "D"], "x", " ", 
        SqrtBox[
         RowBox[{"-", "g"}]], "R"}]}]}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"16", "\[Pi]", " ", "G"}]], 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["d", "D"], "x", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SqrtBox[
            RowBox[{"-", "g"}]], 
           SubscriptBox["\[ScriptCapitalL]", "EH"]}], " ", "-", " ", 
          RowBox[{
           SqrtBox[
            RowBox[{"-", "g"}]], 
           RowBox[{
            SubscriptBox["\[Del]", "A"], 
            SuperscriptBox["J", "A"]}]}]}], ")"}]}]}]}]}]}]],
   CellChangeTimes->{{3.519263508281045*^9, 3.5192635155114584`*^9}, {
