371444ca6c7b"],

Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SubscriptBox["\[Gamma]", "\[Mu]\[Nu]"]}], "=", "0"}], ",", "    ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SuperscriptBox[
       SubscriptBox["A", "\[Mu]"], "b"]}], "=", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        SubscriptBox["f", "ac"], "b"]}], 
      SuperscriptBox[
       SubscriptBox["A", "\[Mu]"], "c"]}]}], ",", "    ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SubscriptBox["\[Phi]", "bc"]}], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["f", "ab"], "d"], 
       SubscriptBox["\[Phi]", "cd"]}], "+", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["f", "ac"], "d"], 
       SubscriptBox["\[Phi]", "bd"]}]}]}]}]],
