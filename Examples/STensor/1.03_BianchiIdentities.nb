 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TorsionFreeQ", "[", "CD", "]"}], "=", "False"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"non", "-", "default"}], "*)"}]}]], "Input",
