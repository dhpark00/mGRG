 CellChangeTimes->{{3.758363919832938*^9, 3.7583639252322474`*^9}, {
  3.827115878842589*^9, 3.827115879115946*^9}, {3.951107772164112*^9, 
  3.951107774623955*^9}, {3.979296685105836*^9, 3.9792966881084013`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"442b59bf-3817-4a6e-9919-fdbbddda36bc"],

Cell["We choose a coorninate basis:", "Text",
 CellChangeTimes->{{3.9205416448495426`*^9, 3.9205416694652443`*^9}, {
  3.920544791332855*^9, 
  3.9205448027645683`*^9}},ExpressionUUID->"797457ba-be29-4a45-8c09-\
fc562e9b1582"],

Cell[BoxData[
 RowBox[{
  RowBox[{"On", "[", "CoordinateBasisFlag", "]"}], "  ", 
  RowBox[{"(*", "default", "*)"}]}]], "Input",
 CellChangeTimes->{{3.8271158958835945`*^9, 3.8271158958835945`*^9}, 
   3.9511078780229015`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"3a5ff7fb-49f2-45e9-b232-c816b4e370d8"],

Cell[TextData[{
 "In spacetime with torsion, the Bianchi identity is expressed in terms of \
the curvature tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["R", 
     RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], "d"],
    TraditionalForm]],ExpressionUUID->"c14d6a4d-bc5e-b24a-bc8d-630553ddba7b"],
 " and the covariant derivatives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Del]", "a"], TraditionalForm]],ExpressionUUID->
  "7c3c844c-2979-d044-a955-423f6d69890d"],
 ". In this notebook, we convert both the curvature tensor and its covariant \
derivative to the ordinary derivatives of torsion ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["t", 
     RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], TraditionalForm]],
  ExpressionUUID->"c2f55c07-3128-bd44-8da4-b5cc99d7b319"],
 " and the metric tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"a", "\[InvisibleComma]", "b"}]], TraditionalForm]],
  ExpressionUUID->"fad7e7f7-1d29-464b-a841-0e34b57479eb"],
 ", and then simplify the resultant expressions with the Tsimplify command to \
verify the Bianchi identity."
}], "Text",
 CellChangeTimes->{{3.920543884184971*^9, 3.9205440168939533`*^9}, {
   3.92054406000885*^9, 3.920544102366926*^9}, {3.9205442806348457`*^9, 
   3.920544299411234*^9}, {3.920544496544279*^9, 3.9205445043283787`*^9}, {
   3.9205446810073624`*^9, 3.920544681478565*^9}, {3.920544769013941*^9, 
   3.920544771238323*^9}, {3.9511079266735897`*^9, 3.9511079268042183`*^9}, {
   3.979296766131447*^9, 3.979296774186213*^9}, {3.9792968754597673`*^9, 
   3.97929688230647*^9}, {3.9792969278875093`*^9, 3.979296946620119*^9}, 
   3.979296984075801*^9},ExpressionUUID->"208ba299-4ad3-1249-8e0e-\
cf2fac8900ba"],

