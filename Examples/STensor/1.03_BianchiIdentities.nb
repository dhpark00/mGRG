Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "a"], 
        SubscriptBox["g", 
         RowBox[{"b", "\[InvisibleComma]", "c"}]]}], "+", 
       RowBox[{
        SubscriptBox["\[PartialD]", "b"], 
        SubscriptBox["g", 
         RowBox[{"a", "\[InvisibleComma]", "c"}]]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", "c"], 
        SubscriptBox["g", 
         RowBox[{"a", "\[InvisibleComma]", "b"}]]}]}], ")"}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], "+", 
       SubscriptBox["t", 
        RowBox[{"c", "\[InvisibleComma]", "a", "\[InvisibleComma]", "b"}]], "+", 
       SubscriptBox["t", 
        RowBox[{"c", "\[InvisibleComma]", "b", "\[InvisibleComma]", "a"}]]}], 
      ")"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"35ef57c7-99db-ac4e-8883-db1513bee3ec"]], \
