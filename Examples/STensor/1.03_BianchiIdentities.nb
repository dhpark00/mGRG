Cell[CellGroupData[{
Cell["Bianchi Identities in Torsionful SpaceTime", "Title",
 CellChangeTimes->{{3.9205397249199524`*^9, 3.9205397323429947`*^9}, {
  3.972038433486618*^9, 3.972038435948153*^9}},
 FontSize->24,ExpressionUUID->"e1d5d2b0-6ea4-410c-9ce8-658ca246f251"],

Cell[CellGroupData[{

