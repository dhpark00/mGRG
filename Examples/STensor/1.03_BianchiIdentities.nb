          RowBox[{"b", "\[InvisibleComma]", "c"}]], "d"]}], "+", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[CapitalGamma]", 
          RowBox[{"a", "\[InvisibleComma]", "p"}]], "d"], 
        SuperscriptBox[
         SubscriptBox["\[CapitalGamma]", 
          RowBox[{"b", "\[InvisibleComma]", "c"}]], "p"]}], "-", 
       RowBox[{"(", 
        RowBox[{"a", "\[LeftRightArrow]", "b"}], ")"}]}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"4075991a-8c00-9245-b40f-8c3328487862"],
 ","
}], "Text",
