78386fc8b57f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"GammaCovD", "[", 
    RowBox[{"l\[Mu]", ",", "l\[Nu]", ",", "u\[Rho]"}], "]"}], ",", 
   RowBox[{"RiemannCovD", "[", 
    RowBox[{"l\[Mu]", ",", "l\[Nu]", ",", "l\[Rho]", ",", "u\[Sigma]"}], 
    "]"}], ",", 
   RowBox[{"RicciCovD", "[", 
    RowBox[{"l\[Mu]", ",", "l\[Nu]"}], "]"}], ",", 
   RowBox[{"TorsionGreek", "[", 
    RowBox[{"l\[Mu]", ",", "l\[Nu]", ",", "u\[Rho]"}], "]"}]}], 
  "}"}]], "Input",
