 TextAlignment->Center,ExpressionUUID->"a803aa63-c6ac-a44b-a0a1-cee830c27289"],

Cell[TextData[{
 "Recall that the \[OpenCurlyQuote]Greek\[CloseCurlyQuote] kind is in the \
coordinate basis: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["f", "\[Mu]\[Nu]"], "\[Rho]"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "586cb036-b703-4617-84f4-3093ddbd8a0f"],
 "."
}], "Text",
