 CellLabel->"In[4]:=",ExpressionUUID->"44e97714-6043-8b46-99b7-3635f5747160"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    StyleBox[
     SubsuperscriptBox[
      RowBox[{"\[CapitalGamma]", "[", 
       OverscriptBox["\[Del]", "~"], "]"}], 
      TemplateBox[{"\[Mu]", "\[Nu]", 
        StyleBox["1", ShowContents -> False, StripOnInput -> False]},
       "RowDefault"], 
      TemplateBox[{
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        StyleBox["1", ShowContents -> False, StripOnInput -> False], "\[Rho]"},
       "RowDefault"]],
     ShowAutoStyles->False,
     AutoSpacing->False],
    Apply[$CellContext`GammaCovD, {$CellContext`l\[Mu], $CellContext`l\[Nu], \
$CellContext`u\[Rho]}],
    Editable->False], ",", 
   InterpretationBox[
    StyleBox[
     SubsuperscriptBox[
      RowBox[{"R", "[", 
       OverscriptBox["\[Del]", "~"], "]"}], 
      TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]", 
        StyleBox["1", ShowContents -> False, StripOnInput -> False]},
       "RowDefault"], 
      TemplateBox[{
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        "\[Sigma]"},
       "RowDefault"]],
     ShowAutoStyles->False,
     AutoSpacing->False],
    Apply[$CellContext`RiemannCovD, {$CellContext`l\[Mu], \
$CellContext`l\[Nu], $CellContext`l\[Rho], $CellContext`u\[Sigma]}],
    Editable->False], ",", 
   InterpretationBox[
    StyleBox[
     SubsuperscriptBox[
      RowBox[{"R", "[", 
       OverscriptBox["\[Del]", "~"], "]"}], 
      TemplateBox[{"\[Mu]", "\[Nu]"},
       "RowDefault"], 
      TemplateBox[{
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        StyleBox["1", ShowContents -> False, StripOnInput -> False]},
       "RowDefault"]],
     ShowAutoStyles->False,
     AutoSpacing->False],
    Apply[$CellContext`RicciCovD, {$CellContext`l\[Mu], $CellContext`l\[Nu]}],
    Editable->False], ",", 
   InterpretationBox[
    StyleBox[
     SubsuperscriptBox[
      RowBox[{"t", "[", "Greek", "]"}], 
      TemplateBox[{"\[Mu]", "\[Nu]", 
        StyleBox["1", ShowContents -> False, StripOnInput -> False]},
       "RowDefault"], 
      TemplateBox[{
        StyleBox["1", ShowContents -> False, StripOnInput -> False], 
        StyleBox["1", ShowContents -> False, StripOnInput -> False], "\[Rho]"},
