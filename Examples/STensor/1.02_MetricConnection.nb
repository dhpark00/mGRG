Cell[TextData[{
 "The metric-compatibility condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["MC", "\[Mu]\[Nu]\[Alpha]"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"a101802e-349a-3649-a260-87cd9c566290"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "\[Mu]\[Nu]\[Alpha]"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"8f47b833-3335-3c42-8942-d883cf08931e"],
 ", so the metric-compatible connection becomes"
}], "Text",
 CellChangeTimes->{{3.9510918851495075`*^9, 3.951091953385021*^9}, 
   3.9554172295418463`*^9},ExpressionUUID->"90d84b39-36fb-4e4c-b8e3-\
d2f1c49ef93b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[CapitalGamma]", "\[Mu]\[Nu]"], "\[Alpha]"], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox[
       OverscriptBox["\[CapitalGamma]", "_"], "\[Mu]\[Nu]"], "\[Alpha]"], "+", 
     SuperscriptBox[
      SubscriptBox["C", "\[Mu]\[Nu]"], "\[Alpha]"]}]}], TraditionalForm]],
  ExpressionUUID->"c74f577b-99e2-1641-bb3d-8e2d392a3be6"],
 "."
}], "Text",
