Cell[TextData[{
 "If a metric tensor has \[OpenCurlyQuote]low-up\[CloseCurlyQuote] or \
\[OpenCurlyQuote]up-low\[CloseCurlyQuote] indices and of the same kind, it \
turns into the Kdelta. Recall that the Kdelta ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[Delta]", "\[Alpha]"], "\[Beta]"], TraditionalForm]],
  ExpressionUUID->"92b85b24-56a5-9849-9cf1-e48688d3ad84"],
 " is  a constant tensor:"
}], "Text",
 CellChangeTimes->{{3.9194255837867355`*^9, 3.9194256311446877`*^9}, {
  3.919425698680599*^9, 3.9194257131524105`*^9}, {3.9194257433437195`*^9, 
  3.919425760775831*^9}, {3.9194260303975773`*^9, 3.9194260397418327`*^9}, {
  3.919505046850815*^9, 3.9195050475843525`*^9}, {3.91950509138291*^9, 
  3.919505133051079*^9}},ExpressionUUID->"1a2cc54c-fba3-8541-bb69-\
aa5d4637c0e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[Gamma]", "[", 
    RowBox[{"l\[Alpha]", ",", "u\[Beta]"}], "]"}], ",", 
   RowBox[{"\[Gamma]", "[", 
    RowBox[{"u\[Alpha]", ",", "l\[Beta]"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CovD", "[", 
    RowBox[{"l\[Mu]", ",", "#"}], "]"}], "&"}], "/@", "%"}]}], "Input",
