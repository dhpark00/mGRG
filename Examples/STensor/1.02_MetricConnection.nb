     ShowAutoStyles->False,
     AutoSpacing->False],
    Apply[$CellContext`TorsionGreek, {$CellContext`l\[Mu], \
$CellContext`l\[Nu], $CellContext`u\[Rho]}],
    Editable->False]}], "}"}]], "Output",
