   3.919423566027748*^9}},ExpressionUUID->"b64dc406-1a1c-694a-8cef-\
78f47c72c020"],

Cell[BoxData[
 RowBox[{"DefDerivativeOperator", "[", 
  RowBox[{
  "CovD", ",", "\"\<\!\(\*OverscriptBox[\(\[Del]\), \(~\)]\)\>\"", ",", 
   "Greek", ",", 
   RowBox[{"TorsionFreeQ", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"1c02c274-019a-5742-9e1f-5a8aafb7beee"],

Cell["Automatically defined tensors by \[OpenCurlyQuote]DefDerivativeOperator\
