4e1864a7b05d"],

Cell[TextData[{
 "Define a derivative operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Del]", "~"], "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "53a20b13-bb02-c54c-97e9-4643a0191150"],
 " for the \[OpenCurlyQuote]Greek\[CloseCurlyQuote] Kind:"
}], "Text",
