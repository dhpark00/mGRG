Cell[TextData[{
 "Antisymmetric: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", 
     RowBox[{
     "a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c", "\[InvisibleSpace]",
       "d"}]], "=", 
