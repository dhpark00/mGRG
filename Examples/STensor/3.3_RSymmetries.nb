Cell[TextData[{
 "From the first and the second equation we see that, in n-dimensional \
spacetime, the degrees of freedom of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "abcd"], TraditionalForm]],ExpressionUUID->
  "5744812f-f129-4e26-b457-ff4dae5112cd"],
 " is"
}], "Text",
 CellChangeTimes->{{3.510105529828125*^9, 
  3.510105530765625*^9}},ExpressionUUID->"89babcf4-bdca-4619-b7f7-\
15b003b6962e"],

Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "n", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "n", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}], " ", "+", " ", "1"}], ")"}]}], " ",
     "=", " ", 
    RowBox[{
     FractionBox["1", "8"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["n", "4"], " ", "-", " ", 
       RowBox[{"2", 
        SuperscriptBox["n", "3"]}], " ", "+", 
       RowBox[{"3", 
        SuperscriptBox["n", "2"]}], " ", "-", " ", 
       RowBox[{"2", "n"}]}], ")"}]}]}]],
   CellChangeTimes->{3.9161372802478313`*^9},
   TextAlignment->Center,ExpressionUUID->
   "ea3fd713-ff7f-0049-8b32-31b1c6320f23"]],ExpressionUUID->
   "58dd47d8-889c-684b-a991-cf0ee97934f8"], "."}]], "Text",
 CellChangeTimes->{{3.9161372802478313`*^9, 3.916137287020008*^9}, 
   3.972556279558681*^9},
 TextAlignment->Center,ExpressionUUID->"367babd0-a0a9-4f3d-8633-0205ad9bf608"],

Cell[TextData[{
 "Furthermore, the third equation gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "!"}]], 
    RowBox[{"n", "(", 
     RowBox[{"n", "-", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"n", "-", "2"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"n", "-", "3"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "67ce8f4f-ad22-4692-9936-919467319a57"],
 " constraints. Therefore, the Riemann tensor has"
}], "Text",ExpressionUUID->"6d761a2d-d153-40a8-9e24-d0545a235c22"],

Cell[BoxData[Cell[TextData[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "8"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["n", "4"], " ", "-", " ", 
       RowBox[{"2", 
        SuperscriptBox["n", "3"]}], " ", "+", 
       RowBox[{"3", 
        SuperscriptBox["n", "2"]}], " ", "-", " ", 
       RowBox[{"2", "n"}]}], ")"}]}], " ", "-", " ", 
    RowBox[{
     FractionBox["1", "24"], "n", 
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"n", "-", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"n", "-", "3"}], ")"}]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "12"], 
    SuperscriptBox["n", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["n", "2"], "-", "1"}], ")"}]}]}]],
  CellChangeTimes->{3.9161372945869465`*^9},
  TextAlignment->Center,ExpressionUUID->
  "39e43f3c-7391-5146-919d-8046a808a3de"]],ExpressionUUID->
  "08c41c16-03fb-ec46-8e34-76363167005a"]], "Text",
 CellChangeTimes->{{3.9161372945869465`*^9, 3.9161373044379883`*^9}},
 TextAlignment->Center,ExpressionUUID->"60538464-557e-4d12-bdf7-2403410ce2f5"],

Cell[TextData[{
 "independent components. In particular, in four dimension ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "abcd"], TraditionalForm]],ExpressionUUID->
  "04d9115c-ac32-4a81-afd8-ef18d4d0ab14"],
 " has 20 independent components."
}], "Text",ExpressionUUID->"7565d10d-249c-4b9c-ba8b-77ac2a318902"]
}, Closed]],

Cell[CellGroupData[{

Cell["Bianchi Identity", "Subsubsection",ExpressionUUID->"7d85d729-7ba4-4355-84af-cf553830e940"],

Cell[BoxData[Cell[TextData[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "a"], 
     SuperscriptBox[
      SubscriptBox["R", "bcd"], "e"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "b"], 
     SuperscriptBox[
      SubscriptBox["R", "cad"], "e"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "c"], 
