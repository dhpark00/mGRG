 CellChangeTimes->{{3.9512551034542904`*^9, 3.951255129433174*^9}, {
  3.972556100131218*^9, 3.972556100738708*^9}},
 FontSize->24,ExpressionUUID->"3af927fd-25c7-4bba-b0e8-911828f25466"],

Cell[CellGroupData[{

Cell["Riemann Tensor in the Normal Coordinates", "Subsubsection",ExpressionUUID->"fa70b444-b045-4bc8-8124-1232f9a7e146"],

Cell[TextData[{
 "At any point one can always choose the Riemann normal coordinates in which ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"a", "\[InvisibleSpace]", "b"}]], TraditionalForm]],
  ExpressionUUID->"4b6b6591-2f7b-4d4f-883b-890e999208fc"],
 " takes the flat form and the first derivatives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "a"], 
    SubscriptBox["g", 
     RowBox[{"b", "\[InvisibleSpace]", "c"}]]}], TraditionalForm]],
  ExpressionUUID->"4330cb45-43a3-42e3-97fd-e17ffaf7fc5c"],
 " all vanish (while the second derivative cannot be made to all vanish)."
}], "Text",
 CellChangeTimes->{
  3.5191701962620783`*^9},ExpressionUUID->"4fbd452c-aef9-4808-8472-\
f758e86e3ae7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"rule", " ", "for", " ", "Riemann"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rncRule", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"BD", "[", 
        RowBox[{"la_", ",", 
         RowBox[{"Metricg", "[", 
          RowBox[{"lb_", ",", "lc_"}], "]"}]}], "]"}], " ", 
       RowBox[{"BD", "[", 
        RowBox[{"ld_", ",", 
         RowBox[{"Metricg", "[", 
          RowBox[{"le_", ",", "lf_"}], "]"}]}], "]"}]}], "\[RuleDelayed]", 
      "0"}], "}"}]}], ";"}]}]], "Input",
