Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["T", "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], 
      SuperscriptBox["S", "b"]}]}], "=", 
    RowBox[{
     SuperscriptBox["S", "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], 
      SuperscriptBox["T", "b"]}]}]}], TraditionalForm]],ExpressionUUID->
  "441dc1e4-2fa1-4d66-83b6-57622a023b07"],
 ", the first and the second terms cancle out"
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.716452877216075*^9, 3.7164528873931446`*^9}, {
  3.716453065740569*^9, 3.716453078095191*^9}, {3.827304823208772*^9, 
