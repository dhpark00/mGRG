b127e8593986"],

Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["T", "a"], 
        RowBox[{
         SubscriptBox["\[Del]", "a"], 
         SuperscriptBox["S", "b"]}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", "b"], 
        SuperscriptBox["T", "d"]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["S", "a"], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "a"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["T", "b"], 
          RowBox[{
           SubscriptBox["\[Del]", "b"], 
           SuperscriptBox["T", "d"]}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "a"], 
          SuperscriptBox["T", "b"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "b"], 
          SuperscriptBox["T", "d"]}], ")"}]}]}], "]"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["S", "a"], 
      RowBox[{
       SubscriptBox["\[Del]", "a"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["T", "b"], 
         RowBox[{
          SubscriptBox["\[Del]", "b"], 
          SuperscriptBox["T", "d"]}]}], ")"}]}]}], "=", "0"}]}]],
