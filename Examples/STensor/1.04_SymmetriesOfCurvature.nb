Cell[BoxData[
 RowBox[{"byPartRule1", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"BD", "[", 
      RowBox[{"a_", ",", 
       RowBox[{"Torsion", "[", 
        RowBox[{"b_", ",", "c_", ",", "d_"}], "]"}]}], "]"}], 
     RowBox[{"Metricg", "[", 
      RowBox[{"e_", ",", "f_"}], "]"}]}], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{"BD", "[", 
      RowBox[{"a", ",", 
       RowBox[{"Absorbg", "[", 
        RowBox[{
         RowBox[{"Torsion", "[", 
          RowBox[{"b", ",", "c", ",", "d"}], "]"}], 
         RowBox[{"Metricg", "[", 
          RowBox[{"e", ",", "f"}], "]"}]}], "]"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"Torsion", "[", 
       RowBox[{"b", ",", "c", ",", "d"}], "]"}], 
      RowBox[{"BD", "[", 
       RowBox[{"a", ",", 
        RowBox[{"Metricg", "[", 
         RowBox[{"e", ",", "f"}], "]"}]}], "]"}]}]}]}], "}"}]}]], "Input",
