Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["T", 
      RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["t", 
         RowBox[{"a", "\[InvisibleComma]", "b"}]], "c"], "-", 
       RowBox[{
        SubscriptBox["t", "a"], 
        SubsuperscriptBox["\[Delta]", "b", "c"]}], "+", 
       RowBox[{
        SubscriptBox["t", "b"], 
        SubsuperscriptBox["\[Delta]", "a", "c"]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"91ed019f-effb-a048-9659-bb4652edb3e0"],
 " is the modified torsion tensor and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "a"], "=", 
    SuperscriptBox[
     SubscriptBox["t", 
      RowBox[{"a", "\[InvisibleComma]", "p"}]], "p"]}], TraditionalForm]],
  ExpressionUUID->"5d8c00c8-4db6-dc4c-8095-43c67054beec"],
 "."
}], "Text",
 CellChangeTimes->{{3.923739813679844*^9, 
  3.9237399398231487`*^9}},ExpressionUUID->"f2950a5e-e45f-544d-86a0-\
cdfd3d8c2abd"],

Cell[BoxData[
 RowBox[{
