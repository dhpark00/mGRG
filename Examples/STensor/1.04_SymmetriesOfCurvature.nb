Cell[TextData[{
 "Let us introduce a simplification Rule: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], 
       SuperscriptBox[
        SubscriptBox["t", 
         RowBox[{"b", "\[InvisibleSpace]", "c"}]], "e"]}], ")"}], 
     SubscriptBox["g", 
      RowBox[{"d", "\[InvisibleSpace]", "e"}]]}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "a"], 
      SubscriptBox["t", 
       RowBox[{"b", "\[InvisibleSpace]", "c", "\[InvisibleSpace]", "d"}]]}], "-", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["t", 
        RowBox[{"b", "\[InvisibleSpace]", "c"}]], "e"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], 
       SubscriptBox["g", 
        RowBox[{"d", "\[InvisibleSpace]", "e"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0b71234c-58a0-4a3e-8fb6-6586e1bbe1e7"]
}], "Text",
 CellChangeTimes->{{3.760157931176435*^9, 3.760158038554577*^9}, {
