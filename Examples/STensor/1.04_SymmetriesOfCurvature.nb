   RowBox[{"la_", ",", "lb_", ",", "uc_"}], "]"}], ":=", "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"modified", " ", "torsion"}], " ", "*)"}], 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Torsion", "[", 
      RowBox[{"la", ",", "lb", ",", "uc"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Torsion", "[", 
       RowBox[{"la", ",", "lp", ",", "up"}], "]"}], 
      RowBox[{"Kdelta", "[", 
       RowBox[{"lb", ",", "uc"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Torsion", "[", 
       RowBox[{"lb", ",", "lp", ",", "up"}], "]"}], 
      RowBox[{"Kdelta", "[", 
       RowBox[{"la", ",", "uc"}], "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9237405913960457`*^9, 3.9237406377461433`*^9}, {
