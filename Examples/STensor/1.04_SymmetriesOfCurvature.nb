Cell[CellGroupData[{

Cell[TextData[{
 "Proof of Anti-symmetricity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{
     "a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c", "\[InvisibleSpace]",
       "d"}]], "=", 
    SubscriptBox["R", 
     RowBox[{
      RowBox[{"[", 
       RowBox[{"a", "\[InvisibleSpace]", "b"}], "]"}], "[", 
      RowBox[{"c", "\[InvisibleSpace]", "d"}], "]"}]]}], TraditionalForm]],
  ExpressionUUID->"caff31c9-201c-5246-9f14-89323946d947"]
}], "Subsection",
 CellChangeTimes->{{3.758339095835521*^9, 3.758339098907699*^9}, {
   3.760157755489386*^9, 3.760157795560678*^9}, {3.920627622338043*^9, 
   3.920627631657921*^9}, 3.920627995125242*^9, 3.9206280297164936`*^9, 
   3.9206281004677567`*^9, {3.9511121851160717`*^9, 3.9511121973851204`*^9}, {
   3.9511122641488094`*^9, 
   3.951112296962639*^9}},ExpressionUUID->"6f9a65bf-9b47-412c-9b72-\
2c76f86a3a7f"],

Cell[TextData[{
 "By definition, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["R", 
      RowBox[{"a", "\[InvisibleComma]", "b", "\[InvisibleComma]", "c"}]], 
     "d"], "=", 
    SuperscriptBox[
     SubscriptBox["R", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"a", "\[InvisibleComma]", "b"}], "]"}], "c"}]], "d"]}], 
   TraditionalForm]],ExpressionUUID->"0cfddfc6-07d7-3e45-82ae-621cca33153f"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "abcd"], "=", 
    RowBox[{
     SubscriptBox["g", "de"], 
     SuperscriptBox[
      SubscriptBox["R", "abc"], "e"]}]}], TraditionalForm]],ExpressionUUID->
  "3cc94754-1fdd-4e34-80b9-43e7350b54b7"],
 " and the metric-compatibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "a"], 
     SubscriptBox["g", 
      RowBox[{"b", "\[InvisibleSpace]", "c"}]]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"29e10ac1-25d6-ec4b-b8c8-eeac1cabc266"],
 " we have"
}], "Text",
 CellChangeTimes->{{3.7583391594281588`*^9, 3.758339265870247*^9}, {
  3.9206276662201805`*^9, 3.920627716601408*^9}, {3.9206281241481676`*^9, 
  3.9206281526858234`*^9}, {3.9237427009193783`*^9, 3.923742702086994*^9}, {
  3.951195063573473*^9, 
  3.9511951016361637`*^9}},ExpressionUUID->"8711fb41-f1af-4af9-8975-\
5cb398b3df73"],

Cell[BoxData[
 RowBox[{
  RowBox[{"0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "a"], 
         RowBox[{
          SubscriptBox["\[Del]", "b"], 
          RowBox[{"-", 
           RowBox[{
            SubscriptBox["\[Del]", "b"], 
            RowBox[{
             SubscriptBox["\[Del]", "a"], 
             RowBox[{"+", 
              SuperscriptBox[
               SubscriptBox["t", "ab"], "e"]}]}]}]}]}]}], 
        SubscriptBox["\[Del]", "e"]}], ")"}], 
      SubscriptBox["g", "cd"]}], "\[Congruent]", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["R", "abc"], "e"], 
       SubscriptBox["g", "ed"]}], "+", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["R", "abd"], "e"], 
       SubscriptBox["g", "ce"]}]}]}], "=", 
    RowBox[{
     SubscriptBox["R", "abcd"], "+", 
     SubscriptBox["R", "abdc"]}]}]}], ","}]], "DisplayFormula",
 CellChangeTimes->{{3.7583391244771595`*^9, 3.758339143748261*^9}, {
   3.758339185881671*^9, 3.758339187309753*^9}, 3.920628155492434*^9, {
   3.92373872345994*^9, 3.9237387249777584`*^9}, {3.951195125683363*^9, 
