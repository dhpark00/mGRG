  RowBox[{
   RowBox[{
    SubscriptBox["\[Delta]", "g"], 
    SubscriptBox["R", "\[Mu]\[Nu]"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", "g"], 
     SuperscriptBox[
      SubscriptBox["R", "\[Mu]\[Rho]\[Nu]"], "\[Rho]"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Del]", "\[Mu]"], 
        SubscriptBox["\[Delta]", "g"]}]}], 
      SuperscriptBox[
       SubscriptBox["\[CapitalGamma]", "\[Rho]\[Nu]"], "\[Rho]"]}], "+", 
