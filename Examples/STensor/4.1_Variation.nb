Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{"f", "\[InvisibleSpace]", 
     RowBox[{
      SubscriptBox["\[Delta]", 
       SuperscriptBox["g", "ab"]], "(", 
      RowBox[{
       SubscriptBox["\[PartialD]", "c"], 
       SuperscriptBox["v", "c"]}], ")"}]}]}], "=", 
   RowBox[{"-", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"(", 
