  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"-", "g"}]], 
    SuperscriptBox["g", "\[Mu]\[Nu]"], 
    SubscriptBox["\[Delta]", "g"], 
    SubscriptBox["R", "\[Mu]\[Nu]"]}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
