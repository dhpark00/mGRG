Cell[BoxData[Cell[TextData[Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Delta]", "g"], 
    SuperscriptBox[
     SubscriptBox["R", "\[Mu]\[Nu]\[Rho]"], "\[Sigma]"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       SubscriptBox["\[Del]", "\[Mu]"], 
       SubscriptBox["\[Delta]", "g"]}]}], 
     SuperscriptBox[
      SubscriptBox["\[CapitalGamma]", "\[Nu]\[Rho]"], "\[Sigma]"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "\[Nu]"], 
      SubscriptBox["\[Delta]", "g"]}], 
     SuperscriptBox[
      SubscriptBox["\[CapitalGamma]", "\[Mu]\[Rho]"], "\[Sigma]"]}]}]}]],
