Cell[TextData[{
 "Therefore, in vacuum, the Einstein equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SubscriptBox["\[Psi]", "\[Mu]\[Nu]"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"f5f58c70-8713-4497-a7d2-839291eb8c8b"],
 " becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SubscriptBox["h", "\[Mu]\[Nu]"]}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"3621a9b7-1512-4b7b-88de-8ebc3f30fbff"],
 " in the Einstein gauge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SuperscriptBox[
      SubscriptBox["\[Psi]", "\[Nu]"], "\[Mu]"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       SuperscriptBox[
        SubscriptBox["h", "\[Nu]"], "\[Mu]"]}], " ", "-", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Nu]"], "h"}]}]}], " ", "=", " ", 
     "0"}]}], TraditionalForm]],ExpressionUUID->
  "ca5ccbb9-fc17-4da5-bc6e-c4a256feccf5"],
 "."
}], "Text",
 CellChangeTimes->{{3.520636204208757*^9, 3.520636220271438*^9}, 
   3.758787227206333*^9, {3.827122347524926*^9, 
   3.827122419363776*^9}},ExpressionUUID->"1b4e2b56-3f18-43f2-977b-\
5b3b27576eff"],

