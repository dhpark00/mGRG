Cell[TextData[{
 "Under a coordinate transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"x", "'"}], "\[Mu]"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["x", "\[Mu]"], " ", "+", " ", 
     RowBox[{"\[Epsilon]", " ", 
      SuperscriptBox["\[Xi]", "\[Mu]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"858eafab-860b-4987-952e-8b0aa9c034a9"],
 ", the metric transforms as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "\[Mu]\[Nu]", "'"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["h", "\[Mu]\[Nu]"], " ", "-", " ", 
     RowBox[{"2", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"(", "\[Mu]"}]], 
       SubscriptBox["\[Xi]", 
        RowBox[{"\[Vee]", ")"}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "18f3e9b6-5f25-430b-b6b0-e1c3a7491d13"],
 "."
}], "Text",
