Cell[BoxData[
 FormBox[Cell[TextData[Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["u", "\[Rho]"], 
      RowBox[{
       SubscriptBox["\[Del]", "\[Rho]"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["u", "\[Sigma]"], 
         RowBox[{
          SubscriptBox["\[Del]", "\[Sigma]"], 
          SuperscriptBox["X", "\[Mu]"]}]}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        SubscriptBox["R", "\[Nu]\[Rho]\[Sigma]"], "\[Mu]"]}], 
      SuperscriptBox["u", "\[Nu]"], 
      SuperscriptBox["X", "\[Rho]"], 
      SuperscriptBox["u", "\[Sigma]"]}]}], TraditionalForm]],
   CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
