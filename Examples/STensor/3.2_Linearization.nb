           SubscriptBox["\[PartialD]", "\[Sigma]"], 
           InterpretationBox[
            StyleBox[
             SubsuperscriptBox["h", 
              TemplateBox[{"\[Nu]", "\[Rho]"}, "RowDefault"], 
              TemplateBox[{
                StyleBox["1", ShowContents -> False, StripOnInput -> False], 
                StyleBox["1", ShowContents -> False, StripOnInput -> False]}, 
               "RowDefault"]], AutoSpacing -> False, ShowAutoStyles -> False], 
            
            Apply[$CellContext`h, {$CellContext`l\[Nu], \
$CellContext`l\[Rho]}], Editable -> False]}, "RowDefault"], AutoSpacing -> 
         False, ShowAutoStyles -> False], 
        mGRG`STensor`BD[$CellContext`l\[Sigma], 
         $CellContext`h[$CellContext`l\[Nu], $CellContext`l\[Rho]]], Editable -> 
        False]},
      "RowDefault"],
     ShowAutoStyles->False,
     AutoSpacing->False],
    mGRG`STensor`BD[$CellContext`l\[Mu], 
     mGRG`STensor`BD[$CellContext`l\[Sigma], 
      $CellContext`h[$CellContext`l\[Nu], $CellContext`l\[Rho]]]],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "\[Epsilon]", " ", 
   InterpretationBox[
    StyleBox[
     TemplateBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], 
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           SubscriptBox["\[PartialD]", "\[Rho]"], 
           InterpretationBox[
            StyleBox[
             SubsuperscriptBox["h", 
              TemplateBox[{"\[Mu]", "\[Sigma]"}, "RowDefault"], 
              TemplateBox[{
                StyleBox["1", ShowContents -> False, StripOnInput -> False], 
                StyleBox["1", ShowContents -> False, StripOnInput -> False]}, 
               "RowDefault"]], AutoSpacing -> False, ShowAutoStyles -> False], 
            
            Apply[$CellContext`h, {$CellContext`l\[Mu], \
$CellContext`l\[Sigma]}], Editable -> False]}, "RowDefault"], AutoSpacing -> 
         False, ShowAutoStyles -> False], 
        mGRG`STensor`BD[$CellContext`l\[Rho], 
         $CellContext`h[$CellContext`l\[Mu], $CellContext`l\[Sigma]]], 
        Editable -> False]},
      "RowDefault"],
     ShowAutoStyles->False,
     AutoSpacing->False],
    mGRG`STensor`BD[$CellContext`l\[Nu], 
     mGRG`STensor`BD[$CellContext`l\[Rho], 
      $CellContext`h[$CellContext`l\[Mu], $CellContext`l\[Sigma]]]],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "2"], " ", "\[Epsilon]", " ", 
   InterpretationBox[
    StyleBox[
     TemplateBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], 
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           SubscriptBox["\[PartialD]", "\[Sigma]"], 
           InterpretationBox[
            StyleBox[
             SubsuperscriptBox["h", 
              TemplateBox[{"\[Mu]", "\[Rho]"}, "RowDefault"], 
              TemplateBox[{
                StyleBox["1", ShowContents -> False, StripOnInput -> False], 
                StyleBox["1", ShowContents -> False, StripOnInput -> False]}, 
               "RowDefault"]], AutoSpacing -> False, ShowAutoStyles -> False], 
            
            Apply[$CellContext`h, {$CellContext`l\[Mu], \
$CellContext`l\[Rho]}], Editable -> False]}, "RowDefault"], AutoSpacing -> 
         False, ShowAutoStyles -> False], 
        mGRG`STensor`BD[$CellContext`l\[Sigma], 
         $CellContext`h[$CellContext`l\[Mu], $CellContext`l\[Rho]]], Editable -> 
        False]},
      "RowDefault"],
     ShowAutoStyles->False,
     AutoSpacing->False],
    mGRG`STensor`BD[$CellContext`l\[Nu], 
     mGRG`STensor`BD[$CellContext`l\[Sigma], 
      $CellContext`h[$CellContext`l\[Mu], $CellContext`l\[Rho]]]],
    Editable->False]}]}]], "Output",
 CellChangeTimes->{{3.758787251601729*^9, 3.758787293296114*^9}, 
   3.820458494855444*^9, 3.827122439424734*^9, 3.9161249258004646`*^9, 
   3.951219668985464*^9, 3.972473601886405*^9, 3.980589736507401*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"a829178f-a45c-49b5-893f-5a2993cb75f2"]
}, Open  ]],

Cell[TextData[{
 "The vacuum Einstein equation implies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SubscriptBox["R", "\[Mu]\[Nu]\[Rho]\[Sigma]"]}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"8050ae34-e9fe-4b45-9453-f050ceaf76f4"],
 " which obeys the wave equation. This means that, in the linealized theory, \
gravitational effects propagate with the light velocity."
}], "Text",
 CellChangeTimes->{{3.510104126546875*^9, 3.510104128125*^9}, {
  3.520636226478883*^9, 
  3.520636231258583*^9}},ExpressionUUID->"7a85038e-1948-4c9b-83e5-\
e7ab3ee9dff1"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Newtonian gravitation", "Section",
 CellChangeTimes->{{3.520206541912752*^9, 3.5202065497909746`*^9}, {
  3.520206626879593*^9, 
  3.520206631542324*^9}},ExpressionUUID->"b7135675-eed1-43a0-9f72-\
8a2d07e04630"],

Cell[CellGroupData[{

Cell["Newtonian limit", "Subsection",
 CellChangeTimes->{{3.520206541912752*^9, 
  3.5202065497909746`*^9}},ExpressionUUID->"5cd82d29-89f3-438f-b39a-\
3be6e0fa36ec"],

Cell[TextData[{
 "In the Newtonian limit the components of the stress-energy tensor typically \
obey the inequalities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     SubscriptBox["T", "00"], "|"}], ">>", " ", 
    RowBox[{"|", 
     SubscriptBox["T", 
      RowBox[{"0", "i"}]], "|"}], ">>", 
    RowBox[{"|", 
     SubscriptBox["T", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "|"}]}], TraditionalForm]],
  ExpressionUUID->"24e738e3-9d72-4945-bb20-193cefc6f62a"],
 ". The linealized Einstein equation then implies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     SubscriptBox["\[Psi]", "00"], "|"}], ">>", " ", 
    RowBox[{"|", 
     SubscriptBox["\[Psi]", 
      RowBox[{"0", "i"}]], "|"}], ">>", 
    RowBox[{"|", 
     SubscriptBox["\[Psi]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "|"}]}], TraditionalForm]],
  ExpressionUUID->"e403061b-2729-4056-a3f9-299eeac559ce"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "00"], "=", 
    RowBox[{
     RowBox[{"\[Epsilon]", " ", "\[Rho]"}], " ", "+", " ", 
     RowBox[{"O", "[", 
      SuperscriptBox["\[Epsilon]", "2"], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"1ea311b8-8571-49b8-b342-4433d7d10938"],
 " the linealized Einstein equation becomes"
}], "Text",
 CellChangeTimes->{{3.520216692277572*^9, 3.5202168136121397`*^9}, {
  3.520216868129268*^9, 3.52021691180248*^9}, {3.520216950927446*^9, 
  3.520216999923479*^9}, {3.520217055050323*^9, 
  3.520217105997856*^9}},ExpressionUUID->"9a0ef729-d92f-4e9f-a9f6-\
7b10d66cc755"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell[TextData[Cell[BoxData[
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox["\[Del]", "\[RightVector]"], "2"], 
      SubscriptBox["\[Psi]", "00"]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2"}], "\[Kappa]", " ", "\[Rho]"}]}]],
    CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, 
      3.9161250434922295`*^9},
    TextAlignment->Center,
    TextJustification->0,ExpressionUUID->
    "2b0d9c4b-ffc2-1b45-a21a-cfaf5fbe0144"]],ExpressionUUID->
    "7f65276a-f631-4042-9700-1a543e4e825b"], "."}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
  3.9161250434922295`*^9, 3.916125053860449*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"e0e63e78-f0d0-40a9-83bd-7bf7d0dcf0a1"],

Cell[TextData[{
 "Comparing this with the Newtonian equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox["\[Del]", "\[RightVector]"], "2"], "\[Phi]"}], "=", 
    RowBox[{"4", "\[Pi]", " ", "G", " ", "\[Rho]"}]}], TraditionalForm]],
  ExpressionUUID->"f8d2b52d-6111-488d-8ba8-0fa783dec4c3"],
 " we find ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "00"], "=", 
    RowBox[{
     RowBox[{"-", "4"}], " ", "\[Phi]"}]}], TraditionalForm]],ExpressionUUID->
  "27bfa7df-a484-4ddf-a9f2-dcb5264a1281"],
 ". Or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "00"], "=", 
    RowBox[{
     SubscriptBox["h", "xx"], "=", 
     RowBox[{
      SubscriptBox["h", "yy"], "=", 
      RowBox[{
       SubscriptBox["h", "zz"], "=", 
       RowBox[{
        RowBox[{"-", "2"}], "\[Phi]"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"701d6803-b439-427a-b885-e3ee4d7e40ff"],
 ":"
}], "Text",
 CellChangeTimes->{{3.520217257660977*^9, 3.520217317503269*^9}, {
   3.52021766098108*^9, 3.520217674027386*^9}, {3.520217745857993*^9, 
   3.520217754964538*^9}, 3.520217788224925*^9, {3.520217864586754*^9, 
   3.520217881040152*^9}, {3.5202180156305327`*^9, 
   3.520218034866455*^9}},ExpressionUUID->"442cffac-4934-4c6c-819b-\
54f1519c4f4c"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell[TextData[Cell[BoxData[
    RowBox[{
     SuperscriptBox["ds", "2"], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", "\[Phi]"}]}], ")"}]}], 
       SuperscriptBox["dt", "2"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "\[Phi]"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["dx", "2"], "+", 
         SuperscriptBox["dy", "2"], "+", 
         SuperscriptBox["dz", "2"]}], ")"}]}]}]}]],
    CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
      3.5202180712183657`*^9, 3.520218100914279*^9}, 3.916125061827503*^9},
    TextAlignment->Center,
    TextJustification->0,ExpressionUUID->
    "830c9937-c100-a349-b4d0-3f91400dd346"]],ExpressionUUID->
    "80dbd193-0db6-d94a-9d2d-50192f60110c"], "."}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
  3.5202180712183657`*^9, 3.520218100914279*^9}, {3.916125061827503*^9, 
  3.916125070556282*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"82cb5075-e833-4467-9fe9-56e312de5e6e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Far field of stationary sources", "Subsection",
 CellChangeTimes->{{3.520206541912752*^9, 3.5202065497909746`*^9}, {
  3.520218249264925*^9, 
  3.520218272759413*^9}},ExpressionUUID->"4b3ed132-d7ea-4055-a0a8-\
c6d32abdcd40"],

Cell[TextData[{
 "At large distances from stationary sources the linealized Einstein equation \
reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox["\[Del]", "\[RightVector]"], "2"], "\[Psi]"}], "=", "0"}],
    TraditionalForm]],ExpressionUUID->"b9571531-1969-48f1-9ddb-8fcc010d2241"],
 ", which has the solution"
}], "Text",
 CellChangeTimes->{{3.520218298681344*^9, 3.520218334006854*^9}, {
  3.520218374176321*^9, 3.520218458370832*^9}, {3.5202184948661547`*^9, 
  3.520218532125881*^9}, {3.5202186628208847`*^9, 
  3.520218663924771*^9}},ExpressionUUID->"3da95883-a542-41a5-8764-\
5fd2547355c9"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{
      SubscriptBox["\[Psi]", "\[Mu]\[Nu]"], "=", 
      RowBox[{
       FractionBox[
        SubscriptBox["A", "\[Mu]\[Nu]"], "r"], "+", 
       RowBox[{"O", "[", 
        FractionBox["1", 
         SuperscriptBox["r", "2"]], "]"}]}]}], TraditionalForm]],
    CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
      3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520218597000296*^9, 
      3.520218629870246*^9}, {3.520636252677535*^9, 3.520636261533551*^9}, 
      3.916125085884323*^9},
    TextAlignment->Center,
    TextJustification->0,ExpressionUUID->
    "d6873980-c2fb-534b-9c60-8ac942d273d7"]],ExpressionUUID->
    "11a1d29b-c9a3-4447-bcf5-dc321ea18134"], ","}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
  3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520218597000296*^9, 
  3.520218629870246*^9}, {3.520636252677535*^9, 3.520636261533551*^9}, {
  3.916125085884323*^9, 3.916125094532076*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"8c72668f-54bc-4210-94b2-5cabc059c849"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "9be56ac8-edd4-471f-971e-12c835a8312d"],
 " is constant. In addition, the gauge condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "a"], 
     SubscriptBox["\[Psi]", "\[Mu]\[Nu]"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"cdd3f2cb-0c86-4463-9d67-c8422d643635"],
 " gives"
}], "Text",
 CellChangeTimes->{{3.520218635068802*^9, 3.5202186980345488`*^9}, {
  3.52021874821613*^9, 3.520218761627733*^9}, {3.5206362672143517`*^9, 
  3.520636276364613*^9}},ExpressionUUID->"d17a13a5-8387-4a0e-b7f6-\
fa5c2e2405f5"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{"0", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "j"], 
        SubscriptBox["\[Psi]", 
         RowBox[{"j", "\[InvisibleSpace]", "\[Mu]"}]]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["A", 
           RowBox[{"j", "\[InvisibleSpace]", "\[Mu]"}]]}], 
         FractionBox[
          SubscriptBox["x", "j"], 
          SuperscriptBox["r", "3"]]}], "+", 
        RowBox[{"O", "[", 
         FractionBox["1", 
          SuperscriptBox["r", "3"]], "]"}]}]}]}], TraditionalForm]],
    CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
      3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520218597000296*^9, 
      3.520218629870246*^9}, {3.520218770150749*^9, 3.520218881660256*^9}, 
      3.520218955035928*^9, {3.520636281061458*^9, 3.520636286546171*^9}, 
      3.9161251006520233`*^9},
    TextAlignment->Center,
    TextJustification->0,ExpressionUUID->
    "73602b09-c965-fe40-a430-9b0794d35bab"]],ExpressionUUID->
    "7031e6f7-e120-1941-8db2-9fb6a63e8aea"], ","}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
   3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520218597000296*^9, 
   3.520218629870246*^9}, {3.520218770150749*^9, 3.520218881660256*^9}, 
   3.520218955035928*^9, {3.520636281061458*^9, 3.520636286546171*^9}, {
   3.9161251006520233`*^9, 3.9161251076739864`*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"7dadfc7b-ea89-4eeb-9bac-5155460415de"],

Cell[TextData[{
 "which simply tells that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"j", "\[InvisibleSpace]", "\[Mu]"}]], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"0e470e7e-3251-407f-9e9c-27871ca9229e"],
 ". In other words, only ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "00"], TraditionalForm]],ExpressionUUID->
  "8a3dcb05-c9e2-4ec9-a158-44bdb60bc066"],
 " survives far from the sources:"
}], "Text",
 CellChangeTimes->{{3.520218960482139*^9, 3.5202190671531897`*^9}, {
  3.5202191155973268`*^9, 3.520219115904724*^9}, {3.5206362909830847`*^9, 
  3.520636291823667*^9}},ExpressionUUID->"e5a6f198-cdb2-40fa-9428-\
e9fd1f722240"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell[TextData[Cell[BoxData[
    RowBox[{
     SuperscriptBox["ds", "2"], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "M"}], "r"], "+", 
          RowBox[{"O", "[", 
           FractionBox["1", 
            SuperscriptBox["r", "2"]], "]"}]}], ")"}]}], 
       SuperscriptBox["dt", "2"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"2", "M"}], "r"], "+", 
         RowBox[{"O", "[", 
          FractionBox["1", 
           SuperscriptBox["r", "2"]], "]"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["dx", "2"], "+", 
         SuperscriptBox["dy", "2"], "+", 
         SuperscriptBox["dz", "2"]}], ")"}]}]}]}]],
    CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
      3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520219137154715*^9, 
      3.520219179835531*^9}, 3.9161251124039288`*^9},
    TextAlignment->Center,
    TextJustification->0,ExpressionUUID->
    "cd880e5d-c6be-0c46-af93-ed89c2c9efe2"]],ExpressionUUID->
    "6a548c9f-46b0-d348-97ec-36142c81d0ca"], "."}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.52021721794569*^9, 3.520217250593157*^9}, {
  3.5202180712183657`*^9, 3.520218100914279*^9}, {3.520219137154715*^9, 
  3.520219179835531*^9}, {3.9161251124039288`*^9, 3.91612511865938*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"09628220-00cd-46f9-a8ba-fe07e823deab"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linearized plane gravitational waves", "Section",ExpressionUUID->"a0451e9c-1620-4e52-b286-b585b65736ff"],

Cell[TextData[{
 "We choose coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}], TraditionalForm]],
  ExpressionUUID->"a79bd38d-0dbe-4f59-844f-7281a7307bef"],
 " and assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]], "(", 
     RowBox[{"t", ",", "x"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b59097c7-9360-4f56-bd16-7cf795b02d7e"]
}], "Text",
 CellChangeTimes->{{3.8271224937870274`*^9, 
  3.827122502251662*^9}},ExpressionUUID->"ae367d77-9bc4-481e-b2bf-\
1ceffd7302a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assumeRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"BD", "[", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "expr_"}], "]"}], ",", "0"}], "]"}], ",", 
     RowBox[{"RuleUnique", "[", 
      RowBox[{
       RowBox[{"BD", "[", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "expr_"}], "]"}], ",", "0"}], "]"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.5191033667267866`*^9, 3.5191036038693504`*^9, {3.520636300221911*^9, 
   3.520636311405858*^9}, {3.5857771059153438`*^9, 3.585777113500777*^9}, {
   3.758787463742863*^9, 3.758787478267694*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"ceffa710-f5a7-4a23-a88e-e090662ed5da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"riemannComp", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"riemann", ",", 
     RowBox[{"{", 
      RowBox[{"l\[Mu]", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l\[Nu]", ",", 
       RowBox[{"-", "1"}], ",", 
