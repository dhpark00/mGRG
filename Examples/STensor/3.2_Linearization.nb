Cell[TextData[{
 "Therefore, if we choose the Einstein gauge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SuperscriptBox["\[Psi]", 
      RowBox[{"\[Mu]\[Nu]", "\[InvisibleSpace]"}]]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Mu]"], 
       SuperscriptBox["h", "\[Mu]\[Nu]"]}], " ", "-", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        SuperscriptBox["\[PartialD]", "\[Nu]"], "h"}]}]}], "=", " ", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"54312918-227c-c34f-b469-e2a9c8359816"],
 ", the Einstein equation reduces to"
}], "Text",
 CellChangeTimes->{{3.520636052252697*^9, 
  3.5206360738041983`*^9}},ExpressionUUID->"effe8b98-9609-4a31-b9eb-\
781d189fd43f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "\[Mu]\[Nu]"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[Epsilon]", "2"]}], 
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      SubscriptBox["\[Psi]", "\[Mu]\[Nu]"]}]}], " ", "=", " ", 
    RowBox[{"8", "\[Pi]", " ", "G", " ", 
     SubscriptBox["T", "\[Mu]\[Nu]"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.520636078383532*^9, 3.520636096095242*^9}, {
  3.8271221519229593`*^9, 3.827122157051136*^9}},
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"5d50ebb9-f6f6-4bb6-a24b-41308da1e0cb"],

Cell[TextData[{
 "The gauge is not completely fixed because we can always carry out \
additional transformations with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["\[Xi]", "\[Mu]"]}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"4d5a4c9d-48fc-4637-8429-10ef84cfca5e"],
 ", which leaves the Einstein gauge unaltered."
}], "Text",
 CellChangeTimes->{{3.520636172522276*^9, 
  3.52063617330945*^9}},ExpressionUUID->"41a991c8-b786-44ac-a5d6-\
e9dc7cd32a12"],

Cell[TextData[{
 "Calculating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Eta]", "\[Mu]\[Nu]"], 
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SubscriptBox["\[Psi]", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"85fc09aa-9aad-4357-a323-e416f9a17a3f"],
 " we see that  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "\[Minus]", 
      RowBox[{"dimension", "/", "2"}]}], ")"}], 
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "h"}]}], TraditionalForm]],
  ExpressionUUID->"0c264260-fa00-400e-88d2-2fc117c465f4"],
 "."
}], "Text",
 CellChangeTimes->{{3.827122240016567*^9, 
  3.827122303619045*^9}},ExpressionUUID->"99d88d65-7d34-4134-8c8b-\
960c8d30a8fc"],

