Cell[TextData[{
 "from which we find ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SuperscriptBox[
      RowBox[{"\[Psi]", "'"}], 
      RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], 
      SuperscriptBox["\[Psi]", 
       RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]]}], " ", "-", " ", 
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      SuperscriptBox["\[Xi]", "\[Nu]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"c18c8d18-cea1-4a85-a290-a4f5340de659"],
 ". The gauge transformation therefore leads to the Einstein gauge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SuperscriptBox[
      RowBox[{"\[Psi]", "'"}], 
      RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]]}], " ", "=", " ", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "b0331c1f-5609-467b-a1c4-d37b0b5856fa"],
 " if we choose ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "a1904cbc-46bd-4e4b-8c1e-504764513955"],
 " to satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     SuperscriptBox["\[Xi]", "\[Nu]"]}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], 
     SuperscriptBox["\[Psi]", 
      RowBox[{"\[Mu]", "\[InvisibleSpace]", "\[Nu]"}]]}]}], TraditionalForm]],
  ExpressionUUID->"f298810c-73e7-41d1-86a8-419c713d02f8"],
 "."
}], "Text",
 CellChangeTimes->{{3.519103110050105*^9, 3.5191031600729666`*^9}, {
  3.827122033820505*^9, 
  3.827122086314784*^9}},ExpressionUUID->"9e5df911-f857-4cd7-8156-\
795460ac18a2"],

