   3.9512120806021423`*^9},ExpressionUUID->"9b0d196e-484a-4322-b1a0-\
2cbeb6d897d8"],

Cell[TextData[{
 "The transformation is to a frame moving at constant velocity ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "f7021cca-6134-b544-81dd-1e561645cc49"],
 " along the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f6f2d015-b18d-41a2-b1d9-310c1f43ebba"],
 " direction of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}], TraditionalForm]],
  ExpressionUUID->"22eae978-211a-c241-b91b-4eae41993841"],
 " reference frame. "
}], "Text",
 CellChangeTimes->{{3.9170853921222496`*^9, 3.91708541928253*^9}, {
  3.97246913129422*^9, 
  3.9724691602231894`*^9}},ExpressionUUID->"5776dc3b-2b38-bf4a-b560-\
b210cbc45dd4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"leftCoSys", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], ";", " ", 
  RowBox[{"rightCoSys", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Gamma]", 
      RowBox[{"(", 
       RowBox[{"x", " ", "-", " ", 
        RowBox[{"v", " ", "t"}]}], ")"}]}], ",", "y", ",", "z", ",", 
     RowBox[{"\[Gamma]", 
      RowBox[{"(", 
       RowBox[{"t", " ", "-", " ", 
        RowBox[{"v", " ", "x"}]}], ")"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SequenceForm", "[", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "leftCoSys", "]"}], ",", " ", "\"\<\[Rule]\>\"",
    ",", 
   RowBox[{"MatrixForm", "[", "rightCoSys", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.520117523616504*^9, 3.520117524693498*^9}, {
  3.917085447530081*^9, 3.917085480402586*^9}, {3.917085724904621*^9, 
  3.9170857433920536`*^9}, {3.917085895399704*^9, 3.917085908447708*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"1a59088d-6ce0-444f-b07f-699ba37b6482"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", 
     TagBox[GridBox[{
        {"x"},
        {"y"},
        {"z"},
        {"t"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.5599999999999999]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      Column], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], "\[InvisibleSpace]", "\<\"\[Rule]\"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", 
     TagBox[GridBox[{
        {
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "t"}], " ", "v"}], "+", "x"}], ")"}], " ", 
          "\[Gamma]"}]},
        {"y"},
        {"z"},
        {
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", 
            RowBox[{"v", " ", "x"}]}], ")"}], " ", "\[Gamma]"}]}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.5599999999999999]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      Column], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}],
  SequenceForm[
   MatrixForm[{$CellContext`x, $CellContext`y, $CellContext`z, \
$CellContext`t}], "\[Rule]", 
   MatrixForm[{(-$CellContext`t $CellContext`v + $CellContext`x) \
$CellContext`\[Gamma], $CellContext`y, $CellContext`z, ($CellContext`t - \
$CellContext`v $CellContext`x) $CellContext`\[Gamma]}]],
  Editable->False]], "Output",
 CellChangeTimes->{{3.917085468251175*^9, 3.9170854821485176`*^9}, 
