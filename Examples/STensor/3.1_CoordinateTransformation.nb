Cell[CellGroupData[{

Cell["Lorentz Boost: MathTensor, section 4.2.5, Example Three", "Subsection",
 CellChangeTimes->{{3.520117580725297*^9, 3.520117587971737*^9}, {
   3.916120421285116*^9, 3.9161204226509132`*^9}, {3.917046874385639*^9, 
