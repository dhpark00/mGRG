5044332ba64a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]", "'"}], 
     RowBox[{"(", 
      RowBox[{"f", "'"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Phi]", "*"], "\[Xi]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"f", "'"}], ")"}]}], " ", "\[Congruent]", " ", 
      RowBox[{"\[Xi]", "(", 
       RowBox[{
        SuperscriptBox["\[Phi]", "*"], 
        RowBox[{"f", "'"}]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"\[Xi]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "'"}], " ", "\[CenterDot]", " ", "\[Phi]"}], ")"}]}], 
      " ", "=", " ", 
      RowBox[{"\[Xi]", 
       RowBox[{"(", "f", ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "863c3dfb-0e7f-9e44-904e-0f629f3fcbb2"],
 "."
}], "Text",
 CellChangeTimes->{{3.9167431096720085`*^9, 3.9167432299514713`*^9}, {
