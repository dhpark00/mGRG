  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["M", "i"], 
     RowBox[{" ", 
      RowBox[{"k", "'"}]}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["y", 
       RowBox[{"k", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "i"]}]]}], TraditionalForm]],ExpressionUUID->
  "834e1b20-4f68-7344-a784-4ada84520c1a"],
 ". Similarly, a second rank tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], TraditionalForm]],
  ExpressionUUID->"15bbccce-cf47-8842-9b5d-d971d6fda34c"],
