Cell[TextData[{
 "By selecting coordinate systems ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SuperscriptBox["x", "i"], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1cdbc67a-9f4c-ba46-80c3-7ef471177394"],
 " about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", " ", "\[Element]", " ", "N"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fc2402b-5e2b-b242-9449-146d96790e22"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SuperscriptBox["y", 
     RowBox[{"j", "'"}]], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfaf6654-afa6-f143-ac30-b4d7fb88c92b"],
 " about ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "'"}], "\[Element]", " ", 
    RowBox[{"N", "'"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8eecdbe-1194-7b4c-945e-d4822944786b"],
 ", we have"
}], "Text",
 CellChangeTimes->{{3.916747432925535*^9, 3.9167475466125813`*^9}, {
  3.916827971930691*^9, 
  3.9168279741389256`*^9}},ExpressionUUID->"0dd4f58c-94f0-034e-aea2-\
7f5273f8c92f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "*"], 
     SubscriptBox["\[PartialD]", "i"]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox["y", 
        RowBox[{"j", "'"}]]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "i"]}]], 
     SubscriptBox["\[PartialD]", 
      RowBox[{"j", "'"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd13cd1f-cd44-d94e-afbb-7f5c46d1c1ab"],
 "."
}], "Text",
