 TextAlignment->Center,ExpressionUUID->"70dfd314-3315-5445-9009-16e543ead9aa"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],ExpressionUUID->
  "62e7d89b-60d5-2b44-a83c-749472611fa7"],
 " is a diffeomorphism between ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "55d03210-7953-b44b-b3e5-876dec72792e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "'"}], TraditionalForm]],ExpressionUUID->
  "6d196c7f-734c-5a48-87bd-9745cbff223a"],
 ", then the mapping ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "*"], ":", " ", 
     SubscriptBox[
      SuperscriptBox["T", "a"], "b"]}], "->", 
    SubscriptBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"T", "'"}], ")"}], "a"], "b"]}], TraditionalForm]],
  ExpressionUUID->"8528185a-e2e2-2946-8e59-6cdcd01bfb3c"],
 " is defined as"
}], "Text",
 CellChangeTimes->{{3.916747904274111*^9, 3.9167480347357397`*^9}, {
  3.9167482029110584`*^9, 3.9167482504733253`*^9}, {3.916748335336487*^9, 
  3.916748366832121*^9}, {3.916748507244589*^9, 3.916748514332323*^9}, {
  3.9168298594331045`*^9, 
  3.916829864586082*^9}},ExpressionUUID->"8818d99f-607c-f24d-a300-\
acb171e234d2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"T", "'"}], ")"}], "a"], "b"], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "'"}], ")"}], "a"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Xi]", "'"}], ")"}], "b"]}], "\[Congruent]", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "'"}], ")"}], "a"], 
        RowBox[{
         SubscriptBox["\[Phi]", "*"], "(", 
         SuperscriptBox[
          RowBox[{
           SubscriptBox[
            SuperscriptBox["T", "a"], "b"], "(", 
           RowBox[{
            SubsuperscriptBox["\[Phi]", "*", 
             RowBox[{"-", "1"}]], 
            RowBox[{"\[Xi]", "'"}]}], ")"}], "b"], ")"}]}]}], "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"\[Omega]", "'"}]}], ")"}], "a"], 
       SuperscriptBox[
        RowBox[{
         SubscriptBox[
          SuperscriptBox["T", "a"], "b"], "(", 
         RowBox[{
          SubsuperscriptBox["\[Phi]", "*", 
           RowBox[{"-", "1"}]], 
          RowBox[{"\[Xi]", "'"}]}], ")"}], "b"]}]}], ")"}], "=", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["T", "a"], "b"], 
     SubscriptBox["\[Omega]", "a"], 
     SuperscriptBox["\[Xi]", "b"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c3f6cd4-43df-b84a-9b2a-a585f183c5bf"],
 "."
}], "Text",
 CellChangeTimes->{{3.916748040640768*^9, 3.91674804754475*^9}, {
