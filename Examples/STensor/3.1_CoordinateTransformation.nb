Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "4bea81eb-8cca-a642-90b6-648cf372182a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "'"}], TraditionalForm]],ExpressionUUID->
  "c852214c-d401-0a4f-9b7d-242054e7d443"],
 " be manifolds and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", ":", " ", "N"}], " ", "\[Rule]", " ", 
    RowBox[{"N", "'"}]}], TraditionalForm]],ExpressionUUID->
  "da0cda95-960d-e946-9688-24def8bb3b18"],
 " be a smooth map. In a natural manner, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "*"], TraditionalForm]],ExpressionUUID->
  "1687b7db-0e51-d14f-aae9-d1c9e62d9cb5"],
 " ",
 StyleBox["pulls back",
  FontWeight->"Bold"],
 " a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], ":", " ", 
     RowBox[{"N", "'"}]}], " ", "\[Rule]", " ", "R"}], TraditionalForm]],
  ExpressionUUID->"12fb5fb0-540c-6e46-9beb-6d761b1bc89a"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "'"}], TraditionalForm]],ExpressionUUID->
  "6bab3b84-3313-0b4f-8ad7-3750fcad8765"],
 " to the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", " ", "N"}], " ", "\[Rule]", " ", "R"}], 
   TraditionalForm]],ExpressionUUID->"9892cb0d-29ba-3842-b318-543532747ca7"],
 " on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "071c92fc-e88c-1448-a4f0-bfb4ae91f1d2"],
 " by"
}], "Text",
 CellChangeTimes->{
  3.916652097651432*^9, {3.916741626422039*^9, 3.916741746197666*^9}, {
   3.916741904786108*^9, 3.916742001785425*^9}, {3.916742042304964*^9, 
