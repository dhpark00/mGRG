Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "a"], 
     SuperscriptBox["\[Xi]", "a"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"\[Omega]", "'"}]}], ")"}], "a"], 
       SuperscriptBox["\[Xi]", "a"]}], " ", "\[Congruent]", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Omega]", "'"}], ")"}], "a"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Phi]", "*"], "\[Xi]"}], ")"}], "a"]}]}], "=", " ", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "'"}], ")"}], "a"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Xi]", "'"}], ")"}], "a"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b0b973a-a78c-104b-8b7a-1b63fdeeed7f"],
 "."
}], "Text",
 CellChangeTimes->{{3.9167433547264137`*^9, 3.9167434900316544`*^9}, {
