Cell[CellGroupData[{

Cell["Simple Shear: MathTensor, section 4.2.4, Example Two", "Subsection",
 CellChangeTimes->{{3.9170468501946125`*^9, 3.9170468589527607`*^9}, 
   3.951212091680113*^9},ExpressionUUID->"9157a0be-078c-af43-9e1e-\
9a62dfcd6ac5"],

Cell[TextData[{
 "A rectangular solid is deformed by shearing it in the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "ce204c8e-e56c-324e-a4f2-b6d290aaca59"],
 "-direction by an amount \nproportional to the height ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "4a70a4ac-a9a0-4c4e-b9c2-a9b5c45cb0b5"],
 ". Relative to a given external rectangular coordinate \nsystem, the \
physical point originally having coordinate values ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ",", "y", ",", "z"}], TraditionalForm]],ExpressionUUID->
  "a57b4716-1b6e-5948-9677-ce62a647b224"],
 " moves to the \nnew coordinate values ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], " ", "=", " ", 
     RowBox[{"x", " ", "+", " ", "Ky"}]}], ",", " ", 
    RowBox[{
     RowBox[{"y", "'"}], " ", "=", " ", "y"}], ",", 
    RowBox[{
     RowBox[{"z", "'"}], " ", "=", " ", "z"}]}], TraditionalForm]],
  ExpressionUUID->"c3e8aeb9-b244-694f-b87a-4d3d14479533"],
 ". Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "'"}], ",", " ", 
     RowBox[{"y", "'"}], ",", " ", 
     RowBox[{"z", "'"}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "0878bc87-bc92-374a-933c-ee6f5ed954c0"],
 " are the coordinates \nof the physical point relative to external \
rectangular coordinates, while ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}], TraditionalForm]],
  ExpressionUUID->"c800033c-785b-2048-be0b-d1e00f862a67"],
 " are \nthe (fixed) coordinates of the physical point relative to the \
deformed oblique axes."
}], "Text",
 CellChangeTimes->{{3.9170474071827393`*^9, 3.9170474440587444`*^9}, {
  3.917047485438368*^9, 
  3.9170475378193893`*^9}},ExpressionUUID->"0d779921-e919-f04d-946e-\
f82ca64c667e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"leftCoSys", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", " ", 
  RowBox[{"rightCoSys", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"K", " ", "y"}]}], ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SequenceForm", "[", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "leftCoSys", "]"}], ",", " ", "\"\<\[Rule]\>\"",
    ",", 
   RowBox[{"MatrixForm", "[", "rightCoSys", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.774267717950775*^9, 3.774267727020828*^9}, {
  3.915604785876753*^9, 3.915604786269039*^9}},
 CellLabel->
  "In[129]:=",ExpressionUUID->"ebd4c34f-c00a-1942-8b12-87c273aabaf4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", 
     TagBox[GridBox[{
        {"x"},
        {"y"},
        {"z"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.5599999999999999]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      Column], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], "\[InvisibleSpace]", "\<\"\[Rule]\"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", 
     TagBox[GridBox[{
        {
         RowBox[{"x", "+", 
          RowBox[{"K", " ", "y"}]}]},
        {"y"},
        {"z"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.5599999999999999]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      Column], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}],
  SequenceForm[
   MatrixForm[{$CellContext`x, $CellContext`y, $CellContext`z}], "\[Rule]", 
   MatrixForm[{$CellContext`x + 
     K $CellContext`y, $CellContext`y, $CellContext`z}]],
  Editable->False]], "Output",
 CellChangeTimes->{3.915604786901575*^9, 3.91704789264069*^9, 
  3.951212099908758*^9, 3.9723872617054253`*^9, 3.9724690818420267`*^9, 
  3.980418181919783*^9},
