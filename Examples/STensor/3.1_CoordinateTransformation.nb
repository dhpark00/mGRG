 TextAlignment->Center,ExpressionUUID->"b46abe07-4a32-de4d-8015-89b47cce02a6"],

Cell[TextData[{
 "Let fromCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "675bfc4f-1e1a-d044-a671-98a904ea5bbd"],
 "} and toCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"k", "'"}]], TraditionalForm]],ExpressionUUID->
  "d860f58c-1c37-c04b-8f11-0809212a3714"],
 "}. Then a one-form ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Omega]", "'"}], ")"}], "a"], TraditionalForm]],ExpressionUUID->
  "47e08974-7a0e-4645-89af-2bfa39daeed1"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "'"}], TraditionalForm]],ExpressionUUID->
  "469c8831-93ee-6f42-bcd8-2759a7c67c4a"],
 " transforms as"
}], "Text",
 CellChangeTimes->{{3.916745004735964*^9, 3.916745108839754*^9}, {
  3.9167453456139374`*^9, 3.916745346109604*^9}, {3.9167454711251698`*^9, 
  3.91674552593318*^9}, {3.9167458153952217`*^9, 3.9167458189403896`*^9}, {
  3.916830182311302*^9, 
  3.916830183743353*^9}},ExpressionUUID->"f157950d-bdb1-7241-b163-\
7702e061a982"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[Omega]", "i"], "\[InvisibleSpace]"], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["M", "i"], 
      RowBox[{"k", "'"}]], 
     SubscriptBox[
      RowBox[{"\[Omega]", "'"}], 
      RowBox[{"k", "'"}]]}]}], TraditionalForm]],ExpressionUUID->
  "a351b034-5089-7f47-b52d-f9abee01a45c"],
 "     or     ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    RowBox[{"M", "\[InvisibleSpace]", 
     RowBox[{"\[Omega]", "'"}]}]}], TraditionalForm]],ExpressionUUID->
  "ed1dd0aa-0660-9c4f-9b62-8c6c302763d7"],
 ","
}], "Text",
 CellChangeTimes->{{3.9167455684466114`*^9, 3.9167456283898373`*^9}, {
  3.9167458762284184`*^9, 3.9167459017317123`*^9}, {3.91683019621529*^9, 
  3.916830201774935*^9}},
 TextAlignment->Center,ExpressionUUID->"fab25bb3-822c-0b46-ba1c-91c11172daa9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["M", "i"], 
     RowBox[{" ", 
      RowBox[{"k", "'"}]}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["y", 
       RowBox[{"k", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "i"]}]]}], TraditionalForm]],ExpressionUUID->
  "9306ecc0-28f8-4149-b3bb-12564547cf59"],
 ". Similarly, a second rank tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"T", "'"}], ")"}], 
    RowBox[{
     RowBox[{"k", "'"}], 
     RowBox[{"l", "'"}]}]], TraditionalForm]],ExpressionUUID->
  "d03bbac0-a27f-b84d-96db-5fa23adce9a1"],
 " on ",
 Cell[BoxData[
  FormBox[
