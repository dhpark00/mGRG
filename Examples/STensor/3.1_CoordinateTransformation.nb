Cell[BoxData[
 FormBox[
  RowBox[{"f", " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Phi]", "*"], 
     RowBox[{"f", "'"}]}], " ", "\[Congruent]", " ", 
    RowBox[{
     RowBox[{"f", "'"}], " ", "\[CenterDot]", " ", 
     RowBox[{"\[Phi]", "."}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.916742440655855*^9, 3.916742482654358*^9}, {
  3.916827232743267*^9, 3.916827236006481*^9}},
 TextAlignment->Center,ExpressionUUID->"0b6ac12a-d4dd-9f46-b74c-e9c50921c085"],

Cell[TextData[{
 "The ",
 StyleBox["differential",
  FontWeight->"Bold"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[Element]", "N"}], TraditionalForm]],ExpressionUUID->
  "6ff75c66-494f-fe4f-98b7-e1da8265d0ed"],
 " of ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],ExpressionUUID->
  "9160d18a-c756-0345-a30c-68b824b9db85"],
 " is the linear mapping ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "*"], ":", " ", 
     RowBox[{
      SubscriptBox["T", "p"], "(", "N", ")"}]}], " ", "\[Rule]", " ", 
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"\[Phi]", "(", "p", ")"}]], "(", 
     RowBox[{"N", "'"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "fdc9fcf8-3a68-3c48-ae75-7f44f5665fa9"],
 " defined as follows. For each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", " ", "\[Element]", " ", 
    RowBox[{
     SubscriptBox["T", "p"], "(", "N", ")"}]}], TraditionalForm]],
  ExpressionUUID->"67226e5f-23ab-354b-98f1-f0f62f4cc48e"],
 ", choose a curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "f2eafdbc-8cda-f542-8786-e3f302ae18da"],
 " in ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "898e1d48-41e3-664c-80fe-d0c381328469"],
 " such that ",
 Cell[BoxData[
  FormBox["\[Xi]", TraditionalForm]],ExpressionUUID->
  "80396abe-1e69-a54f-8a96-bb74b8ffa42a"],
 " is the vector tangent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3d8ec20c-e434-d84a-851c-63c398f25e14"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"\[Gamma]", "(", 
     SubscriptBox["t", "0"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "d41f5985-2495-504b-abe3-5dafe7a788d0"],
 ". Then, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "*"], "\[Xi]"}], TraditionalForm]],ExpressionUUID->
  "2a25caa6-00e1-3c41-a77b-56cb17d3725b"],
 " which ",
 StyleBox["pushes forward",
  FontWeight->"Bold"],
 " the tangent vector ",
 Cell[BoxData[
  FormBox["\[Xi]", TraditionalForm]],ExpressionUUID->
  "c3c65736-7cb3-3840-a61b-b65a8a04b8b8"],
 " is the vector tangent to the curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", 
    RowBox[{"(", 
     RowBox[{"\[Gamma]", 
      RowBox[{"(", "t", ")"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "923fabea-7eb5-ab42-bb95-0c234da9f2ec"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", 
     RowBox[{"(", "p", ")"}]}], " ", "=", " ", 
    RowBox[{"\[Phi]", "(", 
     RowBox[{"\[Gamma]", "(", 
      SubscriptBox["t", "0"], ")"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"26000b1a-bfd2-7d4f-9ab0-9953dd56f404"],
 ", that is,"
}], "Text",
 CellChangeTimes->{{3.916742525717993*^9, 3.916742590332899*^9}, {
