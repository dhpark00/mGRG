       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"], "+", 
       SuperscriptBox["z", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "y", 
       RowBox[{
        SubsuperscriptBox["\[PartialD]", "x", "a"], 
        RowBox[{"+", "y"}]}], " ", 
       SuperscriptBox["z", "2"], 
       RowBox[{
        SubsuperscriptBox["\[PartialD]", "y", "a"], 
        RowBox[{"-", "x"}]}], " ", "y", " ", "z", 
       SubsuperscriptBox["\[PartialD]", "z", "a"]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"075bee25-857e-e84c-b4d2-c01ac6786acc"],
