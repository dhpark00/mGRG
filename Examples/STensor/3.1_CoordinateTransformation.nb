     RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["M", "i"], 
      RowBox[{"k", "'"}]], 
     SuperscriptBox[
      SubscriptBox["M", "j"], 
      RowBox[{"l", "'"}]], 
     SubscriptBox[
      RowBox[{"T", "'"}], 
      RowBox[{
       RowBox[{"k", "'"}], 
       RowBox[{"l", "'"}]}]]}]}], TraditionalForm]],ExpressionUUID->
  "3963273c-ef85-bb47-96ad-8857e20988a0"],
 "     or     ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"M", " ", 
