Cell[TextData[{
 "Similarly, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "*"], TraditionalForm]],ExpressionUUID->
  "8dab6c42-c80e-3a4f-a392-7a28af0f1b05"],
 " ",
 StyleBox["pulls back",
  FontWeight->"Bold"],
 " a one-form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "'"}], TraditionalForm]],ExpressionUUID->
  "fc06a16b-e7bd-4743-b908-d5f16d6c12bd"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "'"}], TraditionalForm]],ExpressionUUID->
  "b6e54380-7d5f-d04b-bded-d7dadc5fc2a8"],
 " to the one-form ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],ExpressionUUID->
  "b414c954-6404-c04a-a35f-58854e1a0783"],
 " in ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "44ee7506-719b-e243-a068-6b0631c524ea"],
 " such that"
}], "Text",
 CellChangeTimes->{{3.9167432721605625`*^9, 3.916743350366411*^9}, {
  3.91674376369322*^9, 3.9167437681415615`*^9}, {3.9168286416115074`*^9, 
