Cell[TextData[{
 "Let fromCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "163eff0d-988c-e947-8270-4113a8e313f4"],
 "} and toCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"k", "'"}]], TraditionalForm]],ExpressionUUID->
  "9cff1a50-a6a2-0a43-a305-8cbe33651423"],
 "} for a diffeomorphism. Then, we have"
}], "Text",
 CellChangeTimes->{{3.916745004735964*^9, 3.916745108839754*^9}, {
  3.9167453456139374`*^9, 3.916745346109604*^9}, {3.9167454711251698`*^9, 
  3.91674552593318*^9}, {3.9167458153952217`*^9, 3.9167458189403896`*^9}, {
  3.9167486662357273`*^9, 3.9167487380193844`*^9}, {3.916748865562023*^9, 
  3.9167488682494583`*^9}, {3.9168302717098217`*^9, 
  3.916830272958645*^9}},ExpressionUUID->"cfa7e53b-597d-ad42-92bb-\
6c7aff0f1ccc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["M", "i"], 
     RowBox[{"k", "'"}]], "=", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SuperscriptBox["y", 
       RowBox[{"k", "'"}]]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "i"]}]]}], TraditionalForm]],ExpressionUUID->
  "2bfce388-5380-004d-b8c0-b147430ac90a"],
 "     and     ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["N", 
      RowBox[{"k", "'"}]], "i"], "=", 
    FractionBox[
