Cell[TextData[{
 "Let fromCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "79c5e54f-e019-c845-80e9-c49199559373"],
 "} and toCoSys = {",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"k", "'"}]], TraditionalForm]],ExpressionUUID->
  "3e1b7c88-21d8-d844-ab69-e2e99e3910e4"],
 "}. Then a vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", "i"], TraditionalForm]],ExpressionUUID->
  "c9d64c4a-c818-ad48-aee3-ff58eeaf872a"],
 " on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
