Cell[BoxData[
 RowBox[{Cell[TextData[Cell[BoxData[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["g", "ab"], 
      RowBox[{
       SubscriptBox["\[Del]", "a"], 
       RowBox[{
        SubscriptBox["\[Del]", "b"], "\[Phi]"}]}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"n", "-", "1"}], 
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}]], "R", " ", "\[Phi]"}]}], "=", 
    "0"}]],
   CellChangeTimes->{{3.519085167933208*^9, 3.51908519034949*^9}, 
     3.916049682092539*^9},
   TextAlignment->Center,ExpressionUUID->
   "f979359a-f435-492f-a39f-ded8dc844ec3"]],ExpressionUUID->
   "527cc5a4-742f-49b9-9a01-662b1082a59f"], "    ", "for", " ", Cell[TextData[
  Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox["\[Phi]", "~"], "=", 
     RowBox[{
