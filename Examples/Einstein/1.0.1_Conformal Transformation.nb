    RowBox[{
     FractionBox["1", "\[CapitalOmega]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Delta]", "a", "c"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "b"], "\[CapitalOmega]"}]}], " ", "+", 
       " ", 
       RowBox[{
        SubsuperscriptBox["\[Delta]", "b", "c"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "a"], "\[CapitalOmega]"}]}], " ", "-", 
       " ", 
       RowBox[{
        SubscriptBox["g", "ab"], 
        SuperscriptBox["g", "cd"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "d"], "\[CapitalOmega]"}]}]}], 
      ")"}]}]}]}]],
