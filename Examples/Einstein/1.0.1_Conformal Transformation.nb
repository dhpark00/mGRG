Cell[TextData[{
 "Therefore, the Weyl tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["C", 
     RowBox[{"a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c"}]], "d"],
    TraditionalForm]],ExpressionUUID->"9f8adcf0-8b6d-554e-8285-b9ee6e57d1c2"],
 " is invariant under the conformal transformation."
}], "Text",
