Cell[CellGroupData[{

Cell["Weyl tensors", "Subsubsection",ExpressionUUID->"dc06e734-2a47-43e8-89f4-6a8860897841"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["C", 
   RowBox[{
   "a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c", "\[InvisibleSpace]",
     "d"}]], " ", "=", " ", 
  RowBox[{
   SubscriptBox["R", 
    RowBox[{
    "a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c", "\[InvisibleSpace]",
      "d"}]], " ", "-", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"a", "\[InvisibleSpace]", "c"}]], 
       SubscriptBox["R", 
        RowBox[{"b", "\[InvisibleSpace]", "d"}]]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"a", "\[InvisibleSpace]", "d"}]], 
       SubscriptBox["R", 
        RowBox[{"b", "\[InvisibleSpace]", "c"}]]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"b", "\[InvisibleSpace]", "c"}]], 
       SubscriptBox["R", 
        RowBox[{"a", "\[InvisibleSpace]", "d"}]]}], " ", "+", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"b", "\[InvisibleSpace]", "d"}]], 
       SubscriptBox["R", 
        RowBox[{"a", "\[InvisibleSpace]", "c"}]]}]}], ")"}]}], " ", "+", " ", 
   RowBox[{
    FractionBox["1", "6"], "R", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"a", "\[InvisibleSpace]", "c"}]], 
       SubscriptBox["\[Eta]", 
        RowBox[{"b", "\[InvisibleSpace]", "d"}]]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", 
        RowBox[{"a", "\[InvisibleSpace]", "d"}]], 
       SubscriptBox["\[Eta]", 
        RowBox[{"b", "\[InvisibleSpace]", "c"}]]}]}], 
     ")"}]}]}]}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"55cf5199-bdeb-4336-a718-cf8e241b69ee"],

