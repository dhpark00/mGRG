Cell[TextData[{
 "The ten-components of Ricci tensors are defined in terms of \
three-dimensional hermitian matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     RowBox[{"A", "\[InvisibleSpace]", "B"}]], " ", "=", " ", 
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], 
     RowBox[{"B", "\[InvisibleSpace]", "A"}]]}], TraditionalForm]],
  ExpressionUUID->"da60b95d-f6d4-4cd2-9064-7acee1728340"]
}], "Text",
 TextAlignment->Left,
 TextJustification->1,ExpressionUUID->"34e022b1-8fce-4ea5-83c3-6eb88ee5c7f2"],

