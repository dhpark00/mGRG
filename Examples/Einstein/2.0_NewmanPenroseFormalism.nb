      RowBox[{"(", 
       RowBox[{"a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c"}], 
       ")"}], "d"}]], " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "3f0834e4-5121-4e51-bcd1-1d0d0ad9314e"],
 " we find"
}], "Text",ExpressionUUID->"cf462144-264a-4b57-bf81-d7a0be5e0a68"],

