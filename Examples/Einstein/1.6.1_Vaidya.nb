Cell["From", "Text",
 CellChangeTimes->{{3.640773193730383*^9, 
  3.640773194658308*^9}},ExpressionUUID->"c8fc3f7f-c531-4729-a4e3-\
0231d469f882"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["G", "uu"], "=", 
  RowBox[{
   RowBox[{
    SubscriptBox["R", "uu"], "-", 
    RowBox[{
     FractionBox["1", "2"], "R", " ", 
     SubscriptBox["g", "uu"]}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", 
      SuperscriptBox["r", "2"]], 
     FractionBox["dm", "dv"]}], "=", 
    RowBox[{"8", "\[Pi]", " ", "G", " ", 
     SubscriptBox["T", "uu"]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.640773114822137*^9, 3.640773171731434*^9}, {
  3.640773283249566*^9, 3.640773284448138*^9}, {3.640856667777871*^9, 
  3.640856671951549*^9}},
 TextAlignment->Center,ExpressionUUID->"87213d4c-4407-47d9-a2ca-caa6347004db"],

Cell["we see that the energy-momentum tensor is", "Text",
 CellChangeTimes->{{3.640773212009825*^9, 
  3.640773227329474*^9}},ExpressionUUID->"db89b80a-7a8d-4101-9985-\
e793670ca5d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["T", "uu"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "\[Pi]", " ", "G", " ", 
      SuperscriptBox["r", "2"]}]], 
    RowBox[{"(", 
     FractionBox["dm", "dv"], ")"}]}]}], ","}]], "DisplayFormula",
 CellChangeTimes->{{3.640773114822137*^9, 3.640773171731434*^9}, {
   3.640773238196585*^9, 3.64077328991184*^9}, 3.640773323471515*^9, {
   3.640773400504444*^9, 3.640773408108337*^9}, {3.640856676513672*^9, 
   3.6408566789351807`*^9}},
 TextAlignment->Center,ExpressionUUID->"9b47288c-1b23-4e3a-9f22-c309497e9369"],

Cell[TextData[{
 "which describes a pressureless fluid with energy density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    SubscriptBox["T", "uu"]}], TraditionalForm]],ExpressionUUID->
  "ab6a45c9-13d3-4254-8e64-92bbe2593021"],
 " moving along radial, ingoing null geodesics."
}], "Text",
 CellChangeTimes->{{3.640773326254222*^9, 3.6407733725181108`*^9}, {
  3.640773413715354*^9, 3.640773428650919*^9}, {3.640773483153377*^9, 
  3.640773511312541*^9}, {3.6408566925504417`*^9, 
  3.640856694494368*^9}},ExpressionUUID->"0f494a58-3c1b-4624-a067-\
94ddef700a2f"]
}, Closed]]
}, Open  ]]
}, Open  ]]
