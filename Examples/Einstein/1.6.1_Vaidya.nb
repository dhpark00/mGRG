Cell[BoxData[
 RowBox[{
  SubscriptBox["G", "uu"], "=", 
  RowBox[{
   RowBox[{
    SubscriptBox["R", "uu"], "-", 
    RowBox[{
     FractionBox["1", "2"], "R", " ", 
     SubscriptBox["g", "uu"]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["2", 
       SuperscriptBox["r", "2"]]}], 
     FractionBox["dm", "du"]}], "=", 
    RowBox[{"8", "\[Pi]", " ", "G", " ", 
     SubscriptBox["T", "uu"]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.640773114822137*^9, 3.640773171731434*^9}, {
  3.640773283249566*^9, 3.640773284448138*^9}},
 TextAlignment->Center,ExpressionUUID->"875462fd-f686-4651-8b47-6185ce3b837b"],

Cell["we see that the energy-momentum tensor is", "Text",
 CellChangeTimes->{{3.640773212009825*^9, 
  3.640773227329474*^9}},ExpressionUUID->"14354540-ef52-4cfc-aeff-\
434111a02cae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["T", "uu"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "\[Pi]", " ", "G", " ", 
      SuperscriptBox["r", "2"]}]], 
    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox["dm", "du"]}], ")"}]}]}], ","}]], "DisplayFormula",
 CellChangeTimes->{{3.640773114822137*^9, 3.640773171731434*^9}, {
   3.640773238196585*^9, 3.64077328991184*^9}, 3.640773323471515*^9, {
   3.640773400504444*^9, 3.640773408108337*^9}},
 TextAlignment->Center,ExpressionUUID->"199b837c-b099-47b4-b565-cb87e888f587"],

Cell[TextData[{
 "which describes a pressureless fluid with energy density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    SubscriptBox["T", "uu"]}], TraditionalForm]],ExpressionUUID->
  "285aec17-321f-4d70-b7c7-09d77574aba7"],
 " moving along radial, outgoing null geodesics."
}], "Text",
 CellChangeTimes->{{3.640773326254222*^9, 3.6407733725181108`*^9}, {
  3.640773413715354*^9, 3.640773428650919*^9}, {3.640773483153377*^9, 
