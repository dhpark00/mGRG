Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"lap", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"S", "[", "]"}], "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         FractionBox["k", "4"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["t", "2"]}], " ", "+", " ", 
           SuperscriptBox["x", "2"]}], ")"}]}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.585783052153449*^9, 3.5857831186022496`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"bef6921d-c0b2-48db-b5af-5292a737c7a1"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"16", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"t", ",", "x"}], "]"}]}]], " ", "k"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      RowBox[{"k", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["t", "2"]}], "+", 
         SuperscriptBox["x", "2"]}], ")"}]}]}], ")"}], "2"]]}]], "Output",
