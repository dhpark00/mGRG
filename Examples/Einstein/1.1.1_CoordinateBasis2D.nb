Cell[TextData[{
 "which means ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "2"}], "\[Rho]"}]], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["\[Del]", "\[RightVector]"], "2"], "\[Rho]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"55255592-bc29-42a1-a27e-badfd9d8e039"],
 "."
}], "Text",
 CellChangeTimes->{{3.510112251703125*^9, 3.5101122576875*^9}, 
   3.97281641985255*^9},ExpressionUUID->"8c2d74da-2da3-4753-bca6-\
e2ff7ec13202"]
}, Closed]],

Cell[CellGroupData[{

Cell["Liouville equation", "Subsubsection",
 CellChangeTimes->{
  3.972816497069256*^9},ExpressionUUID->"89429df0-360f-496f-8050-\
83d039c9a2e7"],

Cell["For a symmetric space the curvature is given by", "Text",ExpressionUUID->"bd4e6add-9bda-4f7f-9ad5-20ee0853f4b6"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["R", 
   RowBox[{"a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "cd"}]], " ", "=",
   " ", 
  RowBox[{"k", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["g", 
        RowBox[{"a", "\[InvisibleSpace]", "c"}]], 
       SubscriptBox["g", 
        RowBox[{"b", "\[InvisibleSpace]", "d"}]]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["g", 
        RowBox[{"a", "\[InvisibleSpace]", "d"}]], 
       SubscriptBox["g", 
        RowBox[{"b", "\[InvisibleSpace]", "c"}]]}]}], ")"}], 
    "."}]}]}]], "DisplayFormula",
 CellChangeTimes->{3.5101122635625*^9},
 TextAlignment->Center,ExpressionUUID->"56100832-134b-45a5-9fc9-dc6fcebbbe23"],

Cell[TextData[{
 "Hence, we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    RowBox[{
     RowBox[{"2", " ", "k"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "2"}], "\[Rho]"}]], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["\[Del]", "\[RightVector]"], "2"], "\[Rho]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"6d948337-bfe5-4172-8c23-b6cfb518f93f"],
 ". This leads the Liouville equation"
}], "Text",
 CellChangeTimes->{{3.510112270203125*^9, 
  3.510112274234375*^9}},ExpressionUUID->"0a941dd0-8d20-41a1-99a6-\
657c37943f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    OverscriptBox["\[Del]", "\[RightVector]"], "2"], "\[Rho]"}], " ", "=", 
  " ", 
  RowBox[{
   RowBox[{"-", "k"}], "  ", 
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"2", "\[Rho]"}]], "."}]}]}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"7a24dc59-076d-4b38-a570-311fd0f575b8"],

