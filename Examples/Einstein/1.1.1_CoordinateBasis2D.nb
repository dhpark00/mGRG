Cell["\<\
That is, the metric in two-dimensional symmetric space is given by\
\>", "Text",ExpressionUUID->"7e16ea22-a686-4589-b59f-9d8a706e89f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", "[", 
   RowBox[{"t", ",", "x"}], "]"}], " ", "=", " ", 
