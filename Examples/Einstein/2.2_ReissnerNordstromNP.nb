Cell[CellGroupData[{

Cell["Coordinate Systems and Metric", "Subsubsection",ExpressionUUID->"fd4d9ebe-6de6-41a7-abc8-e0b630653f1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"abbc8959-8819-4fc5-99bb-d4640b16120b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         RowBox[{"2", "M"}], "r"], "-", 
        FractionBox[
         SuperscriptBox["Q", "2"], 
         SuperscriptBox["r", "2"]]}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", "M"}], "r"], "+", 
         FractionBox[
          SuperscriptBox["Q", "2"], 
          SuperscriptBox["r", "2"]]}]], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       SuperscriptBox["r", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"494c2903-afab-4b7c-9d9e-57cb8a0f2bcf"]
}, Closed]],

Cell[CellGroupData[{

Cell["Calculate Newman-Penrose Frame", "Subsubsection",ExpressionUUID->"079a0f5d-aa93-40c2-aae7-cf84d483a1e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"nullVs", " ", "=", " ", 
   RowBox[{"BasisNP", "[", 
    RowBox[{"metric", ",", "Simplify"}], "]"}]}], ";", " ", 
  RowBox[{"MatrixForm", "[", "nullVs", "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"17b3381e-f041-43c5-a043-ce31526020c7"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["r", "2"], 
        RowBox[{
         SuperscriptBox["Q", "2"], "+", 
         RowBox[{"r", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], ")"}]}]}]]}], "1", 
      "0", "0"},
     {
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["Q", "2"], "-", 
         RowBox[{"2", " ", "M", " ", "r"}], "+", 
         SuperscriptBox["r", "2"]}], 
        RowBox[{"2", " ", 
         SuperscriptBox["r", "2"]}]]}], "0", "0"},
     {"0", "0", 
      FractionBox[
       SqrtBox[
        FractionBox["1", 
         SuperscriptBox["r", "2"]]], 
       SqrtBox["2"]], 
      FractionBox[
       SqrtBox[
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
          SuperscriptBox["r", "4"]]}]], 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         FractionBox["1", 
          SuperscriptBox["r", "2"]]]}]]},
     {"0", "0", 
      FractionBox[
       SqrtBox[
        FractionBox["1", 
         SuperscriptBox["r", "2"]]], 
       SqrtBox["2"]], 
      RowBox[{"-", 
       FractionBox[
        SqrtBox[
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
           SuperscriptBox["r", "4"]]}]], 
        RowBox[{
         SqrtBox["2"], " ", 
         SqrtBox[
          FractionBox["1", 
           SuperscriptBox["r", "2"]]]}]]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.4756612559804688`*^9, 3.510119558359375*^9, 
