 CellLabel->"In[1]:=",ExpressionUUID->"28387cae-c6d5-474a-b87f-ddd7d2507f10"],

Cell[CellGroupData[{

Cell["Bonnor's Dipole Solution in Einstein-Maxwell Theory", "Title",
 FontSize->24,ExpressionUUID->"5ab37c3e-102f-4be3-9808-2725f2926996"],

Cell[TextData[{
 "Ref: D. H. Park, ",
 StyleBox["Charged Black Diholes in Ernst Systems",
  FontSlant->"Italic"],
 ", J. Kor. Phy. Soc, 45, 1675 (2004)"
}], "Text",
 CellChangeTimes->{{3.510120179328125*^9, 3.51012027646875*^9}, {
  3.510120886375*^9, 
  3.51012091275*^9}},ExpressionUUID->"73c129c3-aaa3-44c6-b5c2-fdd0b1111753"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"fa5fed32-26ed-4095-ba41-f97a3f4069ed"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["ds", "2"], " ", "=", " ", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["dt", "2"]}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[CapitalSigma]", "4"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalDelta]", "+", 
          RowBox[{"\[Mu]", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], "3"]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox["dx", "2"], "\[CapitalDelta]"], "+", 
        FractionBox[
         SuperscriptBox["dy", "2"], 
         RowBox[{"1", "-", 
          SuperscriptBox["y", "2"]}]]}], ")"}]}]}], "]"}], " ", "+", " ", 
   RowBox[{
    FractionBox["\[CapitalDelta]", "f"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["y", "2"]}], ")"}], 
    SuperscriptBox["d\[CurlyPhi]", "2"]}]}]}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6558d8e6-3f43-460b-b02b-979fd36bd47c"],

Cell[BoxData[
 RowBox[{"f", " ", "=", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"\[CapitalDelta]", " ", "+", " ", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["y", "2"]}], ")"}]}]}], "\[CapitalSigma]"], ")"}], 
   "2"]}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"541d0fc1-0093-4629-a16f-97ee179c851a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    RowBox[{"4", "\[Pi]"}]], 
   SubscriptBox["A", "\[CurlyPhi]"]}], " ", "=", " ", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{"2", "q", " ", "\[CapitalDelta]", " ", "y"}], " ", "+", " ", 
     RowBox[{"2", "a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", " ", "x"}], " ", "+", " ", 
        SuperscriptBox["m", "2"], " ", "-", " ", 
        SuperscriptBox["q", "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["y", "2"]}], ")"}]}]}], 
    RowBox[{"\[CapitalDelta]", "+", 
     RowBox[{
      SuperscriptBox["a", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["y", "2"]}], ")"}]}]}]]}]}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"9cb2f137-98fc-4dda-82b0-b10a2d08371d"],

Cell[TextData[{
 "where the total mass and the charge are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"2", "m"}]}], TraditionalForm]],ExpressionUUID->
  "6127cc24-8d29-43c8-81cf-d3c5763c8958"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", 
    RowBox[{"2", "q"}]}], TraditionalForm]],ExpressionUUID->
  "41c5b470-43be-491c-8971-eac8d348a170"],
 " and"
}], "Text",
 CellChangeTimes->{{3.5101204984375*^9, 
  3.510120498953125*^9}},ExpressionUUID->"79dadc94-eb93-49d7-b030-\
97ccca7c17d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["x", "2"], "-", "\[Mu]"}]}], ",", "     ", 
  RowBox[{"\[CapitalSigma]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "m"}], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", " ", "y"}], " ", "+", "q"}], ")"}], "2"]}]}], ",", 
  "     ", 
  RowBox[{"\[Mu]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["m", "2"], " ", "-", " ", 
    SuperscriptBox["q", "2"], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["a", "2"], "."}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{3.5194517743120627`*^9},
 TextAlignment->Center,ExpressionUUID->"00bf3920-3880-47a8-bf17-354d85238233"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "\[Rule]", "0"}], TraditionalForm]],ExpressionUUID->
  "ff2710d8-dbde-4f1c-9fe0-e01d18aaa5cf"],
 ", the solution reduces to the Bonnor's dipole solution."
}], "Text",ExpressionUUID->"ff6cbcbd-ff41-4d1b-8d20-0d6a57949c51"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", "x_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["x", "2"], "-", "\[Mu]"}]}], ";", 
  RowBox[{
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "m"}], ")"}], "2"], "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", " ", "y"}], " ", "+", "q"}], ")"}], "2"]}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"15e68740-9a93-43ee-bb1a-1dad942b4eff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{
      RowBox[{"\[CapitalDelta]", "[", "x", "]"}], "+", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["y", "2"]}], ")"}]}]}], 
     RowBox[{"\[CapitalSigma]", "[", 
      RowBox[{"x", ",", "y"}], "]"}]], ")"}], "2"]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"82a65d2e-9ccf-4e22-bbe0-907d869c48cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", "\[Phi]", ",", "x", ",", "y"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"7358325a-4816-4e22-b9eb-691663771286"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metric", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], ",", "0", ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        FractionBox[
         RowBox[{"\[CapitalDelta]", "[", "x", "]"}], 
         RowBox[{"f", "[", 
          RowBox[{"x", ",", "y"}], "]"}]], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["y", "2"]}], ")"}]}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[CapitalSigma]", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "2"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "x", "]"}], "+", 
            RowBox[{
             SuperscriptBox["a", "2"], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "x", "]"}], "+", 
            RowBox[{"\[Mu]", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], "3"]], 
        FractionBox["1", 
         RowBox[{"\[CapitalDelta]", "[", "x", "]"}]]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[CapitalSigma]", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "2"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "x", "]"}], "+", 
            RowBox[{
             SuperscriptBox["a", "2"], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "x", "]"}], "+", 
            RowBox[{"\[Mu]", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], "3"]], 
        FractionBox["1", 
         RowBox[{"1", "-", 
          SuperscriptBox["y", "2"]}]]}]}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"9c64963c-750f-4d0a-81b1-9e5b76b13b73"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Mu]Rule", "=", 
   RowBox[{"{", 
    RowBox[{"\[Mu]", "\[Rule]", 
     RowBox[{
      SuperscriptBox["m", "2"], "-", 
      SuperscriptBox["q", "2"], "+", 
      SuperscriptBox["a", "2"]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"cdaebad3-11aa-499d-8dd3-fed7d23f6127"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dipoleRule", "=", 
   RowBox[{"{", 
