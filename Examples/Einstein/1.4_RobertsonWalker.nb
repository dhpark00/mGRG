  3.7598839550194674`*^9, 3.759883961067813*^9}, {3.8274415004411235`*^9, 
  3.82744150202207*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"84f4929f-16a4-45d5-a7d8-501c2b51c17b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"bianchiID", "[", 
     RowBox[{"-", "i"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.521254393921875*^9, 3.521254447828125*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"243f5be0-eb43-433a-b740-6749be4ac49b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"p", "[", "\[Tau]", "]"}], " ", 
       RowBox[{
        SuperscriptBox["a", "\[Prime]",
         MultilineFunction->None], "[", "\[Tau]", "]"}]}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"\[Rho]", "[", "\[Tau]", "]"}], " ", 
       RowBox[{
        SuperscriptBox["a", "\[Prime]",
         MultilineFunction->None], "[", "\[Tau]", "]"}]}], "+", 
      RowBox[{
       RowBox[{"a", "[", "\[Tau]", "]"}], " ", 
       RowBox[{
        SuperscriptBox["\[Rho]", "\[Prime]",
         MultilineFunction->None], "[", "\[Tau]", "]"}]}]}], 
     RowBox[{"a", "[", "\[Tau]", "]"}]]}], ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.52125439940625*^9, 3.521254450140625*^9}, 
   3.521254553546875*^9, 3.539054595158256*^9, 3.5463009540662546`*^9, 
   3.585792463186729*^9, 3.585793809059708*^9, 3.585795221060471*^9, 
   3.619598424886215*^9, 3.630902759183164*^9, 3.75988396415699*^9, 
   3.827441504368861*^9, 3.916200158993204*^9, 3.9512636326812935`*^9, 
   3.9729912189845533`*^9, 3.980993419414209*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"dc6e986c-f4e1-4aa6-a2d3-bd9cf5909918"]
}, Open  ]],

Cell[TextData[{
 "The Bianchi identity gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Rho]", " ", 
       SuperscriptBox["a", "3"]}], ")"}], "'"}], "=", 
    RowBox[{"-", 
     RowBox[{
      RowBox[{"p", "(", 
       SuperscriptBox["a", "3"], ")"}], "'"}]}]}], TraditionalForm]],
  ExpressionUUID->"ea53fa24-119f-430e-ab86-0fa8929e5a4e"],
 ". In a matter-dominated era (",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "be261976-3806-4031-924f-efa16be19980"],
 "), we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     SuperscriptBox["a", "3"]}], "=", "const"}], TraditionalForm]],
  ExpressionUUID->"33b7d8aa-e800-4cb8-b2f9-d1c6410f0f69"],
 ". In a radiation-dominated era (",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"\[Rho]", "/", "3"}]}], TraditionalForm]],ExpressionUUID->
  "72865e80-cee1-4c76-8b41-78fd2b8267cb"],
 "), we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     SuperscriptBox["a", "4"]}], "=", "const"}], TraditionalForm]],
  ExpressionUUID->"16cee556-5c5f-451c-bfd6-f80e2a7786fb"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"w", " ", "\[Rho]"}]}], TraditionalForm]],ExpressionUUID->
  "8eb937e1-5e1b-4032-a99d-c17aefefb819"],
 " the energy-momentum conservation becomes"
}], "Text",
 CellChangeTimes->{{3.5212546510625*^9, 3.52125474053125*^9}, {
   3.5212548131875*^9, 3.521254937296875*^9}, {3.546299342852099*^9, 
   3.546299379539197*^9}, 
   3.7598839725074677`*^9},ExpressionUUID->"88c928d2-17ea-4c0b-98f5-\
3b5470c5b519"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{"\[Rho]", "'"}], "\[Rho]"], "+", 
   RowBox[{"3", 
    RowBox[{"(", 
     RowBox[{"1", "+", "w"}], ")"}], 
    FractionBox[
     RowBox[{"a", "'"}], "a"]}]}], "=", 
  RowBox[{
  "0.", Cell[
   "",ExpressionUUID->
    "138f5e83-7a0d-4a59-a3f9-55ce84f6b23f"]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.546299472676524*^9, 3.546299548351853*^9}, 
   3.5462995864290304`*^9, {3.5463001489892077`*^9, 3.546300185965322*^9}},
 TextAlignment->Center,ExpressionUUID->"8c4f90bc-08cb-49c6-8fd4-cf893109fc91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqBianchi", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Rho]", "\[Prime]",
       MultilineFunction->None], "[", "\[Tau]", "]"}], "/", 
     RowBox[{"\[Rho]", "[", "\[Tau]", "]"}]}], "+", 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"1", "+", "w"}], ")"}], " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Prime]",
        MultilineFunction->None], "[", "\[Tau]", "]"}], "/", 
      RowBox[{"a", "[", "\[Tau]", "]"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.54630163006092*^9, 3.546301688414257*^9}, {
  3.546301722318197*^9, 3.54630175822125*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"e624d697-962f-48e6-8042-3afd59db27c4"],

Cell["\<\
The eq1 can be written as the conservation of the mechanical energy:\
\>", "Text",
 CellChangeTimes->{{3.521344372359375*^9, 3.521344466109375*^9}, {
  3.5213450415*^9, 3.52134506209375*^9}, {3.546299827619826*^9, 
  3.546299829130913*^9}},ExpressionUUID->"9c1e2f24-f1c7-465a-aa2a-\
674dcc32928b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"a", "'"}], "2"], "2"], "-", 
    RowBox[{
     FractionBox["4", "3"], "\[Pi]", " ", "G", " ", 
     RowBox[{
      SuperscriptBox["a", "2"], "(", 
      RowBox[{"\[Rho]", "+", 
       FractionBox["\[CapitalLambda]", 
        RowBox[{"8", "\[Pi]", " ", "G"}]]}], ")"}]}]}], "=", 
   RowBox[{"-", 
    RowBox[{
     FractionBox["k", "2"], "."}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.521344372359375*^9, 3.521344466109375*^9}, {
   3.5213450415*^9, 3.52134506209375*^9}, {3.546299801938357*^9, 
   3.5462998102548323`*^9}, 3.546300145662017*^9, 3.546300201959237*^9},
 TextAlignment->Center,ExpressionUUID->"fb4b8a07-bfb0-4970-a406-e788c44ad133"],

Cell[TextData[{
 "Introducing the Hubble parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    FractionBox[
     RowBox[{"a", "'"}], "a"]}], TraditionalForm]],ExpressionUUID->
  "c9d5125f-852a-4190-8c9a-9ea46325bd6b"],
 ", the eq1 can also be written as"
}], "Text",
 CellChangeTimes->{{3.5462998545233645`*^9, 
  3.546299896995794*^9}},ExpressionUUID->"3e5c8718-76cb-4e29-979a-\
de70e2e86ede"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["H", "2"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"8", "\[Pi]", " ", "G"}], "3"], " ", "\[Rho]"}], "+", 
    FractionBox["\[CapitalLambda]", "3"], "-", 
    RowBox[{
     FractionBox["k", 
      SuperscriptBox["a", "2"]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.521344372359375*^9, 3.521344466109375*^9}, {
   3.5213450415*^9, 3.52134506209375*^9}, {3.546299801938357*^9, 
   3.5462998102548323`*^9}, {3.546299925558428*^9, 3.546299965421707*^9}, {
   3.5463000408230205`*^9, 3.5463000500455475`*^9}, 3.5463001412137623`*^9, 
   3.5463002100056977`*^9, 3.54630056759015*^9, 3.546300637037122*^9},
 TextAlignment->Center,ExpressionUUID->"021480b9-ec4e-4987-a3a8-bd92872a70ab"],

Cell["From eq2,", "Text",
 CellChangeTimes->{{3.521256200875*^9, 3.521256372984375*^9}, {
  3.521256719234375*^9, 3.521256741921875*^9}, {3.5463002223234015`*^9, 
  3.5463002380433006`*^9}},ExpressionUUID->"cc4f1a20-95e5-4328-95ea-\
a7816ed26253"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"a", "''"}], "a"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"4", "\[Pi]", " ", "G"}], "3"]}], 
      RowBox[{"(", 
       RowBox[{"\[Rho]", "+", 
        RowBox[{"3", "p"}]}], ")"}]}], "+", 
     FractionBox["\[CapitalLambda]", "3"]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.521256200875*^9, 3.521256372984375*^9}, {
   3.521256719234375*^9, 3.521256741921875*^9}, {3.5463001100719814`*^9, 
   3.5463001348854003`*^9}, 3.5463002406374497`*^9},
 TextAlignment->Center,ExpressionUUID->"53618cd4-0a96-456e-922b-3988332fc6fe"],

Cell[TextData[{
 "we see that there is an acceleration when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "dcd162c8-3f01-456c-a2ed-db91ae39fd60"],
 ". The eq1 and eq2 are known as the Friedmann equations."
}], "Text",
 CellChangeTimes->{{3.521256200875*^9, 3.521256372984375*^9}, {
   3.521256719234375*^9, 3.521256741921875*^9}, 3.546300228499755*^9, {
   3.5463003102274294`*^9, 
   3.546300330027562*^9}},ExpressionUUID->"75a39528-5aab-418e-966e-\
991b80609a8f"],

Cell["Lut us define the density parameter:", "Text",
 CellChangeTimes->{{3.546300361425358*^9, 
  3.546300389627971*^9}},ExpressionUUID->"3756aec4-37f2-41ca-9b60-\
ecbbfa9650b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"8", "\[Pi]", " ", "G"}], 
       RowBox[{"3", 
        SuperscriptBox["H", "2"]}]], "\[Rho]"}], "=", 
     FractionBox["\[Rho]", 
      SubscriptBox["\[Rho]", "crit"]]}]}], ",", "     ", 
   RowBox[{
    SubscriptBox["\[Rho]", "crit"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"3", 
       SuperscriptBox["H", "2"]}], 
      RowBox[{"8", "\[Pi]", " ", "G"}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.521256200875*^9, 3.521256372984375*^9}, {
   3.521256719234375*^9, 3.521256741921875*^9}, {3.5463001100719814`*^9, 
   3.5463001348854003`*^9}, 3.5463002406374497`*^9, {3.546300400556596*^9, 
   3.546300449805413*^9}},
 TextAlignment->Center,ExpressionUUID->"a0f8a269-7af4-4da8-a67e-4cf3cc4b4d7d"],

Cell["The Friedmann eq1 then becomes", "Text",
 CellChangeTimes->{{3.546300456886818*^9, 3.546300489899706*^9}, 
   3.7760716752610807`*^9, 
   3.980993481175395*^9},ExpressionUUID->"b4c39506-4f10-4b6f-b4d5-\
acc2779c2398"],

Cell[BoxData[
 FormBox[
  RowBox[{"1", "=", 
   RowBox[{"\[CapitalOmega]", "+", 
    FractionBox["\[CapitalLambda]", 
     RowBox[{"3", 
      SuperscriptBox["H", "2"]}]], "-", 
    RowBox[{
     FractionBox["k", 
      RowBox[{
       SuperscriptBox["H", "2"], 
       SuperscriptBox["a", "2"]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.521344372359375*^9, 3.521344466109375*^9}, {
   3.5213450415*^9, 3.52134506209375*^9}, {3.546299801938357*^9, 
   3.5462998102548323`*^9}, {3.546299925558428*^9, 3.546299965421707*^9}, {
   3.5463000408230205`*^9, 3.5463000500455475`*^9}, 3.5463001412137623`*^9, 
   3.5463002100056977`*^9, 3.54630056759015*^9, {3.546300642869456*^9, 
   3.5463006835567827`*^9}},
 TextAlignment->Center,ExpressionUUID->"fa13d303-cc2a-4d01-ba83-b72b7352f0b1"]
}, Closed]],

Cell[CellGroupData[{

Cell["Einstein's Static Universe", "Subsubsection",ExpressionUUID->"52aadd17-14a2-4f55-9219-832ef32cdd6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"staticRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", "\[Tau]", "]"}], " ", "\[Rule]", " ", "a"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "'"}], "[", "\[Tau]", "]"}], " ", "\[Rule]", " ", "0"}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "'"}], "[", "\[Tau]", "]"}], " ", "\[Rule]", " ", 
      "0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"cebd4397-0ba6-47d4-903b-cd6e85f0536a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"eq1", ",", "eq2"}], "}"}], " ", "/.", " ", 
  "staticRule"}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"bf9a7a21-de7b-43fb-8f56-ae74ece24e51"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"3", " ", "k"}], 
     SuperscriptBox["a", "2"]], "-", "\[CapitalLambda]", "-", 
    RowBox[{"8", " ", "G", " ", "\[Pi]", " ", 
     RowBox[{"\[Rho]", "[", "\[Tau]", "]"}]}]}], ",", 
   RowBox[{"\[CapitalLambda]", "-", 
    RowBox[{"12", " ", "G", " ", "\[Pi]", " ", 
     RowBox[{"p", "[", "\[Tau]", "]"}]}], "-", 
    RowBox[{"4", " ", "G", " ", "\[Pi]", " ", 
     RowBox[{"\[Rho]", "[", "\[Tau]", "]"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.4757198260050044`*^9, 3.510122435796875*^9, 
  3.519461803533022*^9, 3.52125649584375*^9, 3.539054677228992*^9, 
  3.546300954140259*^9, 3.585795236674364*^9, 3.619598447035916*^9, 
  3.630902771048027*^9, 3.759884017699052*^9, 3.8274415224198647`*^9, 
  3.9162001936956787`*^9, 3.9512636433715286`*^9, 3.97299127997911*^9, 
  3.980993493929153*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"35e5beb5-2e18-449e-95af-5e8da6fe79d5"]
}, Open  ]],

Cell[TextData[{
 "From these we find ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"11c4214d-5560-4c3c-bd68-bc4b59409adf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "b54232c9-e731-4887-a4f4-c37abc78db0d"]
}], "Text",
 CellChangeTimes->{{3.521256554390625*^9, 
  3.52125655490625*^9}},ExpressionUUID->"f30ce00d-2ea0-4d5e-b309-\
52919a75da42"],

Cell[TextData[{
 "For a dust case (",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "3688735f-fe3b-481c-bf0e-635ab14065f0"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", " ", "=", " ", 
    RowBox[{"4", "\[Pi]", " ", "G", " ", "\[Rho]"}]}], TraditionalForm]],
  ExpressionUUID->"680e7a58-e99d-483d-a5b8-04b65b87018c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", 
    SqrtBox[
     FractionBox["1", 
      RowBox[{"4", "\[Pi]", " ", "G", " ", "\[Rho]"}]]]}], TraditionalForm]],
  ExpressionUUID->"9d7b2408-e7b2-43b2-8d6b-3d2b5c8f9836"]
}], "Text",ExpressionUUID->"871041e9-4f8d-475c-b5bf-d418578cab75"]
}, Closed]],

Cell[CellGroupData[{

Cell["de Sitter Spacetime", "Subsubsection",ExpressionUUID->"c4fd2232-1775-478f-89ad-adb6aad482f7"],

Cell[TextData[{
 "In this case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"918b3eab-b29b-4427-bdb3-7766342fd311"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", " ", "=", " ", 
    RowBox[{"p", " ", "=", " ", "0"}]}], TraditionalForm]],ExpressionUUID->
  "4bd9b391-b24f-47b7-a3ab-583553d6c371"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "5c3826e2-f7fe-4e90-ac11-6328656a4e42"]
}], "Text",
 CellChangeTimes->{{3.52125659296875*^9, 
  3.521256593734375*^9}},ExpressionUUID->"3f21a8e4-afdb-40b5-bfde-\
06c03251005f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deSitterRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "[", "\[Tau]", "]"}], " ", "\[Rule]", " ", "0"}], ",",
      " ", 
     RowBox[{
      RowBox[{"p", "[", "\[Tau]", "]"}], " ", "\[Rule]", " ", "0"}], ",", " ", 
     RowBox[{"k", " ", "\[Rule]", " ", "0"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.5212565994375*^9, 3.521256619890625*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"c43c2804-2c88-4f79-b408-5a234d715732"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"eq1", ",", " ", "eq2"}], "}"}], " ", "/.", " ", 
  "deSitterRule"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"53058189-030d-46da-8af1-45eb847b7102"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[CapitalLambda]"}], "+", 
    FractionBox[
     RowBox[{"3", " ", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["a", "\[Prime]",
         MultilineFunction->None], "[", "\[Tau]", "]"}], "2"]}], 
     SuperscriptBox[
      RowBox[{"a", "[", "\[Tau]", "]"}], "2"]]}], ",", 
   RowBox[{"\[CapitalLambda]", "-", 
    FractionBox[
     RowBox[{"3", " ", 
      RowBox[{
       SuperscriptBox["a", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "\[Tau]", "]"}]}], 
     RowBox[{"a", "[", "\[Tau]", "]"}]]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.47571982602063*^9, 3.510122456625*^9, 3.519461813124571*^9, {
   3.521256602578125*^9, 3.52125662209375*^9}, 3.539054688714087*^9, 
   3.546300954179261*^9, 3.585795242436693*^9, 3.6195984522033453`*^9, 
   3.6309027754319296`*^9, 3.759884025757513*^9, 3.82744152751188*^9, 
   3.9162001998307743`*^9, 3.951263647654217*^9, 3.972991292629572*^9, 
   3.980993505336917*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"f85548db-07c1-44dc-84a2-e6a56c560f9b"]
}, Open  ]],

Cell[TextData[{
 "Therefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "[", "\[Tau]", "]"}], " ", "=", " ", 
    RowBox[{"C", " ", 
     SuperscriptBox["e", 
      RowBox[{
       SqrtBox[
        FractionBox["\[CapitalLambda]", "3"]], "t"}]]}]}], TraditionalForm]],
  ExpressionUUID->"009c5ef1-7bcf-4a6d-9053-b923cc43ab44"]
}], "Text",ExpressionUUID->"8f99f44e-51d7-435e-a488-fa998f78d173"]
}, Closed]],

Cell[CellGroupData[{

Cell["Milne Universe", "Subsubsection",
 CellChangeTimes->{{3.5463009724043036`*^9, 
  3.5463009866501184`*^9}},ExpressionUUID->"773ca8f5-6682-4ca8-a18c-\
b297ca1ebb72"],

Cell[TextData[{
 "In this case ",
 Cell[BoxData[
