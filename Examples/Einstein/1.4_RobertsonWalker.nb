      SubscriptBox["\[Tau]", "a"], 
      SubscriptBox["\[Tau]", "b"]}], " ", "+", " ", 
     RowBox[{"p", " ", 
      SubscriptBox["g", 
       RowBox[{"a", "\[InvisibleSpace]", "b"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"044b3b55-77d7-43b0-927d-d4c6f183c756"]
