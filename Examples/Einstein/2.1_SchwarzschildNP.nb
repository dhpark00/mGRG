Cell[CellGroupData[{

Cell["Coordinate Systems and Metric", "Subsubsection",ExpressionUUID->"986bb8c7-0317-43f6-a146-22f7891cd78a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"74734092-3f1e-4407-a0e1-9f183d7c9f7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         RowBox[{"2", "M"}], "r"]}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", "M"}], "r"]}]], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       SuperscriptBox["r", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"3a37aa94-6dfc-4024-babd-0cabc17e29e9"]
}, Closed]],

Cell[CellGroupData[{

Cell["Calculate Newman-Penrose Frame", "Subsubsection",ExpressionUUID->"52aadca5-2474-4db6-840a-8d50f3d70ee7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"nullVs", " ", "=", " ", 
   RowBox[{"BasisNP", "[", 
    RowBox[{"metric", ",", "Simplify"}], "]"}]}], ";", 
  RowBox[{"MatrixForm", "[", "nullVs", "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"d57252c3-33c5-45dc-a744-94c83ecc3fe9"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["r", 
       RowBox[{
        RowBox[{"2", " ", "M"}], "-", "r"}]], "1", "0", "0"},
     {
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], "+", 
       FractionBox["M", "r"]}], "0", "0"},
     {"0", "0", 
      FractionBox[
       SqrtBox[
        FractionBox["1", 
         SuperscriptBox["r", "2"]]], 
       SqrtBox["2"]], 
      FractionBox[
       SqrtBox[
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
          SuperscriptBox["r", "4"]]}]], 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         FractionBox["1", 
          SuperscriptBox["r", "2"]]]}]]},
     {"0", "0", 
      FractionBox[
       SqrtBox[
        FractionBox["1", 
         SuperscriptBox["r", "2"]]], 
       SqrtBox["2"]], 
      RowBox[{"-", 
       FractionBox[
        SqrtBox[
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
           SuperscriptBox["r", "4"]]}]], 
        RowBox[{
         SqrtBox["2"], " ", 
         SqrtBox[
          FractionBox["1", 
           SuperscriptBox["r", "2"]]]}]]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
