Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["ds", "2"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", "\[Mu]"}], "r"]}], ")"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", "\[Lambda]"}]], 
     SuperscriptBox["dt", "2"]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Lambda]"}]], 
     SuperscriptBox["r", "2"], 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
     SuperscriptBox["d\[CurlyPhi]", "2"]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"h", "-", "\[Lambda]"}], ")"}]}]], "(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["dr", "2"], 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", "\[Mu]"}], "r"]}]], " ", "+", " ", 
      RowBox[{
       SuperscriptBox["r", "2"], 
       SuperscriptBox["d\[Theta]", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.735806266444465*^9, 3.7358062887887435`*^9}},
 TextAlignment->Center,ExpressionUUID->"7a1bdca2-b8c8-4864-a529-7cf0214ec44a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", " ", "=", " ", 
