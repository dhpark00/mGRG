  3.7358065144416504`*^9}},ExpressionUUID->"4491e4d6-4dc8-4776-8cb6-\
b42968202fa9"],

Cell["On the other hand, the area of the horizon is", "Text",ExpressionUUID->"29f2ab6a-33ef-4db3-9e9d-6657d06e931c"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalA]", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SubscriptBox["g", "\[Theta]\[Theta]"], 
        SubscriptBox["g", "\[CurlyPhi]\[CurlyPhi]"]}]], "d\[Theta]", " ", 
      "d\[CurlyPhi]"}]}], 
    SubscriptBox["|", 
     RowBox[{"r", "=", 
      RowBox[{"2", "\[Mu]"}]}]]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Integral]", " ", 
      RowBox[{
       SuperscriptBox["r", "2"], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"h", " ", "-", " ", 
         RowBox[{"2", "\[Lambda]"}]}]], "d\[Theta]", " ", "d\[CurlyPhi]"}]}], 
     SubscriptBox["|", 
      RowBox[{"r", "=", 
       RowBox[{"2", "\[Mu]"}]}]]}], " ", "=", " ", 
    RowBox[{"4", "\[Pi]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Mu]"}], ")"}], "2"], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], "u"}]], "."}]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.4759230849189453`*^9, 3.4759230876464844`*^9}, {
