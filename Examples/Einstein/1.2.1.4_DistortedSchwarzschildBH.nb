  ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"d5cfc0fa-21b7-4a0e-a7d3-cd176260799d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metric", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"2", "\[Mu]"}], "r"]}], ")"}]}], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}]}]]}], ",", "0", ",", "0", ",",
        "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}]}]], 
        SuperscriptBox["r", "2"], 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}], "-", 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}]}]], 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["1", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "\[Mu]"}], "r"]}]], ",", "0"}], "}"}]}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}], "-", 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"r", ",", "\[Theta]"}], "]"}]}], ")"}]}]], 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", 
        SuperscriptBox["r", "2"]}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.735806361066878*^9, 3.73580639573086*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"ca70956a-9aa3-4d20-8466-4033d27cc126"],

Cell[BoxData[
 RowBox[{
  RowBox[{"horizonRule", "=", 
