Cell[TextData[{
 "Therefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", "\[InvisibleSpace]", "\[Mu]"}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"h", "-", 
          RowBox[{"2", "\[Lambda]"}]}], ")"}]}]]}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", "\[InvisibleSpace]", "\[Mu]"}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", "u"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "5840a3d9-7e79-43ce-b2bf-862d8632e304"],
 "."
}], "Text",
