Cell[TextData[{
 "From the Bianchi identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Del]", "a"], 
     SubscriptBox["T", 
      RowBox[{"a", "\[InvisibleSpace]", "b"}]]}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"371b5e26-df2f-4b16-a5c8-ab7dc06843af"],
 " we find"
}], "Text",ExpressionUUID->"34abda5e-66f4-4c33-950d-8aec0f29ca8c"],

