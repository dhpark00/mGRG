Cell[CellGroupData[{

Cell["Energy-Momentum from Einstein Equations", "Subsubsection",
 CellChangeTimes->{{3.475726534421997*^9, 
  3.475726544156372*^9}},ExpressionUUID->"4f3dce24-0733-4b7b-a610-\
0fba95e1a4ef"],

Cell[BoxData[
 RowBox[{"Tdefine", "[", 
  RowBox[{"T", ",", "\"\<ba\>\""}], "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"2b0018f5-8fc4-4b99-8943-b2de1cbe5c10"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"a", "\[InvisibleSpace]", "b"}]], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Rho]", " ", 
       SuperscriptBox["c", "2"]}], ",", " ", 
      RowBox[{"-", "\[Tau]"}], ",", " ", "p", ",", " ", "p"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"f1ce2021-bc91-49a5-afc5-138bc420672f"],
 ", where \[Tau] is the radial pressure."
}], "Text",
 CellChangeTimes->{{3.4757259573692627`*^9, 3.475725987211059*^9}, {
  3.624928817401492*^9, 3.624928824865438*^9}, {3.972903535555057*^9, 
  3.972903537098755*^9}},ExpressionUUID->"5ef1fd39-57ed-42c3-a595-\
35bcd8a0dcf2"],

Cell[BoxData[
 RowBox[{"SetComponents", "[", 
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"la", ",", "lb"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "[", "r", "]"}], " ", 
        SuperscriptBox["c", "2"]}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        RowBox[{"\[Tau]", "[", "r", "]"}]}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"p", "[", "r", "]"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{"p", "[", "r", "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"f008a938-2800-48f4-ae65-0e7753b65d17"],

Cell[TextData[{
 "From the Einstein equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", 
     RowBox[{"a", "\[InvisibleSpace]", "b"}]], " ", "=", " ", 
    RowBox[{"8", "\[Pi]", " ", 
     FractionBox["G", 
      SuperscriptBox["c", "4"]], 
     SubscriptBox["T", 
      RowBox[{"a", "\[InvisibleSpace]", "b"}]]}]}], TraditionalForm]],
  ExpressionUUID->"0ab0e482-8b57-4ff4-b97c-6765125f79fc"],
 " we find"
}], "Text",ExpressionUUID->"c765626b-de1a-462a-acfc-8c19223a66d7"],

