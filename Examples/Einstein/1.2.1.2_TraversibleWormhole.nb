Cell[BoxData[
 RowBox[{
  SuperscriptBox["ds", "2"], " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", "\[CapitalPhi]", 
       RowBox[{"(", "r", ")"}]}]]}], 
    SuperscriptBox["c", "2"], " ", 
    SuperscriptBox["dt", "2"]}], " ", "+", " ", 
   FractionBox[
    SuperscriptBox["dr", "2"], 
    RowBox[{"1", " ", "-", " ", 
     FractionBox[
      RowBox[{"b", 
       RowBox[{"(", "r", ")"}]}], "r"]}]], " ", "+", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], 
    SuperscriptBox["d\[CapitalOmega]", "2"]}]}]}]], "DisplayFormula",
 CellChangeTimes->{
  3.624937057365235*^9, {3.7598191650509987`*^9, 3.759819167451136*^9}},
 TextAlignment->Center,ExpressionUUID->"c762d46e-3059-4492-a70d-075ffcc62ddb"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "b8d00945-7baa-4fcd-b915-905783073731"],
 " is the red shift function and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "[", "r", "]"}], TraditionalForm]],ExpressionUUID->
  "5c05a9f9-a87d-49b2-bb03-f977ec9d14c3"],
 " is the shape function. For wormholes, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "4d07eeeb-1902-4674-a6ab-dc1a1a290a22"],
 " has a minimum ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "0"], TraditionalForm]],ExpressionUUID->
  "4a86512e-2aae-4c0d-98ed-a7552cc4dc3d"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", "(", "r", ")"}], " ", "\[LessEqual]", " ", "r"}], 
   TraditionalForm]],ExpressionUUID->"0f05ad54-9066-4893-a9bb-cbaa452caa9d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", "r", ")"}], TraditionalForm]],ExpressionUUID->
  "764e7077-1e5b-4974-9571-3ac43b526c12"],
 " is finite everywhere."
}], "Text",ExpressionUUID->"93578158-d7ad-43be-824a-4aa32459feb9"],

