Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"[", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         FractionBox["k", "4"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["t", "2"]}], "+", 
           SuperscriptBox["x", "2"]}], ")"}]}]}], "]"}], "2"]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "d"}], "\[InvisibleSpace]", 
        SuperscriptBox["t", "2"]}], " ", "+", " ", 
       RowBox[{"d", "\[InvisibleSpace]", 
        SuperscriptBox["x", "2"]}]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"22a65086-e1a2-45f1-b323-3a22d8161943"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", " ", "=", " ", 
