Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], " ", "-", " ", 
    RowBox[{"2", "M", " ", "r"}], " ", "+", " ", 
    SuperscriptBox["a", "2"]}]}], ";", " ", 
  RowBox[{"\[CapitalSigma]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["a", "2"], " ", 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";"}]], "Input",
