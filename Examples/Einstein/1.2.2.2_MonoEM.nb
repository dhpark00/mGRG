Cell["From the asymptotic condition", "Text",ExpressionUUID->"b22fb544-2794-4b98-9fbd-ff32852aeef0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"eq2", " ", "/.", " ", "asympRule"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"7e5ef61e-4db2-4c6b-a1e6-b7857642fb56"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "M", " ", 
       TemplateBox[{
         SubscriptBox["\"a\"", "1"]},
        "RowDefault"]}], "+", 
      RowBox[{
       SqrtBox["2"], " ", "P", " ", 
       TemplateBox[{
         SubscriptBox["\"a\"", "3"]},
        "RowDefault"]}]}], ")"}], " ", "x"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "2"],
    SeriesData[$CellContext`x, 0, {}, 1, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {
   2 $CellContext`M $CellContext`aCharge[1] + 
    2^Rational[1, 2] $CellContext`P $CellContext`aCharge[3]}, 1, 2, 1],
  Editable->False]], "Output",
