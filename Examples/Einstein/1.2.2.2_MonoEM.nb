Cell["\<\
Substituting the solution into the signature of the geodesic we find\
\>", "Text",ExpressionUUID->"511a771b-d77b-4d82-92a7-23934a887f58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"%", " ", "/.", " ", "sol2Rule"}], "//", "Expand"}]], "Input",
