  "5f5d5069-70ec-471d-811a-110001f625d9"],
 " of the geodesic:"
}], "Text",ExpressionUUID->"db11a152-79b1-4dd5-b472-0575a6b22d2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trM", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "f"]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["v", "f"]}], ",", 
       FractionBox["1", "f"]}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"5dcbdbf3-59fe-4b44-b00b-dcb441483a00"],

