Cell["which is manifestly constant.", "Text",ExpressionUUID->"eb8d09c8-3b6b-4354-bfad-55d9a694c4b2"],

Cell["At the event horizon the signature takes the following form:", "Text",ExpressionUUID->"2c8420af-fba0-4fb1-bacd-5eab717751d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"horizonRule", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", " ", "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{"v", " ", "\[Rule]", " ", 
       SubscriptBox["v", "h"]}]}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"at", " ", "the", " ", "event", " ", "horizon"}], " ", 
   "*)"}]}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"cfd4446d-9c89-4f67-a622-459240623c81"],

