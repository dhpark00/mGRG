 CellLabel->"In[1]:=",ExpressionUUID->"5e62e75a-48b8-44c5-ac09-cd24e4cf0f49"],

Cell[CellGroupData[{

Cell["Static Monopoles in Einstein-Maxwell Theory", "Section",
 FontSize->24,ExpressionUUID->"43d38599-feed-4dde-8d0e-aa35a8b46394"],

Cell[TextData[{
 "Ref: D. H. Park, ",
 StyleBox["Geometric Construction of Static Dyons in Scalar-Vector-Tensor \
Theory",
  FontSlant->"Italic"],
 ", J. Kor. Phy. Soc, 37, 177 (2000)"
}], "Text",
 CellChangeTimes->{{3.510120179328125*^9, 
  3.51012027646875*^9}},ExpressionUUID->"c53d285b-2d91-4f86-ae6f-\
db4a0a29b9cc"],

Cell[CellGroupData[{

Cell["Theory", "Subsection",ExpressionUUID->"8aa073bd-0e20-41bf-ba7d-d84c3ccc720f"],

Cell[CellGroupData[{

Cell["Action", "Subsubsection",ExpressionUUID->"cac65574-67a8-4a23-85aa-fbe8250e4b54"],

Cell[BoxData[
 FormBox[
  RowBox[{"I", " ", "=", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["d", "4"], "x", " ", 
     RowBox[{
      SqrtBox[
       RowBox[{"-", "g"}]], "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["\[Kappa]", "2"]], "R"}], " ", "-", " ", 
       RowBox[{
        FractionBox["1", "4"], 
        SuperscriptBox[
         SubscriptBox["F", "\[Mu]\[Nu]"], "2"]}]}], "]"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6788a33e-0979-4a5e-b6fe-907115ec2475"]
}, Closed]],

Cell[CellGroupData[{

Cell["Static Metric", "Subsubsection",ExpressionUUID->"ebcb3aa8-4ee5-4c28-84b4-587466c4ab87"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "f"}], " ", "d", "\[InvisibleSpace]", 
     SuperscriptBox["t", "2"]}], " ", "+", " ", 
    RowBox[{
     FractionBox["1", "f"], 
     SubscriptBox["\[Gamma]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "d", "\[InvisibleSpace]", 
     SuperscriptBox["x", "i"], "d", "\[InvisibleSpace]", 
     SuperscriptBox["x", "j"]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6696f756-72c4-4f13-9866-9c26078ba6f6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Effective Action", "Subsubsection",ExpressionUUID->"0e914f0c-ca09-419f-9674-16b4af641161"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["I", "eff"], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Kappa]", "2"]], 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["d", "3"], "x", " ", 
      RowBox[{
       SqrtBox["\[Gamma]"], "[", 
       RowBox[{
        SubscriptBox["R", "3"], " ", "-", " ", 
        RowBox[{
         FractionBox["1", "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SubscriptBox["\[PartialD]", "i"], "ln"}], " ", "f"}], ")"}], 
          "2"]}], " ", "+", " ", 
        RowBox[{
         FractionBox["1", "f"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[PartialD]", "i"], "v"}], ")"}], "2"]}]}], 
       "]"}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"1866a72d-3d87-4cd7-ad80-45ec2c8be836"],

Cell["where", "Text",ExpressionUUID->"1b31e4ef-4af8-4b33-a855-65b89a1a5778"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[Kappa]", 
     SqrtBox["2"]], 
    SubscriptBox["F", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]]}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "f"], 
    SubscriptBox["\[Epsilon]", 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
    RowBox[{
     SuperscriptBox["\[PartialD]", "k"], "v"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"5ec715ab-5807-4d00-9ed2-cc1b8239c110"]
}, Closed]],

Cell[CellGroupData[{

Cell["Metric in Potential Space", "Subsubsection",ExpressionUUID->"fe4beb9e-40f7-42b1-b360-050c2c194bb2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["S", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"A", "\[InvisibleSpace]", "B"}]], "d", "\[InvisibleSpace]", 
     SuperscriptBox["\[CurlyPhi]", "A"], "d", "\[InvisibleSpace]", 
     SuperscriptBox["\[CurlyPhi]", "B"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "f"]}], "d", "\[InvisibleSpace]", 
      SuperscriptBox["v", "2"]}], " ", "+", " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", 
        SuperscriptBox["f", "2"]}]], "d", "\[InvisibleSpace]", 
      SuperscriptBox["f", "2"]}]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"642cb7de-55d2-4186-8478-856f4bbd93ec"]
}, Closed]],

Cell[CellGroupData[{

Cell["Equations of Motion", "Subsubsection",ExpressionUUID->"e4472991-b27a-4921-b23d-e9492c1c2833"],

Cell[TextData[{
 "Assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", "A"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", "A"], "(", "\[Lambda]", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"bef640b9-3306-475e-80e9-85c46f85064e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Del]", "2"], "\[Lambda]"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"57f685ca-e3e7-4839-8b76-939e18e82be5"],
 ". The equation of motion then becomes"
}], "Text",
 CellChangeTimes->{{3.5194512725193615`*^9, 
  3.519451276575593*^9}},ExpressionUUID->"536c32df-f49e-4b9f-bfa7-\
f926c6458e40"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
   RowBox[{"\[Epsilon]", " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "i"], "\[Lambda]"}], " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "j"], "\[Lambda]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"7e8f4f5f-b941-4107-b53c-dbd8fb602e26"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Xi]", "A"], 
    RowBox[{
     SubscriptBox["\[Del]", "A"], 
     SuperscriptBox["\[Xi]", "B"]}]}], " ", "=", " ", "0"}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"24307ead-a60d-481b-bb9c-013bb044d391"],

Cell["where", "Text",ExpressionUUID->"0326c15b-e4f1-4e44-85c8-85119bd0b79e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Xi]", "A"], " ", "=", " ", 
    FractionBox[
     RowBox[{"d", "\[InvisibleSpace]", 
      SuperscriptBox["\[CurlyPhi]", "A"]}], 
     RowBox[{"d", "\[InvisibleSpace]", "\[Lambda]"}]]}], ",", "     ", 
   RowBox[{"\[Epsilon]", " ", "=", " ", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"A", "\[InvisibleSpace]", "B"}]], 
     SuperscriptBox["\[Xi]", "A"], 
     RowBox[{
      SuperscriptBox["\[Xi]", "B"], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.5194512615637345`*^9},
 TextAlignment->Center,ExpressionUUID->"2e6c9c2a-6bee-4495-a9be-fc1816f7bdac"],

Cell[TextData[{
 "Notice that for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"5536696c-d5cf-4999-8d3a-b157d69e66d1"],
 " the three-dimensional Einstein equation simply gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]]}], TraditionalForm]],
  ExpressionUUID->"da36df4c-e3b7-4270-951e-7fd6f1066ac0"],
 "."
}], "Text",ExpressionUUID->"7f810744-2995-46af-8c4f-e2ad7d862c29"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Killing Symmetries of Potential Space", "Subsection",ExpressionUUID->"22dc5bc2-100d-4f22-a5d9-bb2d2f3a2e6a"],

Cell[BoxData[
 RowBox[{"InitCTensor", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"v", ",", "f"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "f"]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox["f", "2"]}]]}], "}"}]}], "}"}], ",", 
   RowBox[{"RicciCD", "\[Rule]", "True"}], ",", 
