Cell[TextData[{
 "we find ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["a", "3"], 
     SubscriptBox["a", "1"]], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox["2"]}], 
     FractionBox["M", "P"]}]}], TraditionalForm]],ExpressionUUID->
  "fbbb5ab1-0b2c-40c2-ba69-82935dc2d7cc"],
 "."
}], "Text",ExpressionUUID->"3b6248fb-7330-44f2-8171-97bee3c30fb5"],

Cell["In summary, the geodesic of the potential space gives", "Text",
 CellChangeTimes->{{3.759827049826983*^9, 
  3.759827052867156*^9}},ExpressionUUID->"f063ffce-8862-41f3-baea-\
4db6e1efbea9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
    RowBox[{"\[Epsilon]", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "i"], "\[Lambda]"}], " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "j"], "\[Lambda]"}]}]}], ",", "     ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Del]", "2"], "\[Lambda]"}], " ", "=", " ", "0"}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"a09d9698-5f76-4c00-8ed0-9b2af75ea219"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["\[Epsilon]", 
    SubsuperscriptBox["a", "1", "2"]], " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["M", "2"], 
      SuperscriptBox["P", "2"]], " ", "-", " ", "1"}], " ", "=", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SubscriptBox["v", "h"], 
        SqrtBox["2"]], " ", "+", " ", 
       FractionBox["M", "P"]}], ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"eca6bc5a-286e-4a94-af5c-d3e904a58cd3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"v", " ", "+", " ", 
         RowBox[{
          SqrtBox["2"], 
          FractionBox["M", "P"]}]}], ")"}], "2"]}], " ", "-", " ", 
     FractionBox["\[Epsilon]", 
      SubsuperscriptBox["a", "1", "2"]]}]}], ",", "     ", 
   RowBox[{
    FractionBox[
     RowBox[{"d", "\[InvisibleSpace]", "v"}], 
     RowBox[{
      SubscriptBox["a", "1"], "d", "\[InvisibleSpace]", "\[Lambda]"}]], " ", "=",
     " ", 
    RowBox[{"-", 
     RowBox[{"f", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.5194514867326136`*^9},
 TextAlignment->Center,ExpressionUUID->"8a0b9eb8-c3fc-47ba-a4dd-08c0261d8620"],

Cell[TextData[{
 "Notice that if the horizon exists at which ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "\[Rule]", "0"}], TraditionalForm]],ExpressionUUID->
  "74e437eb-f802-49a4-aa28-f4cf3975f0ee"],
 ", the geodesic is always time-like and satisfies the Bogomolnyi bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["M", "2"], " ", "\[GreaterEqual]", " ", 
    SuperscriptBox["P", "2"]}], TraditionalForm]],ExpressionUUID->
  "a94dd99d-66aa-4c17-b01c-a67faab92cd1"],
 "."
}], "Text",ExpressionUUID->"1567c101-ec43-4fc9-be6e-a6cad1a9a73e"]
}, Closed]]
}, Open  ]]
