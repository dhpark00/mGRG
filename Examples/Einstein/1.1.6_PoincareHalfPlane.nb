Cell[TextData[{
 "Poincar\[EAcute] half-plane is the region ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "0d1db09b-ad13-4b2a-adf2-5d45e75dc53d"],
 " of a two-dimensional region with metric"
}], "Text",
 CellChangeTimes->{
  3.519345436171875*^9, {3.545798869723672*^9, 
   3.545798917568408*^9}},ExpressionUUID->"14d961d6-7b9c-4023-8146-\
900d83eb06f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox["a", "2"], 
     SuperscriptBox["y", "2"]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"d", "\[InvisibleSpace]", 
        SuperscriptBox["x", "2"]}], " ", "+", " ", 
       RowBox[{"d", "\[InvisibleSpace]", 
        SuperscriptBox["y", "2"]}]}], ")"}], "."}]}]}], 
  TraditionalForm]], "NumberedEquation",
 CellChangeTimes->{{3.545798822777987*^9, 3.5457988357677293`*^9}, 
   3.545798922473688*^9},
 TextAlignment->Center,ExpressionUUID->"1f70110d-2e79-4bd9-a41d-3fd8e842a586"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metric", " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox["a", "2"], 
     SuperscriptBox["y", "2"]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.545798934274363*^9, 3.545798955211561*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"2bf6845b-074b-4a1d-8338-9aae0bf4a1ff"]
