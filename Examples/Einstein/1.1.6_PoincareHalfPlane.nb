Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "ScalarCD", "]"}]], "Input",
 CellChangeTimes->{{3.519346518796875*^9, 3.519346519390625*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8c3a5711-5226-47f2-821e-7fa03cc06aa6"],

Cell[BoxData[
 TemplateBox[{
   TemplateBox[{"R", 
     TemplateBox[{}, "RowDefault"], 
     TemplateBox[{}, "RowDefault"]}, "Subsuperscript", SyntaxForm -> 
    SubsuperscriptBox], "\" = \"", 
   FractionBox[
    RowBox[{
      RowBox[{
        RowBox[{"-", 
          RowBox[{"f", "[", "r", "]"}]}], " ", 
        RowBox[{
          SuperscriptBox["f", "\[Prime]", MultilineFunction -> None], "[", 
          "r", "]"}]}], "+", 
      RowBox[{"r", " ", 
        SuperscriptBox[
         RowBox[{
           SuperscriptBox["f", "\[Prime]", MultilineFunction -> None], "[", 
           "r", "]"}], "2"]}], "-", 
      RowBox[{"r", " ", 
        RowBox[{"f", "[", "r", "]"}], " ", 
        RowBox[{
          SuperscriptBox["f", "\[Prime]\[Prime]", MultilineFunction -> None], 
          "[", "r", "]"}]}]}], 
    RowBox[{"r", " ", 
      SuperscriptBox[
       RowBox[{"f", "[", "r", "]"}], "3"]}]]},
  "RowDefault"]], "Print",
 CellChangeTimes->{3.639131521296078*^9, 3.7589460382430773`*^9, 
  3.7751940223162*^9, 3.827378780403769*^9, 3.9161828522559624`*^9, 
