\:c911In[13]:=",ExpressionUUID->"11f3890e-5b95-4d40-8000-afa77cee46ec"]
}, Open  ]],

Cell[TextData[{
 "To be maximally symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{
     RowBox[{"-", "2"}], "/", 
     SuperscriptBox["a", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "5ccb77ee-057e-4640-88da-3553a0801834"],
 ":"
}], "Text",
 CellChangeTimes->{{3.639131744036819*^9, 3.639131765868067*^9}, {
  3.639131830309753*^9, 
  3.639131830309753*^9}},ExpressionUUID->"e9cb007f-9467-4d14-9c61-\
ffc6f2c44cab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ScalarCD", "[", "]"}], "+", 
     FractionBox["2", 
      SuperscriptBox["a", "2"]]}], "\[Equal]", "0"}], ",", 
   RowBox[{"f", "[", "r", "]"}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.639131540936202*^9, 3.639131571189932*^9}, {
   3.639131691949839*^9, 3.6391316938619485`*^9}, {3.639131833294924*^9, 
   3.639131833725949*^9}, 3.6391318888231*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"e5e3ee1d-f594-4507-8086-e2b0d758fe95"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "r", "]"}], "\[Rule]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         TemplateBox[{"1"},
          "C"]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"Tanh", "[", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SqrtBox["2"], " ", 
               SqrtBox[
                RowBox[{"2", "+", 
                 TemplateBox[{"1"},
                  "C"]}]], " ", 
               TemplateBox[{"2"},
                "C"]}], "-", 
              RowBox[{
               SqrtBox["2"], " ", 
               SqrtBox[
                RowBox[{"2", "+", 
                 TemplateBox[{"1"},
                  "C"]}]], " ", 
               RowBox[{"Log", "[", "r", "]"}]}]}], ")"}]}], "]"}], "2"]}], 
        ")"}]}], 
      RowBox[{"2", " ", 
       SuperscriptBox["r", "2"]}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "r", "]"}], "\[Rule]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         TemplateBox[{"1"},
          "C"]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"Tanh", "[", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                SqrtBox["2"]}], " ", 
               SqrtBox[
                RowBox[{"2", "+", 
                 TemplateBox[{"1"},
                  "C"]}]], " ", 
               TemplateBox[{"2"},
                "C"]}], "+", 
              RowBox[{
               SqrtBox["2"], " ", 
               SqrtBox[
                RowBox[{"2", "+", 
                 TemplateBox[{"1"},
                  "C"]}]], " ", 
               RowBox[{"Log", "[", "r", "]"}]}]}], ")"}]}], "]"}], "2"]}], 
        ")"}]}], 
      RowBox[{"2", " ", 
       SuperscriptBox["r", "2"]}]]}], "}"}]}], "}"}]], "Output",
