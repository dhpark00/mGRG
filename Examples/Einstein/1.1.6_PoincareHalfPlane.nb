Cell[CellGroupData[{

Cell["Rotationally Symmetric Form", "Subsubsection",
 CellChangeTimes->{{3.6391313940448*^9, 3.6391314035083413`*^9}, {
  3.639132090732648*^9, 
  3.639132093452803*^9}},ExpressionUUID->"477bd6e8-f6e5-4ab8-9d2c-\
d90eef67dde3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]"}], "}"}]}], ";", 
  RowBox[{"metric", " ", "=", " ", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        SuperscriptBox["r", "2"]}], "}"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.545798934274363*^9, 3.545798955211561*^9}, {
   3.639131494149525*^9, 3.639131501893969*^9}, 3.639132037254589*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"cc690a02-9e3d-4e24-b608-e999c8ad841a"],

Cell[BoxData[
 RowBox[{"InitCTensor", "[", 
  RowBox[{"coSys", ",", " ", "metric", ",", 
   RowBox[{"RicciCD", "\[Rule]", "True"}], ",", 
   RowBox[{"FourDimensionQ", "->", "False"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.519345464859375*^9, 3.5193454654375*^9}, {
