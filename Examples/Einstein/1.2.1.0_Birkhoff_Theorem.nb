Cell["The resulting metric is", "Text",ExpressionUUID->"dc0b9831-b24c-4cfc-a773-ca41f5a63a48"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"d", "\[InvisibleSpace]", 
     SuperscriptBox["s", "2"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SuperscriptBox["e", 
         RowBox[{"2", 
          RowBox[{"h", "[", "t", "]"}]}]], "(", 
        RowBox[{"1", " ", "-", " ", 
         FractionBox[
          RowBox[{"2", "m"}], "r"]}], ")"}]}], "d", "\[InvisibleSpace]", 
      SuperscriptBox["t", "2"]}], " ", "+", " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", " ", "-", " ", 
        FractionBox[
         RowBox[{"2", "m"}], "r"]}]], "d", "\[InvisibleSpace]", 
      SuperscriptBox["r", "2"]}], " ", "+", " ", 
     RowBox[{
      SuperscriptBox["r", "2"], "(", 
      RowBox[{
       RowBox[{"d", "\[InvisibleSpace]", 
        SuperscriptBox["\[Theta]", "2"]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["sin", "2"], "\[Theta]", " ", "d", "\[InvisibleSpace]", 
        SuperscriptBox["\[Phi]", "2"]}]}], ")"}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.51935012228125*^9, 3.5193501320625*^9}},
 TextAlignment->Center,ExpressionUUID->"476c4406-6a48-4c95-ac35-da0c4fa5cd87"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "a0c2e76a-4e77-4ad3-8d4a-b9f25e40d982"],
 " is a constant."
}], "Text",
 CellChangeTimes->{{3.519350134765625*^9, 
  3.5193501420625*^9}},ExpressionUUID->"9fa99ed3-bf53-4d0b-8de5-08300d82dc90"],

Cell[TextData[{
 "Now, we define a new time coordinate ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["t", "~"], TraditionalForm]],ExpressionUUID->
  "c6023a73-3bd2-4aa2-af90-a05a4953124f"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "\[InvisibleSpace]", 
     OverscriptBox["t", "~"]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"h", "[", "t", "]"}]], "d", "\[InvisibleSpace]", "t"}]}], 
   TraditionalForm]],ExpressionUUID->"22f05cf4-efe1-4191-aae6-c93058dbd16f"],
 ". We then have"
}], "Text",
 CellChangeTimes->{{3.9729017378577833`*^9, 
  3.972901752148511*^9}},ExpressionUUID->"b57d6d36-5e44-48f5-a5a0-\
3e15a70d71f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        FractionBox[
         RowBox[{"2", "m"}], "r"]}], ")"}]}], "d", "\[InvisibleSpace]", 
     SuperscriptBox[
      OverscriptBox["t", "~"], "2"]}], " ", "+", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", " ", "-", " ", 
       FractionBox[
        RowBox[{"2", "m"}], "r"]}]], "d", "\[InvisibleSpace]", 
     SuperscriptBox["r", "2"]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["r", "2"], "(", 
     RowBox[{
      RowBox[{"d", "\[InvisibleSpace]", 
       SuperscriptBox["\[Theta]", "2"]}], " ", "+", " ", 
      RowBox[{
       SuperscriptBox["sin", "2"], "\[Theta]", " ", "d", "\[InvisibleSpace]", 
       SuperscriptBox["\[Phi]", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.972901775230474*^9},
 TextAlignment->Center,ExpressionUUID->"59c839e2-6311-4393-bcbe-1ccddaad78f5"],

