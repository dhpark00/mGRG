Cell[CellGroupData[{

Cell["Rules", "Subsubsection",ExpressionUUID->"4cf88e80-5d9e-45c8-9b85-bf9c46756ec0"],

Cell["\<\
Use private definitions of heavisideStep and diracDelta for fast \
simplification in Mathematica Ver 4.\
\>", "Text",
 CellChangeTimes->{
  3.626337678689975*^9},ExpressionUUID->"18c3dd51-9ac6-4988-bdc6-\
95524278bbb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"heavisideStep", "[", "u_", "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Theta]", "[", "u", "]"}]}], ";", 
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"diracDelta", "[", "u_", "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Delta]", "[", "u", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.626337684748834*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"e7a365f5-fb3f-4a0b-a521-28510c6ed87c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Derivative", "[", "1", "]"}], "[", "heavisideStep", "]"}], "[", 
   "u_", "]"}], " ", ":=", " ", 
  RowBox[{"diracDelta", "[", "u", "]"}]}]], "Input",
 CellChangeTimes->{3.6263376913167686`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"6ae71415-4f06-43e3-8282-f84626004f5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CsimplifyRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"u_", "^", "_."}], " ", 
       RowBox[{
        RowBox[{"diracDelta", "[", "u_", "]"}], "^", "_."}]}], " ", "\[RuleDelayed]",
       " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"u_", " ", 
       RowBox[{
        RowBox[{"diracDelta", "'"}], "[", "u_", "]"}]}], " ", "\[RuleDelayed]",
       " ", 
      RowBox[{"-", 
       RowBox[{"diracDelta", "[", "u", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"704df73e-ceaf-4923-a6e7-de4455b3091f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Coordinate System and Metric", "Subsubsection",ExpressionUUID->"10f4ba40-ef6e-44ce-98bd-dc831cde1f5a"],

Cell["The Khan-Penrose vacuum solution is given by", "Text",ExpressionUUID->"fdd13cea-37e8-446b-84c4-e32e3618707e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"f", "(", 
      RowBox[{"u", ",", "v"}], ")"}], " ", "d", "\[InvisibleSpace]", "u", " ",
      "d", "\[InvisibleSpace]", "v"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"F", "(", 
      RowBox[{"u", ",", "v"}], ")"}], " ", "d", "\[InvisibleSpace]", 
     SuperscriptBox["y", "2"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"G", "(", 
      RowBox[{"u", ",", "v"}], ")"}], " ", "d", "\[InvisibleSpace]", 
     SuperscriptBox["z", "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"7f35c663-0d85-4de5-bc1a-9ee8b457b232"],

Cell["where", "Text",ExpressionUUID->"52b724ea-17f5-4b36-93fd-d6dc8555ae0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", " ", "=", " ", 
    FractionBox[
     SuperscriptBox["m", "3"], 
     RowBox[{"2", "r", " ", 
      SuperscriptBox[
       RowBox[{"w", "(", 
        RowBox[{
         RowBox[{"p", " ", "q"}], " ", "+", " ", 
         RowBox[{"r", " ", "w"}]}], ")"}], "2"]}]]}], ",", "     ", 
   RowBox[{"F", " ", "=", " ", 
    RowBox[{
     SuperscriptBox["m", "2"], " ", 
     FractionBox[
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"p", " ", "w"}], " ", "-", " ", 
       RowBox[{"q", " ", "r"}]}], 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"p", " ", "w"}], " ", "+", "  ", 
       RowBox[{"q", " ", "r"}]}]]}]}], ",", "     ", 
   RowBox[{"G", " ", "=", " ", 
    RowBox[{
     SuperscriptBox["m", "2"], "  ", 
     FractionBox[
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"p", " ", "w"}], " ", "+", " ", 
       RowBox[{"q", " ", "r"}]}], 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"p", " ", "w"}], " ", "-", " ", 
       RowBox[{"q", " ", "r"}]}]]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"ff1784ad-b86f-41f2-8976-7434ba057f72"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"p", " ", "=", " ", 
    RowBox[{"u", " ", 
     RowBox[{"\[Theta]", "(", "u", ")"}]}]}], ",", "     ", 
   RowBox[{"q", " ", "=", " ", 
    RowBox[{"v", " ", 
     RowBox[{"\[Theta]", "(", "v", ")"}]}]}], ",", "     ", 
   RowBox[{"r", " ", "=", " ", 
    SqrtBox[
     RowBox[{"1", " ", "-", " ", 
      SuperscriptBox["p", "2"]}]]}], ",", "     ", 
   RowBox[{"w", " ", "=", " ", 
    SqrtBox[
     RowBox[{"1", " ", "-", " ", 
      SuperscriptBox["q", "2"]}]]}], ",", "     ", 
   RowBox[{"m", " ", "=", " ", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["p", "2"], " ", "-", " ", 
       SuperscriptBox["q", "2"]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.5194623281560283`*^9},
 TextAlignment->Center,ExpressionUUID->"6fb2253b-87db-4dcd-8c94-3836b3370723"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", "q"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"heavisideStep", "[", "u", "]"}]}], ",", 
     RowBox[{"v", " ", 
      RowBox[{"heavisideStep", "[", "v", "]"}]}]}], "}"}]}], ";"}]], "Input",
