       RowBox[{"1", " ", "+", " ", 
        RowBox[{"p", " ", "w"}], " ", "+", " ", 
        RowBox[{"q", " ", "r"}]}], 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"p", " ", "w"}], " ", "-", " ", 
        RowBox[{"q", " ", "r"}]}]]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"7a19c1d5-ffa1-4d28-ae0a-fe3e08351074"],

