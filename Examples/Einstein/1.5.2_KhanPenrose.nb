 CellLabel->"In[5]:=",ExpressionUUID->"7fa0cdcb-d878-427d-a82a-a6d13f806d00"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", ",", "w", ",", "m"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["p", "2"]}]], ",", 
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["q", "2"]}]], ",", 
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["p", "2"], " ", "-", " ", 
       SuperscriptBox["q", "2"]}]]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"a8441418-0252-4d25-9ab0-778fd882a7d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", ",", "F", ",", "G"}], "}"}], " ", "=", " ", 
