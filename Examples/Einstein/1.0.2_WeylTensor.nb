Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Del]", 
    RowBox[{"[", "\[Mu]"}]], 
   SubscriptBox["R", 
    RowBox[{
     RowBox[{"\[Nu]\[Rho]", "]"}], "\[Sigma]\[Beta]"}]]}], "=", 
  RowBox[{
   RowBox[{"0", "    ", "\[Rule]", "    ", 
    RowBox[{
     SuperscriptBox["\[Del]", "\[Mu]"], 
     SubscriptBox["C", "\[Mu]\[Nu]\[Rho]\[Sigma]"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      RowBox[{"[", "\[Rho]"}]], 
     SubscriptBox["R", 
      RowBox[{
       RowBox[{"\[Sigma]", "]"}], "\[Nu]"}]]}], "+", " ", 
    RowBox[{
     FractionBox["1", "6"], 
     SubscriptBox["g", 
      RowBox[{"\[Nu]", "[", "\[Rho]"}]], 
     RowBox[{
      SubscriptBox["\[Del]", 
       RowBox[{"\[Sigma]", "]"}]], "R"}]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.639220749673724*^9, 3.639220843754105*^9}},
