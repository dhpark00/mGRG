Cell[CellGroupData[{

Cell["Killing Basis", "Subsubsection",ExpressionUUID->"5dffe1a2-152f-411e-b006-888feb6f06a2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["K", "a", "A"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["h", "a"], "\[Mu]"], 
     SubsuperscriptBox["\[PartialD]", "\[Mu]", "A"]}]}], ",", "     ", 
   RowBox[{
    SubsuperscriptBox["K", "1", "A"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[PartialD]", "\[Tau]", "A"], " ", 
      RowBox[{"-", " ", 
       FractionBox["k", "4"]}]}], 
     SuperscriptBox["\[Lambda]", "2"], 
     SubsuperscriptBox["\[PartialD]", "\[Lambda]", "A"]}]}], ",", "     ", 
   RowBox[{
    SubsuperscriptBox["K", "2", "A"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["k", "4"]}], 
     SuperscriptBox["\[Tau]", "2"], 
     RowBox[{
      SubsuperscriptBox["\[PartialD]", "\[Tau]", "A"], " ", 
      RowBox[{"+", " ", 
       SubsuperscriptBox["\[PartialD]", "\[Lambda]", "A"]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"d28cde56-448c-4c34-97ab-337450ce2a87"],

