Cell[CellGroupData[{

Cell["Exact plane gravitational waves", "Subsubsection",ExpressionUUID->"f9a61e2a-83c7-4a9f-a28b-95dd83fcabca"],

Cell["\<\
We assume the line element (Rosen form) in double null coordinates:\
\>", "Text",ExpressionUUID->"7db38f01-99dc-4df8-b08d-9ade81e36d2c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "d", "\[InvisibleSpace]", "u", " ", "d", "\[InvisibleSpace]",
      "v"}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "2"], "(", "u", ")"}], " ", "d", "\[InvisibleSpace]", 
     SuperscriptBox["y", "2"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["g", "2"], "(", "u", ")"}], " ", "d", "\[InvisibleSpace]", 
     RowBox[{
      SuperscriptBox["z", "2"], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.519462082729991*^9},
 TextAlignment->Center,ExpressionUUID->"c278e0c3-a0e1-4683-9d97-d9c8e209ff8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coSys", "=", 
   RowBox[{"{", 
    RowBox[{"u", ",", "v", ",", "y", ",", "z"}], "}"}]}], ";", 
  RowBox[{"metric", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       SuperscriptBox[
        RowBox[{"f", "[", "u", "]"}], "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       SuperscriptBox[
        RowBox[{"g", "[", "u", "]"}], "2"]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"9edbca13-1962-4dbb-bdfa-7f0f0594d1b9"],

