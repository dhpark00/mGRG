Cell[TextData[{
 "Therefore, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"f", "'"}], "'"}], "f"], " ", "=", " ", "h"}], 
   TraditionalForm]],ExpressionUUID->"c6bfc7d0-07df-4d03-b62d-b94532258a55"],
 " the vacuum field equation becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"g", "'"}], "'"}], "g"], " ", "=", " ", 
    RowBox[{"-", "h"}]}], TraditionalForm]],ExpressionUUID->
  "ed2d1821-a180-4525-a2b7-2e8d6e21ce83"],
 ". Hence any choice of the arbitrary function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "[", "u", "]"}], TraditionalForm]],ExpressionUUID->
  "60b1625b-5007-4ccd-b256-881f5b4888c5"],
 " gives rise to a vacuum solution. Such exact solutions are called linearly \
polarized plane gravitational waves."
}], "Text",ExpressionUUID->"811db424-4b36-4d1b-b833-6e64232c0a52"],

Cell["We carry out the coordinate transformation", "Text",ExpressionUUID->"39873a30-5152-456f-9fae-b5d9f4ee27d3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"U", " ", "=", " ", "u"}], ",", "     ", 
   RowBox[{"V", " ", "=", " ", 
    RowBox[{"v", " ", "+", " ", 
     RowBox[{
      SuperscriptBox["y", "2"], "f", " ", 
      RowBox[{"f", "'"}]}], " ", "+", " ", 
     RowBox[{
      SuperscriptBox["z", "2"], " ", "g", " ", 
      RowBox[{"g", "'"}]}]}]}], ",", "     ", 
   RowBox[{"Y", " ", "=", " ", 
    RowBox[{"f", " ", "y"}]}], ",", "     ", 
   RowBox[{"Z", " ", "=", " ", 
    RowBox[{"g", " ", 
     RowBox[{"z", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.519462076255621*^9},
 TextAlignment->Center,ExpressionUUID->"4d28f9d6-7444-46ae-8a4a-5fed42e2e0d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newCoSys", "=", 
   RowBox[{"{", 
    RowBox[{"u", ",", 
     RowBox[{"v", "+", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["y", "2"], "2"], " ", 
       RowBox[{"f", "[", "u", "]"}], " ", 
       RowBox[{
        RowBox[{"f", "'"}], "[", "u", "]"}]}], " ", "+", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["z", "2"], "2"], " ", 
       RowBox[{"g", "[", "u", "]"}], " ", 
       RowBox[{
        RowBox[{"g", "'"}], "[", "u", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"f", "[", "u", "]"}], "y"}], ",", 
     RowBox[{
      RowBox[{"g", "[", "u", "]"}], "z"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"ee70db68-23af-4765-8718-734e07e38884"],

