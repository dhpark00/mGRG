       SuperscriptBox["z", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"u", " ", 
          RowBox[{"\[Theta]", "[", "u", "]"}]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"\[Delta]", "[", "u", "]"}]}], "-", 
         RowBox[{"u", " ", 
          RowBox[{
           SuperscriptBox["diracDelta", "\[Prime]",
            MultilineFunction->None], "[", "u", "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["y", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"u", " ", 
          RowBox[{"\[Theta]", "[", "u", "]"}]}]}], ")"}], " ", 
       RowBox[{"(", 
