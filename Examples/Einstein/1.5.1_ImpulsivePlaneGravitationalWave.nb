Cell[TextData[{
 "The solution has delta functions in the curvature and hence it is non-flat \
only when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "4e936b71-e689-4357-935c-a09629ea46b3"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,ExpressionUUID->"69ccf184-fde5-4a89-b1fe-32f891ec61ae"],

Cell[TextData[{
 "In Brinkmann form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "U", ")"}], " ", "=", " ", 
    RowBox[{"\[Delta]", "(", "U", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4c0be0f6-5474-4927-9a8b-7f4d2d0e9474"],
 ". Therefore, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", " ", "\[NotEqual]", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"0d32e709-842a-4563-a17f-bff8f0700a21"],
 ", the line element reduces to the Minkowski space-time in double null \
coordinates. The hypersurface ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "d8224e28-fced-4a88-be19-35f5eb2cc3c3"],
 ", where the curvature is concentrated, separates two flat reions."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,ExpressionUUID->"ed53819f-6454-4455-9888-706428f13db2"],

Cell[CellGroupData[{

Cell[BoxData[
