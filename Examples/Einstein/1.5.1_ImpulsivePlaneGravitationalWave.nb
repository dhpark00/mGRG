Cell["The line element is transformed into the Brinkmann form", "Text",ExpressionUUID->"c2c8a433-153f-4183-b2c7-f1d1db2eec2e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"d", "\[InvisibleSpace]", 
    SuperscriptBox["s", "2"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"h", "(", "U", ")"}]}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["Z", "2"], " ", "-", " ", 
       SuperscriptBox["Y", "2"]}], ")"}], "d", "\[InvisibleSpace]", 
     SuperscriptBox["U", "2"]}], " ", "-", 
    RowBox[{
    "2", "d", "\[InvisibleSpace]", "U", " ", "d", "\[InvisibleSpace]", "V"}], 
    " ", "+", " ", 
    RowBox[{"d", "\[InvisibleSpace]", 
     SuperscriptBox["Y", "2"]}], " ", "+", " ", 
    RowBox[{"d", "\[InvisibleSpace]", 
     RowBox[{
      SuperscriptBox["Z", "2"], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.519462072152386*^9},
 TextAlignment->Center,ExpressionUUID->"7a76d30d-a3db-412d-9efd-f49df530c910"],

Cell[TextData[{
 "This shows the explicit dependence on the freely specifiable function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", "U", ")"}], TraditionalForm]],ExpressionUUID->
  "28223358-a9c6-4169-b2a4-3fce38bf8828"],
 "."
}], "Text",ExpressionUUID->"1cfc0cf5-c13d-419c-b8f3-ee78a00090b5"]
}, Closed]],

Cell[CellGroupData[{

Cell["Impulsive plane gravitational waves", "Subsubsection",ExpressionUUID->"86652165-1e08-4238-b3e1-b78743cfe436"],

Cell["We consider a line element in the Rosen form defined by", "Text",ExpressionUUID->"c74bf6d4-44d4-46f0-b6d3-c18d19b02779"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "(", "u", ")"}], " ", "=", " ", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"u", " ", 
      RowBox[{"\[Theta]", "(", "u", ")"}]}]}]}], ",", "     ", 
   RowBox[{
    RowBox[{"g", "(", "u", ")"}], " ", "=", " ", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"u", " ", 
      RowBox[{"\[Theta]", "(", "u", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"13e7f59b-7c9b-4c3b-bb73-90759895fbd9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "(", "u", ")"}], TraditionalForm]],ExpressionUUID->
  "94f791ea-e1bf-4cc9-b5d0-3a408be55b2a"],
 " is the Heaviside step function."
}], "Text",ExpressionUUID->"41124c2e-d7d3-4f6d-983f-04a20a576524"],

Cell["\<\
Use private definitions of heavisideStep and diracDelta for fast \
simplification in Mathematica Ver 4.\
\>", "Text",
 CellChangeTimes->{{3.6263375891212616`*^9, 
  3.626337591776636*^9}},ExpressionUUID->"8818c187-08cc-42f1-9902-\
e589ea008ae8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"heavisideStep", "[", "u_", "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Theta]", "[", "u", "]"}]}], ";", 
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"diracDelta", "[", "u_", "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Delta]", "[", "u", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.626337599653756*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"87041849-546b-4272-a8dc-d0a2bb7bd0fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Derivative", "[", "1", "]"}], "[", "heavisideStep", "]"}], "[", 
   "u_", "]"}], " ", ":=", " ", 
  RowBox[{"diracDelta", "[", "u", "]"}]}]], "Input",
 CellChangeTimes->{3.626337608509012*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"f67279c2-975a-4341-9386-14dd4c4f9a5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CsimplifyRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"u_", "^", "_."}], " ", 
       RowBox[{
        RowBox[{"diracDelta", "[", "u_", "]"}], "^", "_."}]}], " ", "\[RuleDelayed]",
       " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"u_", " ", 
       RowBox[{
        RowBox[{"diracDelta", "'"}], "[", "u_", "]"}]}], " ", "\[RuleDelayed]",
       " ", 
      RowBox[{"-", 
       RowBox[{"diracDelta", "[", "u", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"375324c9-3a8c-423b-b7e1-0011fd590c56"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"u", " ", 
     RowBox[{"heavisideStep", "[", "u", "]"}]}]}]}], ";", 
  RowBox[{
   RowBox[{"g", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"u", " ", 
     RowBox[{"heavisideStep", "[", "u", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.510124181015625*^9, 3.51012418446875*^9}, {
  3.6263376202856855`*^9, 3.62633762475032*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"3e015a3d-0dc7-4120-95c0-eea5162c0d85"],

