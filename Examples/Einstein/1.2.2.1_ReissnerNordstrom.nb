Cell[BoxData[
 RowBox[{
  RowBox[{"maxwellSolRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CurlyPhi]", "'"}], "[", "r", "]"}], " ", "\[Rule]", " ", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["Q", 
        SuperscriptBox["r", "2"]]}], 
      SqrtBox[
       RowBox[{
        RowBox[{"A", "[", "r", "]"}], " ", 
        RowBox[{"B", "[", "r", "]"}]}]]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"7df0067d-35f2-4bf6-82c8-7b2b3be47f41"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"a", "\[InvisibleSpace]", "b"}]], 
     SubscriptBox["T", 
      RowBox[{"a", "\[InvisibleSpace]", "b"}]]}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"9de32f48-2ad4-44f6-ba73-81c8cd40b0c4"],
 ", the Einstein equation becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", "\[InvisibleSpace]", "b"}]], " ", "=", " ", 
    RowBox[{"8", "\[Pi]", "  ", 
     SubscriptBox["T", 
      RowBox[{"a", "\[InvisibleSpace]", "b"}]]}]}], TraditionalForm]],
  ExpressionUUID->"09e5f71a-a7d2-44e2-bb4b-668f58a8e250"]
}], "Text",
 CellChangeTimes->{{3.51011888046875*^9, 
  3.51011888046875*^9}},ExpressionUUID->"323c6a14-b577-45fe-833d-\
c5e724094c5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"einsteinEq", "[", 
   RowBox[{"la_", ",", "lb_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"RicciCD", "[", 
    RowBox[{"la", ",", "lb"}], "]"}], " ", "-", " ", 
   RowBox[{"8", "\[Pi]", " ", 
    RowBox[{"energyMomentumT", "[", 
     RowBox[{"la", ",", "lb"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.519450933291958*^9, 3.519450933977998*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"182cceac-9ea3-4d59-b9eb-5a947bc97e20"],

