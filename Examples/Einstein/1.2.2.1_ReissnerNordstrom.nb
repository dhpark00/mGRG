            RowBox[{"4", " ", "\[Pi]", " ", 
              SuperscriptBox["Q", "2"]}], "-", 
            RowBox[{"2", " ", "M", " ", "r"}], "+", 
            SuperscriptBox["r", "2"]}], ")"}], " ", 
        TemplateBox[{"\"d\"", 
          
          TemplateBox[{"t", "\"2\""}, "Superscript", SyntaxForm -> 
           SuperscriptBox]}, "RowDefault"]}], 
      SuperscriptBox["r", "2"]], "+", 
     RowBox[{
       SuperscriptBox["r", "2"], " ", 
       RowBox[{"(", 
         RowBox[{
           TemplateBox[{"\"d\"", 
             
             TemplateBox[{"\[Theta]", "\"2\""}, "Superscript", SyntaxForm -> 
              SuperscriptBox]}, "RowDefault"], "+", 
