           SuperscriptBox["Q", "2"]}], ")"}]}]}]]}]}], ")"}]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"M", "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["M", "2"], "-", 
       RowBox[{"4", " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["P", "2"], "+", 
          SuperscriptBox["Q", "2"]}], ")"}]}]}]]}], ")"}], "6"]]], "Output",
 CellChangeTimes->{3.475661183716797*^9, 3.5101194629375*^9, 
  3.519451059105154*^9, 3.538999798676552*^9, 3.5857893270003495`*^9, 
  3.619597632907598*^9, 3.630901332905409*^9, 3.759823494091605*^9, 
  3.8274018146386266`*^9, 3.916191109172287*^9, 3.951262710705456*^9, 
  3.972905229613926*^9, 3.9809380125331287`*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"4de61e7e-b85c-4d28-8961-e27613f7f51c"]
}, Open  ]],

Cell[TextData[{
 "That is, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", "=", " ", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["M", "2"], " ", "-", " ", 
       RowBox[{"4", 
        RowBox[{"\[Pi]", "(", 
         RowBox[{
          SuperscriptBox["Q", "2"], "+", 
          SuperscriptBox["P", "2"]}], ")"}]}]}]], "/", " ", 
     SubsuperscriptBox["r", "h", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "55bf39b2-cc2c-4f9b-9ee1-97f6d5ed82df"],
 ". On the other hand, the area ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "0df37685-8bf4-4d44-84d7-d20bc7bd7d00"],
 " of the horizon is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"4", "\[Pi]", " ", 
     SubsuperscriptBox["r", "h", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "c8de4592-e33a-49df-a88a-29e27cde7512"],
 ". Notice that the electric and magnetic potentials on the horizon are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyPhi]", "h"], " ", "=", " ", 
    RowBox[{"Q", "/", 
     SubscriptBox["r", "h"]}]}], TraditionalForm]],ExpressionUUID->
  "c15cfaf1-f940-49be-b62a-1aa97e8199ef"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "h"], " ", "=", " ", 
    RowBox[{"P", "/", 
     SubscriptBox["r", "h"]}]}], TraditionalForm]],ExpressionUUID->
  "c9d0fc6a-6b44-4939-89b6-e5120c97894d"],
 ". These give the Smarr formula"
}], "Text",ExpressionUUID->"e13e6407-e58a-4b62-8e5e-e8e027bfe026"],

Cell[BoxData[
 FormBox[
  RowBox[{"M", " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", "\[Pi]"}]], "\[Kappa]", " ", "A"}], " ", "+", " ", 
    RowBox[{"4", 
     RowBox[{
      RowBox[{"\[Pi]", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CurlyPhi]", "h"], "Q"}], " ", "+", " ", 
        RowBox[{
         SubscriptBox["v", "h"], "P"}]}], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{3.519451076645158*^9},
 TextAlignment->Center,ExpressionUUID->"578ca4a8-ef95-46ff-997c-70d421c21056"]
}, Closed]]
}, Open  ]]
},
