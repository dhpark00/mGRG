##### To build in Ubuntu it needs to install 'libuuid':
##### > sudo apt-get install uuid-dev

# my personal dir of Wolfram Engine
MY_MMA_DIR = /home/dhpark/WolframEngine

MLINKDIR = ${MY_MMA_DIR}/SystemFiles/Links/MathLink/DeveloperKit
SYS = Linux-x86-64
CADDSDIR = ${MLINKDIR}/${SYS}/CompilerAdditions

MLLIBS = -L${CADDSDIR} -lML64i4  -lm -lpthread -lrt -lstdc++ -ldl -luuid
MPREP = ${CADDSDIR}/mprep
MCC = ${CADDSDIR}/mcc

INCLUDES = -I${CADDSDIR}

all: xPermCPP64.linux

xPermCPP64.linux: xPermCPP64tm.o
	g++ -O2 -m64 xPermCPP64tm.o ${INCLUDES} ${MLLIBS} -o xPermCPP64.linux

xPermCPP64tm.o: xPermCPP.tm
	${MPREP} xPermCPP.tm -o xPermCPP64tm.cpp
	g++ -m64 ${INCLUDES} -std=c++17 -c xPermCPP64tm.cpp

clean :
	rm -f xPermCPP64tm.*
