# MacOSX-M4 #

# my environment of g++
GXX = /opt/homebrew/bin/g++-15

# my personal dir of Wolfram Engine
MY_MMA_DIR = /Users/dhpark/Dropbox/mma

# Set the paths according to your MathLink Developer Kit location.
MLINKDIR = /Applications/Mathematica.app/Contents/SystemFiles/Links/MathLink/DeveloperKit
SYS = MacOSX-ARM64
CADDSDIR = ${MLINKDIR}/${SYS}/CompilerAdditions

MLLIBS = -L${CADDSDIR} -lMLi4 -lc++ -framework Foundation
MPREP = ${CADDSDIR}/mprep
MCC = ${CADDSDIR}/mcc

INCLUDES = -I${CADDSDIR}

all: xPermCPP64.mac

xPermCPP64.mac: xPermCPP64tm.o
	${GXX} -O2 ${INCLUDES} ${MLLIBS} xPermCPP64tm.o -o xPermCPP64.mac

xPermCPP64tm.o: xPermCPP.tm
	${MPREP} xPermCPP.tm -o xPermCPP64tm.cpp
	${GXX} ${INCLUDES} -std=c++17 -c xPermCPP64tm.cpp

clean :
	rm -f xPermCPP64tm.*
